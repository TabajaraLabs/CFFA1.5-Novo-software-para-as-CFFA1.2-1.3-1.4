000000r 1               ; idetest_v2.s - teste da CFFA v1.2 na RAM (Apple IIe Enhanced, 65C02), placa no slot 6
000000r 1               ; v2: CFFA no slot 6 (BOOTI fica no slot 5). v1 era para o slot 7.
000000r 1               ; 1) IDENTIFY do cartao: modelo, serial, firmware, capacidade
000000r 1               ; 2) mede o laco de leitura original (status a cada word) x laco rapido (status 1x por setor)
000000r 1               ;    lendo 256 setores a partir do LBA 0 (somente leitura). As linhas ">INICIO"/">FIM" recebem
000000r 1               ;    a hora do PC na ponte (ms) -> tempo de cada laco.
000000r 1               ; Montar: ca65 --cpu 65C02 idetest_v2.s && ld65 -t none -S $6000 idetest_v2.o -o idetest_v2.bin
000000r 1                       .setcpu "65C02"
