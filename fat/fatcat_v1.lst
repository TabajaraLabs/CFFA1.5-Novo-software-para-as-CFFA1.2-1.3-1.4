000000r 1               ; fatcat_v1.s - prototipo na RAM: le cartao FAT16/FAT32 pela CFFA (slot 7) e lista imagens ProDOS
000000r 1               ; Apple IIe Enhanced (65C02). Somente leitura. Carregar em $6000 e rodar com 6000G.
000000r 1               ; - aceita cartao com MBR (particao 1 tipo 04/06/0E = FAT16, 0B/0C = FAT32) ou "superfloppy" (VBR no setor 0)
000000r 1               ; - lista arquivos .PO .HDV .IMG da raiz: tamanho em blocos, cluster inicial, LBA inicial,
000000r 1               ;   e confere se os clusters sao contiguos (condicao para montar como volume ProDOS)
000000r 1               ; Montar: ca65 --cpu 65C02 fatcat_v1.s && ld65 -t none -S $6000 fatcat_v1.o -o fatcat_v1.bin
000000r 1                       .setcpu "65C02"
000000r 1                       .org $6000
006000  1               
006000  1               SLOT    = 7
006000  1               IOB     = $C080 + SLOT*16
006000  1               DATAH   = IOB+0
006000  1               DATAL   = IOB+8
006000  1               ERRREG  = IOB+9
006000  1               SECCNT  = IOB+10
006000  1               SECT    = IOB+11
