006000  1               
006000  1               SBUF     = $6800         ; buffer de setor (MBR, VBR, diretorio) 512 bytes
006000  1               FATB    = $6A00         ; buffer do setor de FAT (cache) 512 bytes
006000  1               V       = $6C00         ; variaveis de 32 bits (indice X/Y = deslocamento)
006000  1               
006000  1               ; variaveis de 4 bytes (little endian), deslocamento dentro de V
006000  1               vLBA    = 0             ; setor a ler
006000  1               vPST    = 4             ; inicio da particao
006000  1               vFATST  = 8             ; inicio da FAT 1
006000  1               vROOTST = 12            ; inicio do diretorio raiz (FAT16)
006000  1               vDATAST = 16            ; inicio da area de dados (cluster 2)
006000  1               vROOTCL = 20            ; cluster do diretorio raiz (FAT32)
006000  1               vFATSZ  = 24            ; setores por FAT
006000  1               vT1     = 28            ; temporario
006000  1               vCLUS   = 32            ; cluster atual (entrada de fatnext)
006000  1               vFCACHE = 36            ; LBA do setor de FAT no buffer FATB
006000  1               vDIRL   = 40            ; setor atual do diretorio
006000  1               vFCL    = 44            ; cluster inicial do arquivo
006000  1               vFSZ    = 48            ; tamanho do arquivo (bytes)
006000  1               vNCL    = 52            ; clusters contados no arquivo
006000  1               vT2     = 56            ; temporario
006000  1               vNXT    = 60            ; saida de fatnext
006000  1               vDCL    = 64            ; cluster atual do diretorio (FAT32)
006000  1               SPCV    = V+68          ; setores por cluster
006000  1               SPSH    = V+69          ; log2(setores por cluster)
006000  1               NFAT    = V+70          ; numero de FATs
006000  1               FTYP    = V+71          ; 0 = FAT16, 1 = FAT32
006000  1               RSECS   = V+72          ; setores restantes do diretorio raiz (FAT16), 2 bytes
006000  1               SLEFT   = V+74          ; setores restantes no cluster do diretorio (FAT32)
006000  1               CVAL    = V+75          ; cache de FAT valido?
006000  1               NFILE   = V+76          ; imagens encontradas
006000  1               FRAG    = V+77          ; arquivo fragmentado?
006000  1               FOFS    = V+78          ; deslocamento da entrada no setor de FAT (2 bytes)
006000  1               SAVSP   = V+80
006000  1               ESZ     = V+81          ; bytes por entrada de FAT (2 ou 4)          ; pilha no inicio (para sair em erro)
