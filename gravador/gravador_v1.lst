0060C8  1  20 6D 61     @vok:   jsr avanca
0060CB  1  D0 ED                bne @v
0060CD  1  AD F4 C0             lda EE_BANK0            ; volta ao banco 0 (tambem trava)
0060D0  1  AD FF CF             lda $CFFF
0060D3  1               ; ---------- resumo ----------
0060D3  1  20 B7 61             jsr msg
