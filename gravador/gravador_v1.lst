00605D  1  D0 DB                bne @blk
00605F  1               ; ---------- escolhe o banco e liga a ROM da placa ----------
00605F  1  AD FF CF             lda $CFFF               ; solta o $C800 de todas as placas
006062  1  AD 03 60             lda BANCO
006065  1  F0 05                beq @b0
006067  1  AD F5 C0             lda EE_BANK1
00606A  1  80 03                bra @b1
