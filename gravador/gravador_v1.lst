006093  1  EE 08 60             inc NERRO               ; nao confirmou em ~1 s
006096  1  D0 17                bne @prox
006098  1  EE 09 60             inc NERRO+1
00609B  1  80 12                bra @prox
00609D  1  EE 04 60     @ok:    inc NGRAV
0060A0  1  D0 0D                bne @prox
0060A2  1  EE 05 60             inc NGRAV+1
0060A5  1  80 08                bra @prox
0060A7  1  EE 06 60     @igual: inc NIGUAL
0060AA  1  D0 03                bne @prox
0060AC  1  EE 07 60             inc NIGUAL+1
0060AF  1  20 6D 61     @prox:  jsr avanca
0060B2  1  D0 C7                bne @g
0060B4  1  AD F3 C0             lda EE_WEON             ; leitura = trava
0060B7  1               ; ---------- conferencia ----------
0060B7  1  20 5C 61             jsr inicio_ptr
0060BA  1  B2 06        @v:     lda (PTR)
0060BC  1  D2 08                cmp (SRC)
0060BE  1  F0 08                beq @vok
0060C0  1  EE 0A 60             inc NDIF
0060C3  1  D0 03                bne @vok
