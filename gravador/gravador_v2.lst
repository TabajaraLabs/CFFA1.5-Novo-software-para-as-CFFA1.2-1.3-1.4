ca65 V2.18 - Ubuntu 2.19-1
Main file   : gravador_v2.s
Current file: gravador_v2.s

000000r 1               ; gravador_v2.s - grava um banco da EEPROM X28C256 da CFFA (slot 7) recebendo os dados pela serial
000000r 1               ; Apple IIe Enhanced (65C02), Super Serial no slot 1 (19200 8N1 pelas chaves), CPLD v1.6.1.
000000r 1               ; 2026-11-20
000000r 1               ;
000000r 1               ; Uso (pela ponte, modo #raw):  6000G  e depois  #sendbin rom\ARQUIVO.bin 256
000000r 1               ;   ARQUIVO.bin = 2048 bytes = conteudo de $C700-$CEFF do banco (offsets $700-$EFF da imagem de 4 KB).
000000r 1               ;   $6003 = banco: 0 -> banco do A14=0 (acesso a $C0F4) ; 1 -> banco do A14=1 (acesso a $C0F5)
000000r 1               ;   v2: normalmente nao grava nem confere $CE80-$CEFF (preserva a montagem); $80/$81 = gravar tudo
000000r 1               ; Protocolo: manda ACK ($06), recebe 256 bytes, repete 8 vezes. ESC no teclado do Apple cancela.
000000r 1               ; Depois: grava byte a byte so o que for diferente (escrita simples + espera pelo "data polling"),
000000r 1               ; trava a gravacao, confere os 2048 bytes, volta ao banco 0 e imprime o resumo.
000000r 1               ; Nada e escrito fora de $C700-$CEFF.
000000r 1                       .setcpu "65C02"
000000r 1                       .org $6000
006000  1               
006000  1               SSCDAT  = $C098         ; 6551 da Super Serial no slot 1
006000  1               SSCST   = $C099
006000  1               KBD     = $C000
006000  1               KBDSTRB = $C010
006000  1               COUT    = $FDED
006000  1               CROUT   = $FD8E
006000  1               PRBYTE  = $FDDA
006000  1               
006000  1               EE_WEON  = $C0F3        ; escrita = destrava ; leitura = trava (CFFA slot 7)
006000  1               EE_BANK0 = $C0F4        ; A14 = 0
006000  1               EE_BANK1 = $C0F5        ; A14 = 1
006000  1               
006000  1               PTR     = $06           ; endereco na ROM da placa ($C700..$CEFF)
006000  1               SRC     = $08           ; endereco no buffer
006000  1               BUF     = $7000         ; 2048 bytes
006000  1               
006000  1  4C 0E 60             jmp inicio
006003  1  01           BANCO:  .byte 1         ; $6003
006004  1  00 00        NGRAV:  .word 0         ; bytes gravados
006006  1  00 00        NIGUAL: .word 0         ; bytes que ja estavam certos
006008  1  00 00        NERRO:  .word 0         ; bytes que nao confirmaram a gravacao
00600A  1  00 00        NDIF:   .word 0         ; diferencas na conferencia final
00600C  1  00 00        SOMA:   .word 0         ; soma dos 2048 bytes recebidos
00600E  1               
00600E  1  78           inicio: sei
00600F  1  AD 98 C0             lda SSCDAT              ; descarta lixo na recepcao
006012  1  9C 04 60             stz NGRAV
006015  1  9C 05 60             stz NGRAV+1
006018  1  9C 06 60             stz NIGUAL
00601B  1  9C 07 60             stz NIGUAL+1
00601E  1  9C 08 60             stz NERRO
006021  1  9C 09 60             stz NERRO+1
006024  1  9C 0A 60             stz NDIF
006027  1  9C 0B 60             stz NDIF+1
00602A  1  9C 0C 60             stz SOMA
00602D  1  9C 0D 60             stz SOMA+1
006030  1               ; ---------- recepcao: 8 blocos de 256 ----------
006030  1  A9 00                lda #<BUF
006032  1  85 08                sta SRC
006034  1  A9 70                lda #>BUF
006036  1  85 09                sta SRC+1
006038  1  A2 08                ldx #8
00603A  1  A9 06        @blk:   lda #$06
00603C  1  20 90 61             jsr envia
00603F  1  A0 00                ldy #0
006041  1  20 9D 61     @byte:  jsr recebe
