006046  1  4C 46 61             jmp cancela
006049  1  91 08        @rx:    sta (SRC),y
00604B  1  18                   clc
00604C  1  6D 0C 60             adc SOMA
00604F  1  8D 0C 60             sta SOMA
006052  1  90 03                bcc @s1
006054  1  EE 0D 60             inc SOMA+1
006057  1  C8           @s1:    iny
006058  1  D0 E7                bne @byte
00605A  1  E6 09                inc SRC+1
00605C  1  CA                   dex
00605D  1  D0 DB                bne @blk
00605F  1               ; ---------- escolhe o banco e liga a ROM da placa ----------
00605F  1  AD FF CF             lda $CFFF               ; solta o $C800 de todas as placas
006062  1  AD 03 60             lda BANCO
006065  1  29 7F                and #$7F
006067  1  F0 05                beq @b0
006069  1  AD F5 C0             lda EE_BANK1
00606C  1  80 03                bra @b1
00606E  1  AD F4 C0     @b0:    lda EE_BANK0
006071  1  20 B7 61     @b1:    jsr espera              ; ~2 ms para o A14 assentar
006074  1  AD 00 C7             lda $C700               ; liga o $C800 da CFFA
006077  1  8D F3 C0             sta EE_WEON             ; destrava a gravacao
00607A  1               ; ---------- gravacao byte a byte ----------
00607A  1  20 5E 61             jsr inicio_ptr
00607D  1  B2 08        @g:     lda (SRC)
00607F  1  D2 06                cmp (PTR)
006081  1  F0 26                beq @igual
006083  1  92 06                sta (PTR)               ; grava (65C02: sem leitura falsa)
006085  1  A2 00                ldx #0
006087  1  A0 00                ldy #0
006089  1  B2 06        @poll:  lda (PTR)
00608B  1  D2 08                cmp (SRC)
00608D  1  F0 10                beq @ok
00608F  1  CA                   dex
006090  1  D0 F7                bne @poll
006092  1  88                   dey
006093  1  D0 F4                bne @poll
006095  1  EE 08 60             inc NERRO               ; nao confirmou em ~1 s
006098  1  D0 17                bne @prox
00609A  1  EE 09 60             inc NERRO+1
00609D  1  80 12                bra @prox
00609F  1  EE 04 60     @ok:    inc NGRAV
0060A2  1  D0 0D                bne @prox
0060A4  1  EE 05 60             inc NGRAV+1
0060A7  1  80 08                bra @prox
0060A9  1  EE 06 60     @igual: inc NIGUAL
0060AC  1  D0 03                bne @prox
0060AE  1  EE 07 60             inc NIGUAL+1
0060B1  1  20 6F 61     @prox:  jsr avanca
0060B4  1  D0 C7                bne @g
0060B6  1  AD F3 C0             lda EE_WEON             ; leitura = trava
0060B9  1               ; ---------- conferencia ----------
0060B9  1  20 5E 61             jsr inicio_ptr
0060BC  1  B2 06        @v:     lda (PTR)
0060BE  1  D2 08                cmp (SRC)
0060C0  1  F0 08                beq @vok
0060C2  1  EE 0A 60             inc NDIF
0060C5  1  D0 03                bne @vok
0060C7  1  EE 0B 60             inc NDIF+1
0060CA  1  20 6F 61     @vok:   jsr avanca
0060CD  1  D0 ED                bne @v
0060CF  1  AD F4 C0             lda EE_BANK0            ; volta ao banco 0 (tambem trava)
0060D2  1  AD FF CF             lda $CFFF
0060D5  1               ; ---------- resumo ----------
0060D5  1  20 C9 61             jsr msg
0060D8  1  47 52 41 56          .byte "GRAVADOS ",0
0060DC  1  41 44 4F 53  
