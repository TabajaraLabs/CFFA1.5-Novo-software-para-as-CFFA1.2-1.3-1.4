004000  1               FULL    = V+109                 ; 1 = redesenhar a tela toda
004000  1               OCUR    = V+110
004000  1               OTOP    = V+111
004000  1               DEVB    = V+112                 ; $00 = mestre, $10 = escravo (bit 4 do byte 3 do LBA)
004000  1               HASSL   = V+113                 ; 1 = escravo presente
004000  1               VSER    = V+114                 ; numero de serie do volume FAT lido por ultimo (4 bytes)
004000  1               MSER    = V+118                 ; numero de serie do volume do mestre
004000  1               vSTCL   = 122                   ; cluster inicial da pasta a listar (4 bytes, deslocamento em V)
004000  1               INSUB   = V+126                 ; 1 = listando uma subpasta
004000  1               USESTCL = V+127                 ; 1 = scan2 comeca em vSTCL
004000  1               ISFOLD  = V+128                 ; $80 = a entrada sendo guardada e uma pasta
004000  1               OCURV   = V+129                 ; CUR para o qual VOLMSG foi calculado
004000  1               KEYI    = V+130
