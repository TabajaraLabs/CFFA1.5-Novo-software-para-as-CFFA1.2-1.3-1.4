004000  1               BK0     = IOB+4                 ; qualquer acesso: banco 0
004000  1               BK4     = IOB+5                 ; qualquer acesso: banco 4
004000  1               DRVRST  = $0478 + SLOT          ; DriveResetDone do driver (zerar = refazer FatInit)
