004000  1               WAIT    = $FCA8
004000  1               KBD     = $C000
004000  1               KBDSTRB = $C010
004000  1               
004000  1               ROMCFG  = $CE80                 ; tabela do driver no banco 4 ($CE80-$CEE0, $CEE0 = 'C')
004000  1               CFGLEN  = $61
004000  1               ROMNAM  = $CEC0                 ; nomes no banco 0 ($CEC0-$CEEC, $CEEC = 'N')
004000  1               NAMLEN  = 45
004000  1               
004000  1               PTR     = $06
004000  1               ENT     = $08
004000  1               CP      = $EB                   ; ponteiro de trabalho (tabela nova)
004000  1               MP      = $FA
004000  1               TMP     = $FC
004000  1               CNT     = $FD
004000  1               LP      = $FE                   ; ponteiro para a entrada da lista de imagens
004000  1               
004000  1               SBUF    = $8800                 ; (o carregador do banco 0 fica em $2000-$2FFF: nao mexer)
004000  1               FATB    = $8A00
004000  1               V       = $8C00
004000  1               LST     = $8D00                 ; 16 imagens x 24 bytes: nome 11, bytes 20-21 e 26-31 da entrada (8), LBA do dir (4), indice (1)
004000  1               NEWCFG  = $8E80                 ; tabela nova (97 bytes)
004000  1               NEWNAM  = $8F00                 ; nomes novos (45 bytes)
004000  1               OLD     = $8F40                 ; copia de uma entrada da tabela (24 bytes)
