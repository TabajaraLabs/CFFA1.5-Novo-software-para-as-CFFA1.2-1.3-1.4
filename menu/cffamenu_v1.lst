004000  1               CYLH    = IOB+13
004000  1               HEAD    = IOB+14
004000  1               CMD     = IOB+15
004000  1               STATUS  = IOB+15
004000  1               WUNL    = IOB+3                 ; CPLD v1.6: escrever = destrava gravacao; ler = trava
004000  1               BK0     = IOB+4                 ; qualquer acesso: banco 0
004000  1               BK4     = IOB+5                 ; qualquer acesso: banco 4
004000  1               DRVRST  = $0478 + SLOT          ; DriveResetDone do driver (zerar = refazer FatInit)
004000  1               
004000  1               COUT    = $FDED
