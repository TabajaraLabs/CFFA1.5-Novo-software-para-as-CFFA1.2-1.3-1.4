000000r 1               ; carga_menu_v1.s - estagio 1 do banco 0 da CFFA v1.2 (firmware 1.4): carrega CFFAMENU.BIN do cartao FAT
000000r 1               ; Tabajara Labs, 2026-11-20. O trampolim do 1.4 copia o banco 0 ($C800-$CEFF) para $2000-$26FF e chama $2003.
000000r 1               ; Procura CFFAMENU.BIN na raiz (FAT16/FAT32), carrega em $4000 (ate 16 KB) seguindo a cadeia de clusters,
000000r 1               ; confere "CFM1" em $4000 e chama $4004 (X = $70). Sem o arquivo, mostra um aviso e segue o boot.
000000r 1               ; O fim do banco ($CEC0-$CEEC) guarda os nomes das imagens montadas (gravados pelo CFFAMENU).
000000r 1               ; Montar: ca65 --cpu 65C02 carga_menu_v1.s && ld65 -t none -S $2000 carga_menu_v1.o -o carga_menu_v1.bin (1792 bytes)
000000r 1                       .setcpu "65C02"
000000r 1                       .org $2000
