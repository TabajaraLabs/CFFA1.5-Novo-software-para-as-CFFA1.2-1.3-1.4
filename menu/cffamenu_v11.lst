004000  1               VOLMSG  = $7140                 ; "VOLUME /NOME" da imagem marcada
004000  1               LA      = $E3                   ; ponteiro auxiliar (nome A na comparacao)
004000  1               MT      = V+135                 ; v7: 1 = MouseText disponivel (conjunto alternativo ligado)
004000  1               BROW    = V+136                 ; v7: linha da moldura sendo desenhada
004000  1               CDN     = V+137                 ; v8: segundos que faltam na contagem do boot
004000  1               MI      = V+138                 ; v8: indice de escrita em MSG
004000  1               JV      = V+139                 ; v8: endereco do driver (2 bytes)
