004000  1               LP      = $FE                   ; ponteiro para a entrada da lista de imagens
004000  1               
004000  1               SBUF    = $8800                 ; (o carregador do banco 0 fica em $2000-$2FFF: nao mexer)
004000  1               FATB    = $8A00
004000  1               V       = $8C00
004000  1               LFNT    = $6000                 ; nomes longos: 64 x 32 bytes (ate 31 caracteres + 0)
004000  1               LST     = $6800                 ; 64 imagens x 24 bytes: nome 11, bytes 20-21 e 26-31 da entrada (8), LBA do dir (4), indice (1)
004000  1               NEWCFG  = $6E00                 ; tabela nova (97 bytes)
004000  1               NEWNAM  = $6E80                 ; nomes novos (45 bytes)
004000  1               OLD     = $6EC0                 ; copia de uma entrada da tabela (24 bytes)
004000  1               LBUF    = $6F00                 ; nome longo em montagem (64 bytes)
004000  1               MSG     = $6F40                 ; mensagem da linha 23 (64 bytes)
004000  1               NIMAX   = 64
004000  1               LN      = $EE                   ; ponteiro para o nome longo
