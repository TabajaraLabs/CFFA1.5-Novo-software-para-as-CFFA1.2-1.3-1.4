00CBFF  1  20 78 CC        jsr  IDEWaitReady
00CC02  1  20 4D CC        jsr  Block2LBA               ;program IDE task file
00CC05  1               
00CC05  1               ; Write sector from RAM
00CC05  1  A9 30           lda  #ATACWrite
00CC07  1  9D 8F C0        sta  ATACommand,x
