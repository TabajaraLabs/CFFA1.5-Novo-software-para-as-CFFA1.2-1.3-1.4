00CC4D  1               ;------------------------------------------------------------------------------
00CC4D  1               ; Block2LBA - Translates ProDOS block# into LBA and programs devices' task file
00CC4D  1               ;             registers.
00CC4D  1               ;
00CC4D  1               ; Input:
00CC4D  1               ;       pd Command Block Data $42 - $47
00CC4D  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CC4D  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CC4D  1               ;
00CC4D  1               ; Ouput:
00CC4D  1               ;       None
00CC4D  1               ;
00CC4D  1               ; ZeroPage Usage:
00CC4D  1               ;       None
00CC4D  1               ;
00CC4D  1               ; CPU Registers changed:  A, P
00CC4D  1               ;
00CC4D  1               ; This function translates the block number sent in the PRODOS request
00CC4D  1               ; packet, into an ATA Logical Block Address (LBA).
00CC4D  1               ; The least significant 16 bits becomes the ProDOS block#.
00CC4D  1               ; The most significant 16 becomes the ProDOS Drive #
00CC4D  1               ;
00CC4D  1               ; A ProDOS block and a ATA sector are both 512 bytes.
00CC4D  1               ;
00CC4D  1               ; Logical Block Mode, the Logical Block Address is interpreted as follows:
00CC4D  1               ; LBA07-LBA00: Sector Number Register D7-D0.
00CC4D  1               ; LBA15-LBA08: Cylinder Low Register D7-D0.
00CC4D  1               ; LBA23-LBA16: Cylinder High Register D7-D0.
00CC4D  1               ; LBA27-LBA24: Drive/Head Register bits HS3-HS0.
00CC4D  1               
00CC4D  1               
00CC4D  1               Block2LBA:
00CC4D  1               
00CC4D  1  A9 E0           lda  #$E0                    ;1, (LBA), 1, (Drive), LBA 27-24, where LBA=1,
00CC4F  1                                               ; Drive=0
00CC4F  1  9D 8E C0        sta  ATAHead,x               ;Talk to the Master device and use LBA mode.
00CC52  1                                               ; Remember that this write will seen by both
00CC52  1                                               ; the master and slave devices.
00CC52  1               ;
00CC52  1               ; Add BLOCKOFFSET to the ProDOS block number to offset the first drive block we
00CC52  1               ; use. This keeps the device's first BLOCKOFFSET blocks free, which usually
00CC52  1               ; includes a MBR at block 0.
00CC52  1               ;
00CC52  1  B9 78 07        lda  DrvMiscFlags,y           ; bit 7 = raw block access
00CC55  1  29 80           and  #$80
00CC57  1  49 80           eor  #$80
00CC59  1  F0 02           beq  rawBlocks
00CC5B  1  A9 00           lda  #BLOCKOFFSET
00CC5D  1               rawBlocks:                      ; A = $00 or BLOCKOFFSET
00CC5D  1  18              clc
00CC5E  1  65 46           adc  pdBlockNumber
00CC60  1  9D 8B C0        sta  ATASector,x             ;store ProDOS Low block # into LBA 0-7
00CC63  1               
00CC63  1  A5 47           lda  pdBlockNumberH
00CC65  1  69 00           adc  #0                      ;account for any overflow in LBA 0-7
00CC67  1  9D 8C C0        sta  ATACylinder,x           ;store ProDOS High block # into LBA 15-8
00CC6A  1               
00CC6A  1  B9 F8 04        lda DriveNumber,y
00CC6D  1  69 00           adc #0                        ;account for overflow from LBA 8-15
00CC6F  1  9D 8D C0        sta ATACylinderH,x            ;store LBA bits 23-16
00CC72  1               
00CC72  1  A9 01           lda #1
00CC74  1  9D 8A C0        sta ATASectorCnt,x
00CC77  1  60              rts
00CC78  1               
00CC78  1               ;------------------------------------------------------------------------------
00CC78  1               ; IDEWaitReady - Waits for BUSY flag to clear, and returns DRQ bit status
00CC78  1               ;
00CC78  1               ; Input:
00CC78  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CC78  1               ; Ouput:
00CC78  1               ;       Carry flag = DRQ status bit
00CC78  1               ;
00CC78  1               ; ZeroPage Usage:
00CC78  1               ;       None
00CC78  1               ;
00CC78  1               ; CPU Registers changed:  A, P
00CC78  1               ;
00CC78  1               IDEWaitReady:
00CC78  1  BD 8F C0        lda  ATAStatus,x
00CC7B  1  30 FB           bmi  IDEWaitReady            ;Wait for BUSY (bit 7) to be zero
00CC7D  1  6A              ror                          ;shift DRQ status bit into the Carry bit
00CC7E  1  6A              ror
00CC7F  1  6A              ror
00CC80  1  6A              ror
00CC81  1  60              rts
00CC82  1               
00CC82  1               ;------------------------------------------------------------------------------
00CC82  1               ; CheckDevice - Check to see if a device is attached to the interface.
00CC82  1               ; Input:
00CC82  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CC82  1               ; Output:
00CC82  1               ;       Carry flag: 0 = Device Present, 1 = Device Missing
00CC82  1               ;
00CC82  1               ; CPU Registers changed:  A, P
00CC82  1               ;
00CC82  1               ;  Checks to see if the drive status register is readable and equal to $50
00CC82  1               ;  If so, return with the Carry clear, otherwise return with the carry set.
00CC82  1               ;  Waits up to 10sec on a standard 1Mhz Apple II for drive to become ready
00CC82  1               ;
00CC82  1               CheckDevice:
00CC82  1  5A              phy
00CC83  1  3C 82 C0        bit  ClearCSMask,x           ;reset MASK bit in PLD for normal CS0 signaling
00CC86  1  A9 E0           lda  #$E0                    ;$E0 = [1, LBA, 1, Drive, LBA 27-24]  where
00CC88  1                                               ; LBA=1, Drive=0
00CC88  1  9D 8E C0        sta  ATAHead,x               ;Make sure ATA master drive is accessed
00CC8B  1               
00CC8B  1  A0 00           ldy  #0
00CC8D  1               chkLoop:
00CC8D  1  BD 8F C0        lda  ATAStatus,x
00CC90  1  29 D0           and  #%11010000
00CC92  1  C9 50           cmp  #$50                    ;if BUSY= 0 and RDY=1 and DSC=1
00CC94  1  F0 0D           beq  DeviceFound
00CC96  1  A9 C5           lda  #WAIT_100ms
00CC98  1  20 A6 CC        jsr  Wait                    ;Wait 100ms for device to be ready
00CC9B  1  C8              iny
00CC9C  1  C0 64           cpy  #100                    ;Wait up to 10 seconds for drive to be ready
00CC9E  1                                               ; This time may turn out to be much shorter on
00CC9E  1                                               ; accelerated Apple IIs
00CC9E  1  D0 ED           bne chkLoop
00CCA0  1               
00CCA0  1  38              sec                          ;set c = 1 if drive is not attached
00CCA1  1  7A              ply
00CCA2  1  60              rts
00CCA3  1               
00CCA3  1               DeviceFound:
00CCA3  1  18              clc                          ;set c = 0 if drive is attached
00CCA4  1  7A              ply
00CCA5  1  60              rts
00CCA6  1               
00CCA6  1               ;------------------------------------------------------------------------------
00CCA6  1               ;  Wait - Copy of Apple's wait routine. Can't use ROM based routine in case
00CCA6  1               ;         ROM is not active when we need it.
00CCA6  1               ;
00CCA6  1               ; Input:
00CCA6  1               ;       A = desired delay time, where Delay(us) = .5(5A^2 + 27A + 26)
00CCA6  1               ;       or more usefully: A = (Delay[in uS]/2.5 + 2.09)^.5 - 2.7
00CCA6  1               ;
00CCA6  1               ; CPU Registers changed:  A, P
00CCA6  1               ;
00CCA6  1               Wait:
00CCA6  1  38              sec
00CCA7  1               
00CCA7  1               Wait2:
00CCA7  1  48              pha
00CCA8  1               
00CCA8  1               Wait3:
00CCA8  1  E9 01           sbc  #1
00CCAA  1  D0 FC           bne  Wait3
00CCAC  1  68              pla
00CCAD  1  E9 01           sbc  #1
00CCAF  1  D0 F6           bne  Wait2
00CCB1  1  60              rts
00CCB2  1               
00CCB2  1               
00CCB2  1               
00CCB2  1               
00CCB2  1               .IF DEBUG
00CCB2  1               
00CCB2  1               ;------------------------------------------------------------------------------
00CCB2  1               ; DisplayParms - Display the parameters of the ProDOS request
00CCB2  1               ; Input:
00CCB2  1               ;       None
00CCB2  1               ; Ouput:
00CCB2  1               ;       None
00CCB2  1               ;
00CCB2  1               ; ZeroPage Usage:
00CCB2  1               ;       None
00CCB2  1               ;
00CCB2  1               ; CPU Registers changed:  A, P
00CCB2  1               ;
00CCB2  1               DisplayParms:
00CCB2  1                  jsr  DSString
00CCB2  1                  .byte " B:",0
00CCB2  1               
00CCB2  1                  lda  pdBlockNumberH
00CCB2  1                  jsr  DSByte
00CCB2  1                  lda  pdBlockNumber
00CCB2  1                  jsr  DSByte
00CCB2  1               
00CCB2  1                  jsr  DSString
00CCB2  1                  .byte " U:",0
00CCB2  1                  lda  pdUnitNumber
00CCB2  1                  jsr  DSByte
00CCB2  1               
00CCB2  1                  jsr  DSString
00CCB2  1                  .byte " A$",0
00CCB2  1               
00CCB2  1                  lda  pdIOBufferH
00CCB2  1                  jsr  DSByte
00CCB2  1               
00CCB2  1                  lda  pdIOBuffer
00CCB2  1                  bra  DSByte
00CCB2  1               
00CCB2  1               
00CCB2  1               ;------------------------------------------------------------------------------
00CCB2  1               ; DSString - Sends a String to the Super Serial Card in Slot 2
00CCB2  1               ; Input:
00CCB2  1               ;       string must immediately follow the JSR to this function
00CCB2  1               ;       and be terminated with zero byte.
00CCB2  1               ; Ouput:
00CCB2  1               ;       None
00CCB2  1               ;
00CCB2  1               ; ZeroPage Usage:
00CCB2  1               ;       MsgPointerLow, MsgPointerHi
00CCB2  1               ;
00CCB2  1               ; CPU Registers changed:  A, P
00CCB2  1               ;
00CCB2  1               DSString:
00CCB2  1                  phx                          ;save the X reg
00CCB2  1                  tsx                          ;put the stack pointer in X
00CCB2  1                  lda  MsgPointerLow
00CCB2  1                  pha                          ;push zero page location on stack
00CCB2  1                  lda  MsgPointerHi
00CCB2  1                  pha                          ;push zero page location on stack
00CCB2  1               
00CCB2  1                  lda  StackBase+2,x           ;determine the location of message to display
00CCB2  1                  clc
00CCB2  1                  adc  #$01                    ;add 1 because JSR pushes the last byte of its
00CCB2  1                  sta  MsgPointerLow           ; destination address on the stack
00CCB2  1               
00CCB2  1                  lda  StackBase+3,x
00CCB2  1                  adc  #0
00CCB2  1                  sta  MsgPointerHi
00CCB2  1               
00CCB2  1               dss1:
00CCB2  1                  lda  (MsgPointerLow)
00CCB2  1                  beq  dssend
00CCB2  1                  jsr  DSChar                  ;display message
00CCB2  1                  inc  MsgPointerLow
00CCB2  1                  bne  dss1
00CCB2  1                  inc  MsgPointerHi
00CCB2  1                  bra  dss1
00CCB2  1               
00CCB2  1               dssend:
00CCB2  1               
00CCB2  1                  lda  MsgPointerHi
00CCB2  1                  sta  StackBase+3,x
00CCB2  1                  lda  MsgPointerLow
00CCB2  1                  sta  StackBase+2,x           ;fix up the return address on the stack.
00CCB2  1               
00CCB2  1                  pla
00CCB2  1                  sta  MsgPointerHi            ;restore zero page location
00CCB2  1                  pla
00CCB2  1                  sta  MsgPointerLow           ;restore zero page location
00CCB2  1                  plx
00CCB2  1                  rts                          ;return to location after string's null.
00CCB2  1               
00CCB2  1               ;------------------------------------------------------------------------------
00CCB2  1               ; DSByteCRLF - Sends a Hex byte followed by a CR LF to the Super Serial
00CCB2  1               ; Card in Slot 2
00CCB2  1               ;
00CCB2  1               ; Input:
00CCB2  1               ;       A = Hex number to display
00CCB2  1               ; Ouput:
00CCB2  1               ;       None
00CCB2  1               ;
00CCB2  1               ; CPU Registers changed:  A, P
00CCB2  1               ;
00CCB2  1               DSByteCRLF:
00CCB2  1                  jsr DSByte
00CCB2  1               DSCRLF:
00CCB2  1                  lda  #$0D
00CCB2  1                  jsr  DSChar
00CCB2  1                  lda  #$0A
00CCB2  1                  bra  DSChar
00CCB2  1               
00CCB2  1               ;------------------------------------------------------------------------------
00CCB2  1               ; DSByte - Sends a Hex byte to the Super Serial Card in Slot 2
00CCB2  1               ; Input:
00CCB2  1               ;       A = Hex number to display
00CCB2  1               ; Ouput:
00CCB2  1               ;       None
00CCB2  1               ;
00CCB2  1               ; CPU Registers changed:  A, P
00CCB2  1               ;
00CCB2  1               DSByte:
00CCB2  1                  pha
00CCB2  1                  lsr a
00CCB2  1                  lsr a
00CCB2  1                  lsr a
00CCB2  1                  lsr a
00CCB2  1                  jsr DSNibble
00CCB2  1                  pla
00CCB2  1               DSNibble:
00CCB2  1                  and #$0F
00CCB2  1                  ora #$30
00CCB2  1                  cmp #$30+10
00CCB2  1                  bcc digit
00CCB2  1                  adc #6
00CCB2  1               digit:
00CCB2  1                  bra DSChar
00CCB2  1               
00CCB2  1               ;------------------------------------------------------------------------------
00CCB2  1               ; DSChar - Sends a char to the Super Serial Card in Slot 2
00CCB2  1               ; Input:
00CCB2  1               ;       A = Character to Send
00CCB2  1               ; Ouput:
00CCB2  1               ;       (data out serial port)
00CCB2  1               ;
00CCB2  1               ; ZeroPage Usage:
00CCB2  1               ;       None
00CCB2  1               ;
00CCB2  1               ; CPU Registers changed:  P
00CCB2  1               ;
00CCB2  1               DSBlank:
00CCB2  1                  lda #$20
00CCB2  1               DSChar:
00CCB2  1                  pha
00CCB2  1                  phy
00CCB2  1                  lda  mslot
00CCB2  1                  and  #$0f
00CCB2  1                  tay                          ;Y reg now has $0n for accessing scratchpad RAM
00CCB2  1                  lda  SerialInitDone,y
00CCB2  1                  cmp  #$A5
00CCB2  1                  beq  dsc0
00CCB2  1               
00CCB2  1               ; Init the serial port if sig byte is not $A5.
00CCB2  1               ; Set up serial port on the Apple Super Serial card. Always assume slot 2.
00CCB2  1                  lda  #$1f
00CCB2  1                  sta  $c0ab                   ;control register
00CCB2  1                  lda  #$0b
00CCB2  1                  sta  $c0aa                   ;format
00CCB2  1                  lda  $c0a9                   ;clear status
00CCB2  1                  lda  #$A5
00CCB2  1                  sta  SerialInitDone,y
00CCB2  1               
00CCB2  1               dsc0:
00CCB2  1                  lda  $c0a9
00CCB2  1                  and  #%00010000              ;Transmit register empty?
00CCB2  1                  beq  dsc0                    ;If not, wait
00CCB2  1               
00CCB2  1                  ply
00CCB2  1                  pla                          ;get byte back
00CCB2  1                  sta  $c0a8                   ;send it
00CCB2  1                  rts
00CCB2  1               
00CCB2  1               .ENDIF
00CCB2  1               
