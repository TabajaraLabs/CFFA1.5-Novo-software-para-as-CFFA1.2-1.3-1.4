00C750  1  4C 01 08 A5  
00C754  1  00 D0 0A A5  
00C758  1  01 CD F8 07  
00C75C  1  D0 03 4C BA  
00C760  1  FA 20 89 FE  
00C764  1  20 93 FE 20  
00C768  1  2F FB 20 58  
00C76C  1  FC A0 00 B9  
00C770  1  7F C7 F0 08  
00C774  1  09 80 20 ED  
00C778  1  FD C8 80 F3  
00C77C  1  4C 00 E0 0D  
00C780  1  0D 0D 0D 0D  
00C784  1  43 46 46 41  
00C788  1  3A 20 44 65  
00C78C  1  76 69 63 65  
00C790  1  20 6D 69 73  
00C794  1  73 69 6E 67  
00C798  1  2C 20 6E 6F  
00C79C  1  74 20 66 6F  
00C7A0  1  72 6D 61 74  
00C7A4  1  74 65 64 2C  
00C7A8  1  0D 6F 72 20  
00C7AC  1  69 6E 63 6F  
00C7B0  1  6D 70 61 74  
00C7B4  1  69 62 6C 65  
00C7B8  1  2E 0D 56 65  
00C7BC  1  72 3A 31 2E  
00C7C0  1  33 07 00 A0  
00C7C4  1  07 A2 70 A9  
00C7C8  1  C7 8D F8 07  
