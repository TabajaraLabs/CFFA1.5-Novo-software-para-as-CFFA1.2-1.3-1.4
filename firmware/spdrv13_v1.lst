00C800  1               .listbytes      12              ;revert back to normal listing mode for the rest
00C800  1               
00C800  1               ;-------------------- End of Peripheral Card ROM Space ----------------------
00C800  1               
00C800  1               
00C800  1               ;--------------------- Start of I/O expansion ROM Space --------------------
00C800  1               ; Code here starts at $c800
00C800  1               ; This code area is absolute and can use absolute addressing
00C800  1               .ORG   $C800                    ;note: .ORG does not cause this code to be
00C800  1                                               ; placed at C800. The ".RES" statement above
00C800  1                                               ; offsets this code
00C800  1               
00C800  1               
00C800  1               ;------------------------------------------------------------------------------
00C800  1               ; SmartPort
00C800  1               ;
00C800  1               ;------------------------------------------------------------------------------
00C800  1               MagicRawBlocksUnit EQU 127      ;use unit 127 in ReadBlock/WriteBlock calls for
00C800  1                                               ; raw LBA blocks.
00C800  1               
00C800  1               SPAuxROM:
00C800  1               ; save  ZP, fetch cmd + pointer from (PC)
00C800  1  A0 0C           ldy  #spZeroPgSize-1
00C802  1               save:
00C802  1  B9 42 00        lda  spZeroPgArea,y
00C805  1  48              pha
00C806  1  88              dey
00C807  1  10 F9           bpl  save
00C809  1  BA              tsx
00C80A  1  BD 0E 01        lda  $101+spZeroPgSize,x
00C80D  1  85 48           sta  spParamList
00C80F  1  18              clc
00C810  1  69 03           adc  #3
00C812  1  9D 0E 01        sta  $101+spZeroPgSize,x
00C815  1  BD 0F 01        lda  $102+spZeroPgSize,x
00C818  1  85 49           sta  spParamList+1
00C81A  1  69 00           adc  #0
00C81C  1  9D 0F 01        sta  $102+spZeroPgSize,x
00C81F  1               
00C81F  1               ; set up spSlot and spSlotX16
00C81F  1  AD F8 07        lda  mslot
00C822  1  29 0F           and  #$0f
00C824  1  A8              tay
00C825  1  0A              asl  a
00C826  1  0A              asl  a
00C827  1  0A              asl  a
00C828  1  0A              asl  a
00C829  1  AA              tax
00C82A  1  84 4D           sty  spSlot
00C82C  1  86 4E           stx  spSlotX16
00C82E  1               
00C82E  1               ; clear DrvMiscFlags
00C82E  1  A9 00           lda  #0
00C830  1  99 78 07        sta  DrvMiscFlags,y          ;no special flags (such as raw block access)
00C833  1               
00C833  1               ; reset the device if this is our first call
00C833  1  20 B1 CA        jsr  ResetDriveIfFirstTime   ;needs Y
00C836  1               
00C836  1               .IF DEBUG
00C836  1               ;warning this debug code trashes the Acc register
00C836  1                  jsr  DSString
00C836  1                  .byte "SP:",0
00C836  1               .ENDIF
00C836  1               
00C836  1               ; get command code from parameter list
00C836  1  A0 01           ldy  #1
00C838  1  B1 48           lda  (spParamList),y
00C83A  1  85 42           sta  spCommandCode
00C83C  1  C8              iny
00C83D  1  B1 48           lda  (spParamList),y
00C83F  1  AA              tax
00C840  1  C8              iny
00C841  1  B1 48           lda  (spParamList),y
00C843  1  85 49           sta  spParamList+1
00C845  1  86 48           stx  spParamList
00C847  1               
00C847  1  A9 01           lda  #PRODOS_BADCMD          ;anticipate bad command error
00C849  1  A6 42           ldx  spCommandCode
00C84B  1  E0 0A           cpx  #$09+1                  ;command too large
00C84D  1  B0 1E           bcs  out
00C84F  1               
00C84F  1  B2 48           lda  (spParamList)           ;parameter count
00C851  1  DD 8A C8        cmp  RequiredParamCounts,x   ;command number still in X
00C854  1  F0 04           beq  pCountOK
00C856  1               
00C856  1  A9 04           lda  #$04                    ;bad parameter count error
00C858  1  80 13           bra  out
00C85A  1               
00C85A  1               pCountOK:
00C85A  1  A0 01           ldy  #1
00C85C  1  B1 48           lda  (spParamList),y
00C85E  1  A4 4D           ldy  spSlot
00C860  1  99 F8 04        sta  DriveNumber,y
00C863  1               
00C863  1  8A              txa                            ;X is still the command code
00C864  1  0A              asl  a
00C865  1  AA              tax
00C866  1  20 81 C8        jsr  JumpToSPCommand           ;Y is still spSlot
00C869  1               
00C869  1  B0 02           bcs  out
00C86B  1  A9 00           lda  #0
00C86D  1               
00C86D  1               out:
00C86D  1  AA              tax                           ;error code in X
00C86E  1               
00C86E  1               ; Restore zero page
00C86E  1  A0 00           ldy  #0
00C870  1               restore:
00C870  1  68              pla
00C871  1  99 42 00        sta  spZeroPgArea,y
00C874  1  C8              iny
00C875  1  C0 0D           cpy  #spZeroPgSize
00C877  1  90 F7           bcc  restore
00C879  1               
00C879  1  8A              txa
00C87A  1  A0 02           ldy  #2                      ;high byte of # bytes transferred
00C87C  1                                               ; (always (1) undefined, or
00C87C  1                                               ; (2) #bytes transferred to host)
00C87C  1  A2 00           ldx  #0                      ;low byte of # bytes transferred
00C87E  1  C9 01           cmp  #1                      ;C=1 if error code nonzero
00C880  1  60              rts
00C881  1               
00C881  1               JumpToSPCommand:
00C881  1  BD 95 C8        lda  spDispatch+1,x
00C884  1  48              pha
00C885  1  BD 94 C8        lda  spDispatch,x
00C888  1  48              pha
00C889  1  60              rts
00C88A  1               
00C88A  1               RequiredParamCounts:
00C88A  1  03              .byte 3   ;0 = status
00C88B  1  03              .byte 3   ;1 = read
00C88C  1  03              .byte 3   ;2 = write
00C88D  1  01              .byte 1   ;3 = format
00C88E  1  03              .byte 3   ;4 = control
00C88F  1  01              .byte 1   ;5 = init
00C890  1  01              .byte 1   ;6 = open
00C891  1  01              .byte 1   ;7 = close
00C892  1  04              .byte 4   ;8 = read
00C893  1  04              .byte 4   ;9 = write
00C894  1               
00C894  1               spDispatch:
00C894  1  A7 C8           .word spStatus-1
00C896  1  B6 C9           .word spReadBlock-1
00C898  1  C3 C9           .word spWriteBlock-1
00C89A  1  CF C9           .word spFormat-1
00C89C  1  D2 C9           .word spControl-1
00C89E  1  F6 C9           .word spInit-1
00C8A0  1  01 CA           .word spOpen-1
00C8A2  1  01 CA           .word spClose-1
00C8A4  1  05 CA           .word spReadChars-1
00C8A6  1  05 CA           .word spWriteChars-1
00C8A8  1               
00C8A8  1               ;------------------------------------------------------------------------------
00C8A8  1               ; SmartPort STATUS call
00C8A8  1               ;
00C8A8  1               ; We support the standard calls, plus an "Identify" command
00C8A8  1               ; for unit 0, which fills a buffer with the card's Identify
00C8A8  1               ; data.
00C8A8  1               ;
00C8A8  1               spStatus:
00C8A8  1  20 0A CA        jsr  SPSetupControlOrStatus
00C8AB  1  B0 32           bcs  statOut
00C8AD  1               
00C8AD  1  A4 4D           ldy  spSlot
00C8AF  1  B9 F8 04        lda  DriveNumber,y
00C8B2  1  D0 33           bne  StatusForOneUnit
00C8B4  1               
00C8B4  1               ; StatusCode = 0 && unit == 0: status for this entire SmartPort interface
00C8B4  1  A5 4C           lda  spCSCode
00C8B6  1  F0 0B           beq  Status00
00C8B8  1               
00C8B8  1               ; Status for unit 0, subcode $49 = Identify (device-specific subcode)
00C8B8  1  C9 49           cmp  #$49
00C8BA  1  D0 03           bne  BadStatusCode
00C8BC  1  4C 48 C9        jmp  spStatusIdentify
00C8BF  1               
00C8BF  1               ; Any other status code for unit 0 is an error.
00C8BF  1               BadStatusCode:
00C8BF  1  A9 21           lda  #$21
00C8C1  1  38              sec
00C8C2  1  60              rts
00C8C3  1               
00C8C3  1               Status00:
00C8C3  1  A6 4E           ldx  spSlotX16
00C8C5  1  A4 4D           ldy  spSlot
00C8C7  1  20 DA CA        jsr  GetStatus
00C8CA  1  B0 13           bcs  statOut
00C8CC  1               
00C8CC  1  A4 4D           ldy  spSlot
00C8CE  1  B9 F8 06        lda  DrvBlkCount2,y
00C8D1  1  1A              inc  a
00C8D2  1  92 4A           sta  (spCmdList)        ;byte +0 = number of drives
00C8D4  1               
00C8D4  1  A0 07           ldy  #7
00C8D6  1               Stat00Loop:
00C8D6  1  B9 DF C8        lda  Stat00Data-1,y
00C8D9  1  91 4A           sta  (spCmdList),y
00C8DB  1  88              dey
00C8DC  1  D0 F8           bne  Stat00Loop
00C8DE  1  18              clc
00C8DF  1               statOut:
00C8DF  1  60              rts
00C8E0  1               
00C8E0  1               Stat00Data:
00C8E0  1  40              .byte $40                    ;Interrupt flag = no interrupts caused by this
00C8E1  1                                               ; interface
00C8E1  1               
00C8E1  1  00 CC           .word $CC00                  ;Vendor ID assigned to Rich Dreher by
00C8E3  1                                               ; www.syndicomm.com 3/16/2002
00C8E3  1               
00C8E3  1  00 12           .word SPDRIVERVERSION        ;Our version number
00C8E5  1  00              .byte $00                    ;Reserved byte
00C8E6  1  00              .byte $00                    ;Reserved byte
00C8E7  1               
00C8E7  1               StatusForOneUnit:
00C8E7  1  3A              dec  a
00C8E8  1  99 F8 04        sta  DriveNumber,y
00C8EB  1               
00C8EB  1  A6 4C           ldx  spCSCode
00C8ED  1  F0 16           beq  Status0or3
00C8EF  1  CA              dex
00C8F0  1  F0 08           beq  StatusGetDCB
00C8F2  1  CA              dex
00C8F3  1  CA              dex
00C8F4  1  F0 0F           beq  Status0or3
00C8F6  1  A9 21           lda  #$21                    ;Bad status code
00C8F8  1  38              sec
00C8F9  1  60              rts
00C8FA  1               ;
00C8FA  1               ; We have no interesting data to return for the device control
00C8FA  1               ; block, so return the shortest one allowed: a length byte of
00C8FA  1               ; 1 followed by a data byte of 0.
00C8FA  1               ;
00C8FA  1               StatusGetDCB:
00C8FA  1  A9 01           lda  #1
00C8FC  1  92 4A           sta  (spCmdList)             ;Returned length = 1
00C8FE  1  A8              tay
00C8FF  1  A9 00           lda  #0
00C901  1  91 4A           sta  (spCmdList),y           ;Returned data = $00
00C903  1  18              clc
00C904  1  60              rts
00C905  1               
00C905  1               ;
00C905  1               ; Status code 0 and 3 start off the same; 3 returns extra data.
00C905  1               ;
00C905  1               ; 0: return device status (1 byte device status + 3-byte block count)
00C905  1               ; 3: return Device Information Block
00C905  1               ;
00C905  1               Status0or3:
00C905  1  A9 F8           lda  #$F8                    ;Block device, write, read, format, online,
00C907  1                                               ; not write-prot
00C907  1  92 4A           sta  (spCmdList)
00C909  1  A6 4E           ldx  spSlotX16
00C90B  1  A4 4D           ldy  spSlot
00C90D  1  20 DA CA        jsr  GetStatus               ;Returns block count in YX
00C910  1  B0 CD           bcs  statOut
00C912  1               
00C912  1  98              tya
00C913  1  A0 02           ldy  #2
00C915  1  91 4A           sta  (spCmdList),y           ;CmdList +2 = bits 8..15 of block count
00C917  1  88              dey
00C918  1  8A              txa                          ;CmdList +1 = bits 0..7 of block count
00C919  1  91 4A           sta  (spCmdList),y
00C91B  1  A0 03           ldy  #3
00C91D  1  A9 00           lda  #0
00C91F  1  91 4A           sta  (spCmdList),y           ;CmdList +3 = bits 16..23 of block count
00C921  1               
00C921  1  A5 4C           lda  spCSCode
00C923  1  F0 0C           beq  statDone
00C925  1               
00C925  1               ; status code 3: return 21 more bytes of data
00C925  1  A0 04           ldy #4
00C927  1               stat3Loop:
00C927  1  B9 2F C9        lda  stat3Data-4,y
00C92A  1  91 4A           sta  (spCmdList),y
00C92C  1  C8              iny
00C92D  1  C0 19           cpy  #21+4
00C92F  1  90 F6           bcc  stat3Loop
00C931  1               
00C931  1               statDone:
00C931  1  18              clc
00C932  1  60              rts
00C933  1               
00C933  1               stat3Data:
00C933  1  0D 43 4F 4D     .byte 13,"COMPACT FLASH   "  ;length byte + 16-byte ASCII, padded
00C937  1  50 41 43 54  
00C93B  1  20 46 4C 41  
00C944  1  02              .byte $02                    ;device type = hard disk
00C945  1  20              .byte $20                    ;subtype (no removable media, no extended,
00C946  1                                               ; no disk switched)
00C946  1  00 12           .word SPDRIVERVERSION
00C948  1               
00C948  1               ;------------------------------------------------------------------------------
00C948  1               ; Identify (Status subcode)
00C948  1               ;
00C948  1               ; The status list is a 512-byte buffer that we will fill with
00C948  1               ; the drive's IDE "Identify" data.  We post-process the data
00C948  1               ; by byte-swapping the model name and serial number strings
00C948  1               ; so they make sense.
00C948  1               ;
00C948  1               spStatusIdentify:
00C948  1  A4 4D           ldy  spSlot
00C94A  1  A6 4E           ldx  spSlotX16
00C94C  1  20 82 CC        jsr  CheckDevice
00C94F  1  90 03           bcc  ident1
00C951  1  A9 28           lda  #PRODOS_NO_DEVICE
00C953  1  60              rts                          ;return error code in Acc with Carry set
00C954  1               
00C954  1               ident1:
00C954  1  A9 00           lda  #0
00C956  1  9D 80 C0        sta  ATADataHigh,x
00C959  1               
00C959  1  A9 EC           lda  #ATAIdentify
00C95B  1  9D 8F C0        sta  ATACommand,x            ;Issue the read command to the drive
00C95E  1  20 78 CC        jsr  IDEWaitReady            ;Wait for BUSY flag to go away
00C961  1               
00C961  1  BD 8F C0        lda  ATAStatus,x             ;Check for error response
00C964  1  29 09           and  #$09
00C966  1  C9 01           cmp  #$01                    ;if DRQ=0 and ERR=1 an error occured
00C968  1  D0 04           bne  iCommandOK
00C96A  1               
00C96A  1               iError:
00C96A  1               .IF DEBUG
00C96A  1               ;warning this debug code trashes the Acc register
00C96A  1                  jsr DSString
00C96A  1                  .byte "spIdfy Err:",0
00C96A  1                  lda  ATAError,x
00C96A  1                  jsr  DSByteCRLF
00C96A  1               .ENDIF
00C96A  1               
00C96A  1  A9 27           lda  #PRODOS_IO_ERROR
00C96C  1  38              sec
00C96D  1  60              rts                          ;return error code in Acc with Carry set
00C96E  1               ;
00C96E  1               ; The "Identify" data is ready to read
00C96E  1               ;
00C96E  1               pageCount = spCommandCode       ;re-use a zero-page location
00C96E  1               
00C96E  1               iCommandOK:
00C96E  1  A0 02           ldy  #2
00C970  1  84 42           sty  pageCount
00C972  1  A0 00           ldy  #0
00C974  1               iLoop:
00C974  1  BD 8F C0        lda  ATAStatus,x             ;Note: not using IDEWaitReady, inline code
00C977  1                                               ; instead
00C977  1  30 FB           bmi  iLoop                   ;Wait for BUSY (bit 7) to be zero
00C979  1  29 08           and  #$08                    ;get DRQ status bit
00C97B  1  F0 ED           beq  iError                  ;if off, didn't get enough data
00C97D  1               
00C97D  1  BD 88 C0        lda  ATADataLow,x
00C980  1  91 4A           sta  (spCmdList),y
00C982  1  C8              iny
00C983  1  BD 80 C0        lda  ATADataHigh,x
00C986  1  91 4A           sta  (spCmdList),y
00C988  1  C8              iny
00C989  1  D0 E9           bne  iLoop
00C98B  1  E6 4B           inc  spCmdList+1
00C98D  1  C6 42           dec  pageCount
00C98F  1  D0 E3           bne  iLoop
00C991  1               
00C991  1               ; Swap ASCII text data of the Identify data to be more readable.
00C991  1               ; These are both on the first page of the data.
00C991  1               
00C991  1  C6 4B           dec  spCmdList+1
00C993  1  C6 4B           dec  spCmdList+1             ;Point to beginning of buffer
00C995  1               
00C995  1  A0 2E           ldy  #23*2                   ;Start at word 23 (firmware rev, model number)
00C997  1  A2 18           ldx  #24                     ;24 words
00C999  1  20 A5 C9        jsr  SwapBytes
00C99C  1               
00C99C  1  A0 14           ldy  #10*2                   ;Start at word 10 (serial number)
00C99E  1  A2 0A           ldx  #10                     ;10 words
00C9A0  1  20 A5 C9        jsr  SwapBytes
00C9A3  1               
00C9A3  1  18              clc
00C9A4  1  60              rts
00C9A5  1               
00C9A5  1               ;------------------------------------------------------------------------------
00C9A5  1               SwapBytes:
00C9A5  1  B1 4A           lda  (spCmdList),y
00C9A7  1  48              pha                          ;Save the 1st byte
00C9A8  1  C8              iny
00C9A9  1  B1 4A           lda  (spCmdList),y           ;Get the 2nd byte
00C9AB  1  88              dey
00C9AC  1  91 4A           sta  (spCmdList),y           ;Store it in position 1
00C9AE  1  C8              iny
00C9AF  1  68              pla                          ;Finally, retrieve the 1st byte
00C9B0  1  91 4A           sta  (spCmdList),y           ;Put it in position 2
00C9B2  1  C8              iny
00C9B3  1  CA              dex
00C9B4  1  D0 EF           bne  SwapBytes
00C9B6  1  60              rts
00C9B7  1               
00C9B7  1               ;------------------------------------------------------------------------------
00C9B7  1               ; SmartPort READ BLOCK command
00C9B7  1               ;
00C9B7  1               spReadBlock:
00C9B7  1  20 1C CA        jsr  SPSetupReadWrite
00C9BA  1  B0 07           bcs  readDone
00C9BC  1               
00C9BC  1  A4 4D           ldy  spSlot
00C9BE  1  A6 4E           ldx  spSlotX16
00C9C0  1  4C 8F CB        jmp  ReadBlock
00C9C3  1               
00C9C3  1               readDone:
00C9C3  1               writeDone:
00C9C3  1  60              rts
00C9C4  1               
00C9C4  1               ;------------------------------------------------------------------------------
00C9C4  1               ; SmartPort WRITE BLOCK command
00C9C4  1               ;
00C9C4  1               spWriteBlock:
00C9C4  1  20 1C CA        jsr SPSetupReadWrite
00C9C7  1  B0 FA           bcs writeDone
00C9C9  1               
00C9C9  1  A4 4D           ldy spSlot
00C9CB  1  A6 4E           ldx spSlotX16
00C9CD  1  4C EA CB        jmp WriteBlock
00C9D0  1               
00C9D0  1               ;------------------------------------------------------------------------------
00C9D0  1               ; SmartPort FORMAT command
00C9D0  1               ;
00C9D0  1               ; We don't actually do anything beyond validating the unit number.
00C9D0  1               ;
00C9D0  1               spFormat:
00C9D0  1  4C 65 CA        jmp SPValidateUnitNumber
00C9D3  1               
00C9D3  1               ;------------------------------------------------------------------------------
00C9D3  1               ; SmartPort CONTROL command
00C9D3  1               ;
00C9D3  1               spControl:
00C9D3  1  20 0A CA        jsr SPSetupControlOrStatus
00C9D6  1  B0 18           bcs ctrlDone
00C9D8  1               
00C9D8  1  20 65 CA        jsr SPValidateUnitNumber
00C9DB  1  B0 13           bcs ctrlDone
00C9DD  1               
00C9DD  1  A6 4C           ldx spCSCode
00C9DF  1  F0 14           beq ctlReset                 ;Control code 0 = Reset
00C9E1  1  CA              dex
00C9E2  1  F0 11           beq ctlSetDCB                ;Control code 1 = SetDCB
00C9E4  1  CA              dex
00C9E5  1  F0 06           beq ctlSetNewline            ;Control code 2 = SetNewline
00C9E7  1  CA              dex
00C9E8  1  F0 07           beq ctlServiceInterrupt      ;Control code 3 = ServiceInterrupt
00C9EA  1  CA              dex
00C9EB  1  F0 08           beq ctlEject                 ;Control code 4 = Eject
00C9ED  1               
00C9ED  1               ctlSetNewline:
00C9ED  1  A9 21           lda #$21                     ;Bad control code
00C9EF  1  38              sec
00C9F0  1               ctrlDone:
00C9F0  1  60              rts
00C9F1  1               
00C9F1  1               ctlServiceInterrupt:
00C9F1  1  A9 1F           lda #$1f                     ;Interrupt devices not supported
00C9F3  1  38              sec
00C9F4  1  60              rts
00C9F5  1               
00C9F5  1               ctlReset:
00C9F5  1               ctlSetDCB:
00C9F5  1               ctlEject:
00C9F5  1  18              clc
00C9F6  1  60              rts
00C9F7  1               
00C9F7  1               ;------------------------------------------------------------------------------
00C9F7  1               ; SmartPort INIT command
00C9F7  1               ;
00C9F7  1               ; unit 0 = entire chain
00C9F7  1               ;
00C9F7  1               ;  SmartPort Technote #2 says you can't init an individual unit;
00C9F7  1               ;  so return error if DriveNumber is nonzero.
00C9F7  1               ;
00C9F7  1               spInit:
00C9F7  1  B9 F8 04        lda DriveNumber,y
00C9FA  1  F0 04           beq initChain
00C9FC  1  A9 11           lda #BAD_UNIT_NUMBER
00C9FE  1  38              sec
00C9FF  1  60              rts
00CA00  1               
00CA00  1               initChain:
00CA00  1  18              clc
00CA01  1  60              rts
00CA02  1               
00CA02  1               
00CA02  1               ;------------------------------------------------------------------------------
00CA02  1               ; SmartPort: Open and Close are for character devices only
00CA02  1               ;
00CA02  1               spOpen:
00CA02  1               spClose:
00CA02  1  A9 01           lda #PRODOS_BADCMD
00CA04  1  38              sec
00CA05  1  60              rts
00CA06  1               
00CA06  1               ;------------------------------------------------------------------------------
00CA06  1               ; SmartPort: Read, Write
00CA06  1               ;
00CA06  1               ; We don't bother implementing Read and Write, although they are allowed
00CA06  1               ; for block devices.  We would only support 512-byte transfers anyway.
00CA06  1               ;
00CA06  1               spReadChars:
00CA06  1               spWriteChars:
00CA06  1  A9 27           lda #PRODOS_IO_ERROR
00CA08  1  38              sec
00CA09  1  60              rts
00CA0A  1               
00CA0A  1               
00CA0A  1               ;------------------------------------------------------------------------------
00CA0A  1               ; SPSetupControlOrStatus
00CA0A  1               ;
00CA0A  1               ; fetch from parameter block:
00CA0A  1               ;    status/control list pointer (word)
00CA0A  1               ;    status/control code (byte)
00CA0A  1               ;
00CA0A  1               SPSetupControlOrStatus:
00CA0A  1  A0 02           ldy #2
00CA0C  1  B1 48           lda (spParamList),y
00CA0E  1  85 4A           sta spCmdList
00CA10  1  C8              iny
00CA11  1  B1 48           lda (spParamList),y
00CA13  1  85 4B           sta spCmdList+1
00CA15  1  C8              iny
00CA16  1  B1 48           lda (spParamList),y
00CA18  1  85 4C           sta spCSCode
00CA1A  1  18              clc
00CA1B  1  60              rts
00CA1C  1               
00CA1C  1               ;------------------------------------------------------------------------------
00CA1C  1               ; SPSetupReadWrite
00CA1C  1               ;
00CA1C  1               ; Input:
00CA1C  1               ;    DriveNumber,y is already a copy of SmartPort unit number
00CA1C  1               ;
00CA1C  1               ; fetch from SP parameter list:
00CA1C  1               ;   buffer pointer
00CA1C  1               ;   block number
00CA1C  1               ;
00CA1C  1               ; Validate unit number:
00CA1C  1               ;   127 = magic, allow any block number
00CA1C  1               ;   1..N:  Validate block number: $0..FFFE
00CA1C  1               ;
00CA1C  1               ; DriveNumber,y: translated unit number in case unit was magic
00CA1C  1               ; DrvMiscFlags: bit 7 set if we should not use BLOCKOFFSET
00CA1C  1               ;
00CA1C  1               SPSetupReadWrite:
00CA1C  1               ; copy pdIOBuffer from parameter list
00CA1C  1  A0 02           ldy #2
00CA1E  1  B1 48           lda (spParamList),y
00CA20  1  85 44           sta pdIOBuffer
00CA22  1  C8              iny
00CA23  1  B1 48           lda (spParamList),y
00CA25  1  85 45           sta pdIOBuffer+1
00CA27  1               
00CA27  1               ; copy pdBlockNumber from parameter list
00CA27  1  C8              iny
00CA28  1  B1 48           lda (spParamList),y
00CA2A  1  85 46           sta pdBlockNumber
00CA2C  1  C8              iny
00CA2D  1  B1 48           lda (spParamList),y
00CA2F  1  85 47           sta pdBlockNumber+1
00CA31  1               
00CA31  1               ; Validate the unit number and block number.
00CA31  1  A4 4D           ldy spSlot
00CA33  1  B9 F8 04        lda DriveNumber,y
00CA36  1  C9 7F           cmp #MagicRawBlocksUnit
00CA38  1  F0 18           beq magicUnit
00CA3A  1               
00CA3A  1  20 65 CA        jsr SPValidateUnitNumber
00CA3D  1  B0 12           bcs srwOut
00CA3F  1               
00CA3F  1  A0 06           ldy #6
00CA41  1  B1 48           lda (spParamList),y          ;Bits 16..23 of block number must be $00
00CA43  1  D0 09           bne badBlockNum
00CA45  1               
00CA45  1  A5 47           lda pdBlockNumber+1          ;Block $FFFF is invalid
00CA47  1  25 46           and pdBlockNumber
00CA49  1  1A              inc a
00CA4A  1  F0 02           beq badBlockNum
00CA4C  1  18              clc
00CA4D  1  60              rts
00CA4E  1               
00CA4E  1               badBlockNum:
00CA4E  1  A9 2D           lda #PRODOS_BADBLOCK         ;Bad block number
00CA50  1  38              sec
00CA51  1               srwOut:
00CA51  1  60              rts
00CA52  1               ;
00CA52  1               ; For the "magic raw blocks" unit, allow a full 3-byte block number.
00CA52  1               ;
00CA52  1               magicUnit:
00CA52  1  A9 80           lda #$80
00CA54  1  19 78 07        ora DrvMiscFlags,y
00CA57  1  99 78 07        sta DrvMiscFlags,y           ;Raw block access
00CA5A  1               
00CA5A  1  A0 06           ldy #6
00CA5C  1  B1 48           lda (spParamList),y          ;Bits 16..23 of block number
00CA5E  1  A4 4D           ldy spSlot
00CA60  1  99 F8 04        sta DriveNumber,y
00CA63  1  18              clc
00CA64  1  60              rts
00CA65  1               
00CA65  1               ;------------------------------------------------------------------------------
00CA65  1               ; SPValidateUnitNumber
00CA65  1               ;
00CA65  1               ; Validate that DriveNumber is from 1 to N.
00CA65  1               ;
00CA65  1               ; Input: DriveNumber
00CA65  1               ;
00CA65  1               ; Output: DriveNumber in range 0..N-1
00CA65  1               ;
00CA65  1               SPValidateUnitNumber:
00CA65  1  A4 4D           ldy spSlot
00CA67  1  B9 F8 04        lda DriveNumber,y
00CA6A  1  F0 0D           beq badUnit
00CA6C  1  3A              dec a
00CA6D  1  99 F8 04        sta DriveNumber,y
00CA70  1  D9 F8 06        cmp DrvBlkCount2,y
00CA73  1  F0 02           beq unitOK
00CA75  1  B0 02           bcs badUnit
00CA77  1               unitOK:
00CA77  1  18              clc
00CA78  1  60              rts
00CA79  1               
00CA79  1               badUnit:
00CA79  1  A9 11           lda #BAD_UNIT_NUMBER
00CA7B  1  38              sec
00CA7C  1  60              rts
00CA7D  1               
00CA7D  1               ;------------------------------------------------------------------------------
00CA7D  1               ; P8AuxROM - Handle a ProDOS call
00CA7D  1               ;
00CA7D  1               P8AuxROM:
00CA7D  1               
00CA7D  1               ; If the ProDOS unit number doesn't match our slot number, add 2 to
00CA7D  1               ; the drive number.
00CA7D  1               ;
00CA7D  1               ; This actually happens: If we're in slot 5, we get calls for slot 2
00CA7D  1               ; that want to access our 3rd and 4th partitions.
00CA7D  1  8A              txa                          ; A = $n0
00CA7E  1  45 43           eor  pdUnitNumber
00CA80  1  29 70           and  #$70                    ;EOR the slot number
00CA82  1  F0 02           beq  OurSlot
00CA84  1  A9 02           lda  #2                      ;Point to drive 3 or 4
00CA86  1               
00CA86  1               OurSlot:
00CA86  1  24 43           bit  pdUnitNumber
00CA88  1  10 01           bpl  DriveOne
00CA8A  1  1A              inc  a
00CA8B  1               
00CA8B  1               DriveOne:
00CA8B  1  99 F8 04        sta  DriveNumber,y
00CA8E  1  A9 00           lda  #0
00CA90  1  99 78 07        sta  DrvMiscFlags,y          ;no special flags (such as raw block access)
00CA93  1               
00CA93  1  20 B1 CA        jsr  ResetDriveIfFirstTime
00CA96  1               
00CA96  1               ; process the command code and jump to appropriate routine.
00CA96  1               
00CA96  1               .IF DEBUG
00CA96  1               ;warning this debug code trashes the Acc register
00CA96  1                  jsr  DSString
00CA96  1                  .byte "P8:",0
00CA96  1               .ENDIF
00CA96  1               
00CA96  1  A5 42           lda  pdCommandCode
00CA98  1  C9 01           cmp  #PRODOS_READ
00CA9A  1  D0 03           bne  chk1
00CA9C  1  4C 8F CB        jmp  ReadBlock
00CA9F  1               
00CA9F  1               chk1:
00CA9F  1  C9 02           cmp  #PRODOS_WRITE
00CAA1  1  D0 03           bne  chk2
00CAA3  1  4C EA CB        jmp  WriteBlock
00CAA6  1               
00CAA6  1               chk2:
00CAA6  1  C9 00           cmp  #PRODOS_STATUS
00CAA8  1  D0 03           bne  chk3
00CAAA  1  4C DA CA        jmp  GetStatus
00CAAD  1               
00CAAD  1               chk3:
00CAAD  1               ; An invalid request # has been sent to this driver.
00CAAD  1               ;
00CAAD  1               .IF DEBUG
00CAAD  1                  pha
00CAAD  1                  jsr DSString
00CAAD  1                  .byte "CE",0
00CAAD  1                  pla
00CAAD  1                  jsr  DSByteCRLF
00CAAD  1               .ENDIF
00CAAD  1               
00CAAD  1  A9 27           lda  #PRODOS_IO_ERROR
00CAAF  1  38              sec
00CAB0  1  60              rts                             ;return to caller. Should always be ProDOS
00CAB1  1               
00CAB1  1               ;------------------------------------------------------------------------------
00CAB1  1               ; ResetDriveIfFirstTime - Reset the drive once, the first time the driver
00CAB1  1               ; is called ide_devctrl Bit 2 = Software Reset, Bit 1 = nIEN (enable
00CAB1  1               ; assertion of INTRQ)
00CAB1  1               ;
00CAB1  1               ; Input:
00CAB1  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CAB1  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CAB1  1               ;
00CAB1  1               ; ZeroPage Usage:
00CAB1  1               ;       None
00CAB1  1               ;
00CAB1  1               ; CPU Registers changed:  A, P
00CAB1  1               ;
00CAB1  1               ResetDriveIfFirstTime:
00CAB1  1  B9 78 04        lda  DriveResetDone,Y
00CAB4  1  C9 A5           cmp  #INITDONESIG
00CAB6  1  F0 21           beq  resetOK
00CAB8  1               ;
00CAB8  1               ; Reset the ATA device
00CAB8  1               ;
00CAB8  1  A9 00           lda  #0
00CABA  1  9D 80 C0        sta  ATADataHigh,x           ;Clear high byte data latch
00CABD  1               
00CABD  1  A9 06           lda  #$06                    ;Reset bit=1, Disable INTRQ=1
00CABF  1  9D 86 C0        sta  ATADevCtrl,x
00CAC2  1               ;
00CAC2  1               ; Per ATA-6 spec, need to wait 5us minimum. Use a delay of 100us.
00CAC2  1               ; Should cover accelerated Apples up to 20Mhz.
00CAC2  1               ;
00CAC2  1  A9 04           lda  #WAIT_100us
00CAC4  1  20 A6 CC        jsr  Wait
00CAC7  1               
00CAC7  1  A9 02           lda  #$02                    ;Reset bit=0, Disable INTRQ=1
00CAC9  1  9D 86 C0        sta  ATADevCtrl,x
00CACC  1               ;
00CACC  1               ; Per ATA-6 spec, need to wait 2ms minimum. Use a delay of 40ms.
00CACC  1               ; Should cover accelerated Apples up to 20Mhz.
00CACC  1               ;
00CACC  1  A9 7C           lda  #WAIT_40ms
00CACE  1  20 A6 CC        jsr  Wait
00CAD1  1               ;
00CAD1  1               ; Per ATA-6 spec, wait for busy to clear, by calling IDEWaitReady
00CAD1  1               ;
00CAD1  1  20 78 CC        jsr  IDEWaitReady
00CAD4  1               
00CAD4  1  A9 A5           lda  #INITDONESIG
00CAD6  1  99 78 04        sta  DriveResetDone,Y        ;Set the init done flag so init only happens
00CAD9  1                                               ; once.
00CAD9  1               resetOK:
00CAD9  1  60              rts
00CADA  1               
00CADA  1               ;------------------------------------------------------------------------------
00CADA  1               ; GetStatus - Called by ProDOS and SmartPort to get device status and size
00CADA  1               ;
00CADA  1               ; Input:
00CADA  1               ;       DriveNumber,y (0 to 3)
00CADA  1               ;       X = slot number in form $n0 where n = slot 1 to 7
00CADA  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CADA  1               ;
00CADA  1               ; Output:
00CADA  1               ;       A = ProDOS status return code
00CADA  1               ;       X = drive size LSB
00CADA  1               ;       Y = drive size MSB
00CADA  1               ;       Carry flag: 0 = Okay, 1 = Error
00CADA  1               ;       DrvBlkCount0..DrvBlkCount2 = usable blocks on device
00CADA  1               ;
00CADA  1               GetStatus:
00CADA  1               
00CADA  1               .IF DEBUG
00CADA  1               ;warning this debug code trashes the Acc register
00CADA  1                  jsr  DSString
00CADA  1                  .byte " St",0
00CADA  1                  jsr  DisplayParms
00CADA  1               .ENDIF
00CADA  1               
00CADA  1               ;
00CADA  1               ; Determine if a drive/device is present.
00CADA  1               ;
00CADA  1  20 82 CC        jsr  CheckDevice
00CADD  1  90 0A           bcc  sDriveOK
00CADF  1               
00CADF  1  A2 00           ldx  #$00
00CAE1  1  A0 00           ldy  #$00
00CAE3  1  A9 2F           lda  #PRODOS_OFFLINE
00CAE5  1  38              sec
00CAE6  1  4C 8E CB        jmp  sExit
00CAE9  1               
00CAE9  1               ; Device is present
00CAE9  1               sDriveOK:
00CAE9  1  A9 00           lda  #0
00CAEB  1  9D 80 C0        sta  ATADataHigh,x           ;clear high byte transfer latch
00CAEE  1               
00CAEE  1  20 78 CC        jsr  IDEWaitReady
00CAF1  1  A9 EC           lda  #ATAIdentify
00CAF3  1  9D 8F C0        sta  ATACommand,x            ;Issue the read command to the drive
00CAF6  1  20 78 CC        jsr  IDEWaitReady            ;Wait for BUSY flag to go away
00CAF9  1               
00CAF9  1  BD 8F C0        lda  ATAStatus,x             ;Check for error response
00CAFC  1  29 09           and  #$09
00CAFE  1  C9 01           cmp  #$01                     ;if DRQ=0 and ERR=1 an error occured
00CB00  1  D0 0A           bne  sValidATACommand
00CB02  1               
00CB02  1               .IF DEBUG
00CB02  1               ;warning this debug code trashes the Acc register
00CB02  1                  jsr DSString
00CB02  1                  .byte " Idfy Err:",0
00CB02  1                  lda  ATAError,x
00CB02  1                  jsr  DSByteCRLF
00CB02  1               .ENDIF
00CB02  1               
00CB02  1  A2 00           ldx  #0
00CB04  1  A0 00           ldy  #0
00CB06  1  A9 27           lda  #PRODOS_IO_ERROR
00CB08  1  38              sec
00CB09  1  4C 8E CB        jmp  sExit                   ; Command Error occured, return error
00CB0C  1               
00CB0C  1               sValidATACommand:
00CB0C  1  5A              phy                          ;save Y, it holds the $0n sratchpad RAM offset
00CB0D  1  A0 00           ldy  #$00                    ;zero loop counter
00CB0F  1               
00CB0F  1               sPrefetchloop:
00CB0F  1  20 78 CC        jsr  IDEWaitReady            ;See if a word is ready
00CB12  1  B0 06           bcs  sWordRdy
00CB14  1  7A              ply
00CB15  1  A9 27           lda  #PRODOS_IO_ERROR
00CB17  1  4C 8E CB        jmp  sExit
00CB1A  1               
00CB1A  1               sWordRdy:
00CB1A  1  BD 88 C0        lda  ATADataLow,x            ;Read words 0 thru 56 but throw them away
00CB1D  1  C8              iny
00CB1E  1  C0 39           cpy  #57                     ;Number of the last word you want to throw away
00CB20  1  D0 ED           bne  sPrefetchloop
00CB22  1  7A              ply
00CB23  1               
00CB23  1               sPrefetchDone:
00CB23  1  BD 88 C0        lda  ATADataLow,x            ;Read the current capacity in sectors (LBA)
00CB26  1  38              sec
00CB27  1  E9 00           sbc  #BLOCKOFFSET
00CB29  1  99 F8 05        sta  DrvBlkCount0,y
00CB2C  1  BD 80 C0        lda  ATADataHigh,x
00CB2F  1  E9 00           sbc  #0
00CB31  1  99 78 06        sta  DrvBlkCount1,y
00CB34  1  BD 88 C0        lda  ATADataLow,x
00CB37  1  E9 00           sbc  #0
00CB39  1  99 F8 06        sta  DrvBlkCount2,y
00CB3C  1               
00CB3C  1               
00CB3C  1               .IF DEBUG
00CB3C  1                  jsr  DSString
00CB3C  1                  .byte "Size:",0
00CB3C  1               
00CB3C  1                  lda  ATADataHigh,x           ;get the high byte of high word just for display
00CB3C  1                  jsr  DSByte
00CB3C  1                  lda  DrvBlkCount2,y
00CB3C  1                  jsr  DSByte
00CB3C  1                  lda  DrvBlkCount1,y
00CB3C  1                  jsr  DSByte
00CB3C  1                  lda  DrvBlkCount0,y
00CB3C  1                  jsr  DSByte
00CB3C  1                  jsr  DSBlank
00CB3C  1               .ENDIF
00CB3C  1               
00CB3C  1  B9 F8 06        lda  DrvBlkCount2,y
00CB3F  1  C9 04           cmp  #PARTITIONS32MB         ;max out at (#PARTITIONS32MB * $10000 + 00FFFF)
00CB41  1                                               ; blocks
00CB41  1  B0 05           bcs  maxOutAtN
00CB43  1               
00CB43  1  BD 80 C0        lda  ATADataHigh,x
00CB46  1  F0 0D           beq  lessThan8GB
00CB48  1               maxOutAtN:
00CB48  1  A9 FF           lda  #$FF                    ;The device is truly huge! Just set our 3-byte
00CB4A  1                                               ; block count to $03FFFF
00CB4A  1  99 F8 05        sta  DrvBlkCount0,y
00CB4D  1  99 78 06        sta  DrvBlkCount1,y
00CB50  1  A9 03           lda  #PARTITIONS32MB-1       ;Number of 32MB devices, set by the equate:
00CB52  1                                               ; #PARTITIONS32MB
00CB52  1  99 F8 06        sta  DrvBlkCount2,y
00CB55  1               lessThan8GB:
00CB55  1               
00CB55  1               
00CB55  1               PostFetch:
00CB55  1  20 78 CC        jsr IDEWaitReady             ;read the rest of the words, until command ends
00CB58  1  90 05           bcc sReadComplete
00CB5A  1  BD 88 C0        lda ATADataLow,x
00CB5D  1  80 F6           bra PostFetch
00CB5F  1               sReadComplete:
00CB5F  1               
00CB5F  1               ; DrvBlkCount2 is the number of 32 MB partitions availiable - 1,
00CB5F  1               ; or the highest drive # supported (zero based).
00CB5F  1               ;
00CB5F  1               ; If DrvBlkCount2 > drive # then StatusSize = $FFFF
00CB5F  1               ; If DrvBlkCount2 = drive # then StatusSize = DrvBlkCount1,DrvBlkCount0
00CB5F  1               ; If DrvBlkCount2 < drive # then StatusSize = 0
00CB5F  1               ;
00CB5F  1               ; This scheme has a special case which must be handled because ProDOS
00CB5F  1               ;   partitions are not quite 32 meg in size but are only FFFF blocks in size.
00CB5F  1               ;   If a device is exactly: 32meg or 10000h blocks in size, it would appear
00CB5F  1               ;   as one drive of size FFFF and another drive of size 0000. To handle this
00CB5F  1               ;   case, we check for an exact size of 0000 and fall into the NoDrive code.
00CB5F  1               ;
00CB5F  1  B9 F8 04        lda DriveNumber,y
00CB62  1  D9 F8 06        cmp DrvBlkCount2,y
00CB65  1  F0 0B           beq ExactSize
00CB67  1  90 1E           bcc FullSize
00CB69  1               
