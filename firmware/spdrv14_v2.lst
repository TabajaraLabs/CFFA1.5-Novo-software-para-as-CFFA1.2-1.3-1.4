00CDA5  1  B9 87 CE        lda  CfgHdr+7,y
00CDA8  1  9D 8B C0        sta  ATASector,x
00CDAB  1  B9 88 CE        lda  CfgHdr+8,y
00CDAE  1  9D 8C C0        sta  ATACylinder,x
00CDB1  1  B9 89 CE        lda  CfgHdr+9,y
00CDB4  1  9D 8D C0        sta  ATACylinderH,x
00CDB7  1  B9 8A CE        lda  CfgHdr+10,y
00CDBA  1  29 0F           and  #$0F
00CDBC  1  09 E0           ora  #$E0
