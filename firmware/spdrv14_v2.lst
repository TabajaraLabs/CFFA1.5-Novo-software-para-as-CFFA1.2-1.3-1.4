00CC0C  1               ; Block2LBA - Translates ProDOS block# into LBA and programs devices' task file
00CC0C  1               ;             registers.
00CC0C  1               ;
00CC0C  1               ; Input:
00CC0C  1               ;       pd Command Block Data $42 - $47
00CC0C  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CC0C  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CC0C  1               ;
00CC0C  1               ; Ouput:
00CC0C  1               ;       None
00CC0C  1               ;
00CC0C  1               ; ZeroPage Usage:
00CC0C  1               ;       None
00CC0C  1               ;
00CC0C  1               ; CPU Registers changed:  A, P
00CC0C  1               ;
00CC0C  1               ; This function translates the block number sent in the PRODOS request
00CC0C  1               ; packet, into an ATA Logical Block Address (LBA).
00CC0C  1               ; The least significant 16 bits becomes the ProDOS block#.
00CC0C  1               ; The most significant 16 becomes the ProDOS Drive #
00CC0C  1               ;
00CC0C  1               ; A ProDOS block and a ATA sector are both 512 bytes.
00CC0C  1               ;
00CC0C  1               ; Logical Block Mode, the Logical Block Address is interpreted as follows:
00CC0C  1               ; LBA07-LBA00: Sector Number Register D7-D0.
00CC0C  1               ; LBA15-LBA08: Cylinder Low Register D7-D0.
00CC0C  1               ; LBA23-LBA16: Cylinder High Register D7-D0.
00CC0C  1               ; LBA27-LBA24: Drive/Head Register bits HS3-HS0.
00CC0C  1               
00CC0C  1               
00CC0C  1               Block2LBA:
00CC0C  1  20 43 CA        jsr  ResetDriveIfFirstTime   ;v1.4 (o caminho SmartPort nao passa pelo P8AuxROM)
00CC0F  1  B9 78 07        lda  DrvMiscFlags,y          ;unidade 127 (bloco cru) ignora o modo FAT
00CC12  1  30 51           bmi  b2Classic
00CC14  1  B9 78 05        lda  FatFlags,y
00CC17  1  10 4C           bpl  b2Classic
00CC19  1               ; v1.4 - modo FAT: LBA = inicio da imagem + bloco; bloco tem de ser menor que o tamanho da imagem
00CC19  1  5A              phy
00CC1A  1  20 90 CC        jsr  FatDriveOK              ;Y <- d*24
00CC1D  1  B0 3F           bcs  b2Off
00CC1F  1  A5 46           lda  pdBlockNumber
00CC21  1  D9 85 CE        cmp  CfgHdr+5,y
00CC24  1  A5 47           lda  pdBlockNumberH
00CC26  1  F9 86 CE        sbc  CfgHdr+6,y
00CC29  1  B0 2C           bcs  b2Bad                   ;bloco >= tamanho: nunca escrever fora da imagem
00CC2B  1  18              clc
00CC2C  1  A5 46           lda  pdBlockNumber
00CC2E  1  79 81 CE        adc  CfgHdr+1,y
00CC31  1  9D 8B C0        sta  ATASector,x
00CC34  1  A5 47           lda  pdBlockNumberH
00CC36  1  79 82 CE        adc  CfgHdr+2,y
00CC39  1  9D 8C C0        sta  ATACylinder,x
00CC3C  1  A9 00           lda  #0
00CC3E  1  79 83 CE        adc  CfgHdr+3,y
00CC41  1  9D 8D C0        sta  ATACylinderH,x
00CC44  1  A9 00           lda  #0
00CC46  1  79 84 CE        adc  CfgHdr+4,y
00CC49  1  29 0F           and  #$0F
00CC4B  1  09 E0           ora  #$E0
00CC4D  1  9D 8E C0        sta  ATAHead,x
00CC50  1  7A              ply
00CC51  1  A9 01           lda  #1
00CC53  1  9D 8A C0        sta  ATASectorCnt,x
00CC56  1  60              rts
00CC57  1               b2Bad:
00CC57  1  7A              ply
00CC58  1  68              pla                          ;descarta o retorno para Read/WriteBlockCore
00CC59  1  68              pla
00CC5A  1  A9 2D           lda  #PRODOS_BADBLOCK
00CC5C  1  38              sec
00CC5D  1  60              rts
00CC5E  1               b2Off:
00CC5E  1  7A              ply
00CC5F  1  68              pla
00CC60  1  68              pla
00CC61  1  A9 2F           lda  #PRODOS_OFFLINE
00CC63  1  38              sec
00CC64  1  60              rts
00CC65  1               b2Classic:
00CC65  1  A9 E0           lda  #$E0                    ;1, (LBA), 1, (Drive), LBA 27-24, where LBA=1,
00CC67  1                                               ; Drive=0
00CC67  1  9D 8E C0        sta  ATAHead,x               ;Talk to the Master device and use LBA mode.
00CC6A  1                                               ; Remember that this write will seen by both
00CC6A  1                                               ; the master and slave devices.
00CC6A  1               ;
00CC6A  1               ; Add BLOCKOFFSET to the ProDOS block number to offset the first drive block we
00CC6A  1               ; use. This keeps the device's first BLOCKOFFSET blocks free, which usually
00CC6A  1               ; includes a MBR at block 0.
00CC6A  1               ;
00CC6A  1  B9 78 07        lda  DrvMiscFlags,y           ; bit 7 = raw block access
00CC6D  1  29 80           and  #$80
00CC6F  1  49 80           eor  #$80
00CC71  1  F0 02           beq  rawBlocks
00CC73  1  A9 00           lda  #BLOCKOFFSET
00CC75  1               rawBlocks:                      ; A = $00 or BLOCKOFFSET
00CC75  1  18              clc
00CC76  1  65 46           adc  pdBlockNumber
00CC78  1  9D 8B C0        sta  ATASector,x             ;store ProDOS Low block # into LBA 0-7
00CC7B  1               
00CC7B  1  A5 47           lda  pdBlockNumberH
00CC7D  1  69 00           adc  #0                      ;account for any overflow in LBA 0-7
00CC7F  1  9D 8C C0        sta  ATACylinder,x           ;store ProDOS High block # into LBA 15-8
00CC82  1               
00CC82  1  B9 F8 04        lda DriveNumber,y
00CC85  1  69 00           adc #0                        ;account for overflow from LBA 8-15
00CC87  1  9D 8D C0        sta ATACylinderH,x            ;store LBA bits 23-16
00CC8A  1               
00CC8A  1  A9 01           lda #1
00CC8C  1  9D 8A C0        sta ATASectorCnt,x
00CC8F  1  60              rts
