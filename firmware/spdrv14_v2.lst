00C800  1               
00C800  1               ;-------------------- End of Peripheral Card ROM Space ----------------------
00C800  1               
00C800  1               
00C800  1               ;--------------------- Start of I/O expansion ROM Space --------------------
00C800  1               ; Code here starts at $c800
00C800  1               ; This code area is absolute and can use absolute addressing
00C800  1               .ORG   $C800                    ;note: .ORG does not cause this code to be
00C800  1                                               ; placed at C800. The ".RES" statement above
00C800  1                                               ; offsets this code
00C800  1               
00C800  1               
00C800  1               ;------------------------------------------------------------------------------
00C800  1               ; SmartPort
00C800  1               ;
00C800  1               ;------------------------------------------------------------------------------
00C800  1               MagicRawBlocksUnit EQU 127      ;use unit 127 in ReadBlock/WriteBlock calls for
00C800  1                                               ; raw LBA blocks.
00C800  1               
00C800  1               SPAuxROM:
00C800  1               ; save  ZP, fetch cmd + pointer from (PC)
00C800  1  A0 0C           ldy  #spZeroPgSize-1
00C802  1               save:
00C802  1  B9 42 00        lda  spZeroPgArea,y
00C805  1  48              pha
00C806  1  88              dey
00C807  1  10 F9           bpl  save
00C809  1  BA              tsx
00C80A  1  BD 0E 01        lda  $101+spZeroPgSize,x
00C80D  1  85 48           sta  spParamList
00C80F  1  18              clc
00C810  1  69 03           adc  #3
00C812  1  9D 0E 01        sta  $101+spZeroPgSize,x
00C815  1  BD 0F 01        lda  $102+spZeroPgSize,x
00C818  1  85 49           sta  spParamList+1
00C81A  1  69 00           adc  #0
00C81C  1  9D 0F 01        sta  $102+spZeroPgSize,x
00C81F  1               
00C81F  1               ; set up spSlot and spSlotX16
00C81F  1  AD F8 07        lda  mslot
00C822  1  29 0F           and  #$0f
00C824  1  A8              tay
00C825  1  0A              asl  a
00C826  1  0A              asl  a
00C827  1  0A              asl  a
00C828  1  0A              asl  a
00C829  1  AA              tax
00C82A  1  84 4D           sty  spSlot
00C82C  1  86 4E           stx  spSlotX16
00C82E  1               
00C82E  1               ; clear DrvMiscFlags
00C82E  1  A9 00           lda  #0
00C830  1  99 78 07        sta  DrvMiscFlags,y          ;no special flags (such as raw block access)
00C833  1               
00C833  1               ; reset the device if this is our first call
00C833  1  20 43 CA        jsr  ResetDriveIfFirstTime   ;needs Y
00C836  1               
00C836  1               .IF DEBUG
00C836  1               ;warning this debug code trashes the Acc register
00C836  1                  jsr  DSString
00C836  1                  .byte "SP:",0
00C836  1               .ENDIF
00C836  1               
00C836  1               ; get command code from parameter list
00C836  1  A0 01           ldy  #1
00C838  1  B1 48           lda  (spParamList),y
00C83A  1  85 42           sta  spCommandCode
00C83C  1  C8              iny
00C83D  1  B1 48           lda  (spParamList),y
00C83F  1  AA              tax
00C840  1  C8              iny
00C841  1  B1 48           lda  (spParamList),y
00C843  1  85 49           sta  spParamList+1
00C845  1  86 48           stx  spParamList
00C847  1               
00C847  1  A9 01           lda  #PRODOS_BADCMD          ;anticipate bad command error
00C849  1  A6 42           ldx  spCommandCode
00C84B  1  E0 0A           cpx  #$09+1                  ;command too large
00C84D  1  B0 1E           bcs  out
00C84F  1               
00C84F  1  B2 48           lda  (spParamList)           ;parameter count
00C851  1  DD 8A C8        cmp  RequiredParamCounts,x   ;command number still in X
00C854  1  F0 04           beq  pCountOK
00C856  1               
00C856  1  A9 04           lda  #$04                    ;bad parameter count error
00C858  1  80 13           bra  out
00C85A  1               
00C85A  1               pCountOK:
00C85A  1  A0 01           ldy  #1
00C85C  1  B1 48           lda  (spParamList),y
00C85E  1  A4 4D           ldy  spSlot
00C860  1  99 F8 04        sta  DriveNumber,y
00C863  1               
00C863  1  8A              txa                            ;X is still the command code
00C864  1  0A              asl  a
00C865  1  AA              tax
00C866  1  20 81 C8        jsr  JumpToSPCommand           ;Y is still spSlot
00C869  1               
00C869  1  B0 02           bcs  out
00C86B  1  A9 00           lda  #0
00C86D  1               
00C86D  1               out:
00C86D  1  AA              tax                           ;error code in X
00C86E  1               
00C86E  1               ; Restore zero page
00C86E  1  A0 00           ldy  #0
00C870  1               restore:
00C870  1  68              pla
00C871  1  99 42 00        sta  spZeroPgArea,y
00C874  1  C8              iny
00C875  1  C0 0D           cpy  #spZeroPgSize
00C877  1  90 F7           bcc  restore
00C879  1               
00C879  1  8A              txa
00C87A  1  A0 02           ldy  #2                      ;high byte of # bytes transferred
00C87C  1                                               ; (always (1) undefined, or
00C87C  1                                               ; (2) #bytes transferred to host)
00C87C  1  A2 00           ldx  #0                      ;low byte of # bytes transferred
00C87E  1  C9 01           cmp  #1                      ;C=1 if error code nonzero
00C880  1  60              rts
00C881  1               
00C881  1               JumpToSPCommand:
00C881  1  BD 95 C8        lda  spDispatch+1,x
00C884  1  48              pha
00C885  1  BD 94 C8        lda  spDispatch,x
00C888  1  48              pha
00C889  1  60              rts
00C88A  1               
00C88A  1               RequiredParamCounts:
00C88A  1  03              .byte 3   ;0 = status
00C88B  1  03              .byte 3   ;1 = read
00C88C  1  03              .byte 3   ;2 = write
00C88D  1  01              .byte 1   ;3 = format
00C88E  1  03              .byte 3   ;4 = control
00C88F  1  01              .byte 1   ;5 = init
00C890  1  01              .byte 1   ;6 = open
00C891  1  01              .byte 1   ;7 = close
00C892  1  04              .byte 4   ;8 = read
00C893  1  04              .byte 4   ;9 = write
00C894  1               
00C894  1               spDispatch:
00C894  1  A7 C8           .word spStatus-1
00C896  1  48 C9           .word spReadBlock-1
00C898  1  55 C9           .word spWriteBlock-1
00C89A  1  61 C9           .word spFormat-1
00C89C  1  64 C9           .word spControl-1
00C89E  1  88 C9           .word spInit-1
00C8A0  1  93 C9           .word spOpen-1
00C8A2  1  93 C9           .word spClose-1
00C8A4  1  97 C9           .word spReadChars-1
00C8A6  1  97 C9           .word spWriteChars-1
00C8A8  1               
00C8A8  1               ;------------------------------------------------------------------------------
00C8A8  1               ; SmartPort STATUS call
00C8A8  1               ;
00C8A8  1               ; We support the standard calls, plus an "Identify" command
00C8A8  1               ; for unit 0, which fills a buffer with the card's Identify
00C8A8  1               ; data.
00C8A8  1               ;
00C8A8  1               spStatus:
00C8A8  1  20 9C C9        jsr  SPSetupControlOrStatus
00C8AB  1  B0 33           bcs  statOut
00C8AD  1               
00C8AD  1  A4 4D           ldy  spSlot
00C8AF  1  B9 F8 04        lda  DriveNumber,y
00C8B2  1  D0 34           bne  StatusForOneUnit
00C8B4  1               
00C8B4  1               ; StatusCode = 0 && unit == 0: status for this entire SmartPort interface
00C8B4  1  A5 4C           lda  spCSCode
00C8B6  1  F0 04           beq  Status00
00C8B8  1               
00C8B8  1               ; v1.4: o subcodigo $49 (Identify) foi retirado para dar lugar ao modo FAT (111 bytes).
00C8B8  1               
00C8B8  1               ; Any other status code for unit 0 is an error.
00C8B8  1               BadStatusCode:
00C8B8  1  A9 21           lda  #$21
00C8BA  1  38              sec
00C8BB  1  60              rts
00C8BC  1               
00C8BC  1               Status00:
00C8BC  1  A6 4E           ldx  spSlotX16
00C8BE  1  A4 4D           ldy  spSlot
00C8C0  1  20 43 CA        jsr  ResetDriveIfFirstTime   ;v1.4
00C8C3  1  B9 78 05        lda  FatFlags,y
00C8C6  1  30 05           bmi  s00fat                  ;v1.4: modo FAT -> 4 drives (DrvBlkCount2 = 3)
00C8C8  1  20 79 CA        jsr  GetStatus
00C8CB  1  B0 13           bcs  statOut
00C8CD  1               s00fat:
00C8CD  1               
00C8CD  1  A4 4D           ldy  spSlot
00C8CF  1  B9 F8 06        lda  DrvBlkCount2,y
00C8D2  1  1A              inc  a
00C8D3  1  92 4A           sta  (spCmdList)        ;byte +0 = number of drives
00C8D5  1               
00C8D5  1  A0 07           ldy  #7
00C8D7  1               Stat00Loop:
00C8D7  1  B9 E0 C8        lda  Stat00Data-1,y
00C8DA  1  91 4A           sta  (spCmdList),y
00C8DC  1  88              dey
00C8DD  1  D0 F8           bne  Stat00Loop
00C8DF  1  18              clc
00C8E0  1               statOut:
00C8E0  1  60              rts
00C8E1  1               
00C8E1  1               Stat00Data:
00C8E1  1  40              .byte $40                    ;Interrupt flag = no interrupts caused by this
00C8E2  1                                               ; interface
00C8E2  1               
00C8E2  1  00 CC           .word $CC00                  ;Vendor ID assigned to Rich Dreher by
00C8E4  1                                               ; www.syndicomm.com 3/16/2002
00C8E4  1               
00C8E4  1  00 12           .word SPDRIVERVERSION        ;Our version number
00C8E6  1  00              .byte $00                    ;Reserved byte
00C8E7  1  00              .byte $00                    ;Reserved byte
00C8E8  1               
00C8E8  1               StatusForOneUnit:
00C8E8  1  3A              dec  a
00C8E9  1  99 F8 04        sta  DriveNumber,y
00C8EC  1               
00C8EC  1  A6 4C           ldx  spCSCode
00C8EE  1  F0 16           beq  Status0or3
00C8F0  1  CA              dex
00C8F1  1  F0 08           beq  StatusGetDCB
00C8F3  1  CA              dex
00C8F4  1  CA              dex
00C8F5  1  F0 0F           beq  Status0or3
00C8F7  1  A9 21           lda  #$21                    ;Bad status code
00C8F9  1  38              sec
00C8FA  1  60              rts
00C8FB  1               ;
00C8FB  1               ; We have no interesting data to return for the device control
00C8FB  1               ; block, so return the shortest one allowed: a length byte of
00C8FB  1               ; 1 followed by a data byte of 0.
00C8FB  1               ;
00C8FB  1               StatusGetDCB:
00C8FB  1  A9 01           lda  #1
00C8FD  1  92 4A           sta  (spCmdList)             ;Returned length = 1
00C8FF  1  A8              tay
00C900  1  A9 00           lda  #0
00C902  1  91 4A           sta  (spCmdList),y           ;Returned data = $00
00C904  1  18              clc
00C905  1  60              rts
00C906  1               
00C906  1               ;
00C906  1               ; Status code 0 and 3 start off the same; 3 returns extra data.
00C906  1               ;
00C906  1               ; 0: return device status (1 byte device status + 3-byte block count)
00C906  1               ; 3: return Device Information Block
00C906  1               ;
00C906  1               Status0or3:
00C906  1  A9 F8           lda  #$F8                    ;Block device, write, read, format, online,
00C908  1                                               ; not write-prot
00C908  1  92 4A           sta  (spCmdList)
00C90A  1  A6 4E           ldx  spSlotX16
00C90C  1  A4 4D           ldy  spSlot
00C90E  1  20 79 CA        jsr  GetStatus               ;Returns block count in YX
00C911  1  B0 CD           bcs  statOut
00C913  1               
00C913  1  98              tya
00C914  1  A0 02           ldy  #2
00C916  1  91 4A           sta  (spCmdList),y           ;CmdList +2 = bits 8..15 of block count
00C918  1  88              dey
00C919  1  8A              txa                          ;CmdList +1 = bits 0..7 of block count
00C91A  1  91 4A           sta  (spCmdList),y
00C91C  1  A0 03           ldy  #3
00C91E  1  A9 00           lda  #0
00C920  1  91 4A           sta  (spCmdList),y           ;CmdList +3 = bits 16..23 of block count
00C922  1               
00C922  1  A5 4C           lda  spCSCode
00C924  1  F0 0C           beq  statDone
00C926  1               
00C926  1               ; status code 3: return 21 more bytes of data
00C926  1  A0 04           ldy #4
00C928  1               stat3Loop:
00C928  1  B9 30 C9        lda  stat3Data-4,y
00C92B  1  91 4A           sta  (spCmdList),y
00C92D  1  C8              iny
00C92E  1  C0 19           cpy  #21+4
00C930  1  90 F6           bcc  stat3Loop
00C932  1               
00C932  1               statDone:
00C932  1  18              clc
00C933  1  60              rts
00C934  1               
00C934  1               stat3Data:
00C934  1  0D 43 4F 4D     .byte 13,"COMPACT FLASH   "  ;length byte + 16-byte ASCII, padded
00C938  1  50 41 43 54  
00C93C  1  20 46 4C 41  
00C945  1  02              .byte $02                    ;device type = hard disk
00C946  1  20              .byte $20                    ;subtype (no removable media, no extended,
00C947  1                                               ; no disk switched)
00C947  1  00 12           .word SPDRIVERVERSION
00C949  1               
00C949  1               ;------------------------------------------------------------------------------
00C949  1               ; Identify (Status subcode)
00C949  1               ;
00C949  1               ; The status list is a 512-byte buffer that we will fill with
00C949  1               ; the drive's IDE "Identify" data.  We post-process the data
00C949  1               ; by byte-swapping the model name and serial number strings
00C949  1               ; so they make sense.
00C949  1               ;
00C949  1               ; v1.4: spStatusIdentify e SwapBytes retirados (ver acima).
00C949  1               
00C949  1               ;------------------------------------------------------------------------------
00C949  1               ; SmartPort READ BLOCK command
00C949  1               ;
00C949  1               spReadBlock:
00C949  1  20 AE C9        jsr  SPSetupReadWrite
00C94C  1  B0 07           bcs  readDone
00C94E  1               
00C94E  1  A4 4D           ldy  spSlot
00C950  1  A6 4E           ldx  spSlotX16
00C952  1  4C 4E CB        jmp  ReadBlock
00C955  1               
00C955  1               readDone:
00C955  1               writeDone:
00C955  1  60              rts
00C956  1               
00C956  1               ;------------------------------------------------------------------------------
00C956  1               ; SmartPort WRITE BLOCK command
00C956  1               ;
00C956  1               spWriteBlock:
00C956  1  20 AE C9        jsr SPSetupReadWrite
00C959  1  B0 FA           bcs writeDone
00C95B  1               
00C95B  1  A4 4D           ldy spSlot
00C95D  1  A6 4E           ldx spSlotX16
00C95F  1  4C A9 CB        jmp WriteBlock
00C962  1               
00C962  1               ;------------------------------------------------------------------------------
00C962  1               ; SmartPort FORMAT command
00C962  1               ;
00C962  1               ; We don't actually do anything beyond validating the unit number.
00C962  1               ;
00C962  1               spFormat:
00C962  1  4C F7 C9        jmp SPValidateUnitNumber
00C965  1               
00C965  1               ;------------------------------------------------------------------------------
00C965  1               ; SmartPort CONTROL command
00C965  1               ;
00C965  1               spControl:
00C965  1  20 9C C9        jsr SPSetupControlOrStatus
00C968  1  B0 18           bcs ctrlDone
00C96A  1               
00C96A  1  20 F7 C9        jsr SPValidateUnitNumber
00C96D  1  B0 13           bcs ctrlDone
00C96F  1               
00C96F  1  A6 4C           ldx spCSCode
00C971  1  F0 14           beq ctlReset                 ;Control code 0 = Reset
00C973  1  CA              dex
00C974  1  F0 11           beq ctlSetDCB                ;Control code 1 = SetDCB
00C976  1  CA              dex
00C977  1  F0 06           beq ctlSetNewline            ;Control code 2 = SetNewline
00C979  1  CA              dex
00C97A  1  F0 07           beq ctlServiceInterrupt      ;Control code 3 = ServiceInterrupt
00C97C  1  CA              dex
00C97D  1  F0 08           beq ctlEject                 ;Control code 4 = Eject
00C97F  1               
00C97F  1               ctlSetNewline:
00C97F  1  A9 21           lda #$21                     ;Bad control code
00C981  1  38              sec
00C982  1               ctrlDone:
00C982  1  60              rts
