00C989  1               ;------------------------------------------------------------------------------
00C989  1               ; SmartPort INIT command
00C989  1               ;
00C989  1               ; unit 0 = entire chain
00C989  1               ;
00C989  1               ;  SmartPort Technote #2 says you can't init an individual unit;
00C989  1               ;  so return error if DriveNumber is nonzero.
00C989  1               ;
00C989  1               spInit:
00C989  1  B9 F8 04        lda DriveNumber,y
00C98C  1  F0 04           beq initChain
00C98E  1  A9 11           lda #BAD_UNIT_NUMBER
00C990  1  38              sec
00C991  1  60              rts
00C992  1               
00C992  1               initChain:
00C992  1  18              clc
00C993  1  60              rts
00C994  1               
00C994  1               
00C994  1               ;------------------------------------------------------------------------------
00C994  1               ; SmartPort: Open and Close are for character devices only
00C994  1               ;
00C994  1               spOpen:
00C994  1               spClose:
00C994  1  A9 01           lda #PRODOS_BADCMD
00C996  1  38              sec
00C997  1  60              rts
00C998  1               
00C998  1               ;------------------------------------------------------------------------------
00C998  1               ; SmartPort: Read, Write
00C998  1               ;
00C998  1               ; We don't bother implementing Read and Write, although they are allowed
00C998  1               ; for block devices.  We would only support 512-byte transfers anyway.
00C998  1               ;
00C998  1               spReadChars:
00C998  1               spWriteChars:
00C998  1  A9 27           lda #PRODOS_IO_ERROR
00C99A  1  38              sec
00C99B  1  60              rts
