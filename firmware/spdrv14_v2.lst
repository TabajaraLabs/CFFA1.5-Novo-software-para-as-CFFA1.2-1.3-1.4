00C99C  1               
00C99C  1               ;------------------------------------------------------------------------------
00C99C  1               ; SPSetupControlOrStatus
00C99C  1               ;
00C99C  1               ; fetch from parameter block:
00C99C  1               ;    status/control list pointer (word)
00C99C  1               ;    status/control code (byte)
00C99C  1               ;
00C99C  1               SPSetupControlOrStatus:
00C99C  1  A0 02           ldy #2
00C99E  1  B1 48           lda (spParamList),y
00C9A0  1  85 4A           sta spCmdList
00C9A2  1  C8              iny
00C9A3  1  B1 48           lda (spParamList),y
00C9A5  1  85 4B           sta spCmdList+1
00C9A7  1  C8              iny
00C9A8  1  B1 48           lda (spParamList),y
00C9AA  1  85 4C           sta spCSCode
00C9AC  1  18              clc
00C9AD  1  60              rts
00C9AE  1               
00C9AE  1               ;------------------------------------------------------------------------------
00C9AE  1               ; SPSetupReadWrite
00C9AE  1               ;
00C9AE  1               ; Input:
00C9AE  1               ;    DriveNumber,y is already a copy of SmartPort unit number
00C9AE  1               ;
00C9AE  1               ; fetch from SP parameter list:
00C9AE  1               ;   buffer pointer
00C9AE  1               ;   block number
00C9AE  1               ;
00C9AE  1               ; Validate unit number:
00C9AE  1               ;   127 = magic, allow any block number
00C9AE  1               ;   1..N:  Validate block number: $0..FFFE
00C9AE  1               ;
00C9AE  1               ; DriveNumber,y: translated unit number in case unit was magic
00C9AE  1               ; DrvMiscFlags: bit 7 set if we should not use BLOCKOFFSET
00C9AE  1               ;
00C9AE  1               SPSetupReadWrite:
00C9AE  1               ; copy pdIOBuffer from parameter list
00C9AE  1  A0 02           ldy #2
00C9B0  1  B1 48           lda (spParamList),y
00C9B2  1  85 44           sta pdIOBuffer
00C9B4  1  C8              iny
00C9B5  1  B1 48           lda (spParamList),y
00C9B7  1  85 45           sta pdIOBuffer+1
00C9B9  1               
00C9B9  1               ; copy pdBlockNumber from parameter list
00C9B9  1  C8              iny
00C9BA  1  B1 48           lda (spParamList),y
00C9BC  1  85 46           sta pdBlockNumber
00C9BE  1  C8              iny
00C9BF  1  B1 48           lda (spParamList),y
00C9C1  1  85 47           sta pdBlockNumber+1
00C9C3  1               
00C9C3  1               ; Validate the unit number and block number.
00C9C3  1  A4 4D           ldy spSlot
00C9C5  1  B9 F8 04        lda DriveNumber,y
00C9C8  1  C9 7F           cmp #MagicRawBlocksUnit
00C9CA  1  F0 18           beq magicUnit
00C9CC  1               
00C9CC  1  20 F7 C9        jsr SPValidateUnitNumber
00C9CF  1  B0 12           bcs srwOut
00C9D1  1               
00C9D1  1  A0 06           ldy #6
00C9D3  1  B1 48           lda (spParamList),y          ;Bits 16..23 of block number must be $00
00C9D5  1  D0 09           bne badBlockNum
00C9D7  1               
00C9D7  1  A5 47           lda pdBlockNumber+1          ;Block $FFFF is invalid
00C9D9  1  25 46           and pdBlockNumber
00C9DB  1  1A              inc a
00C9DC  1  F0 02           beq badBlockNum
00C9DE  1  18              clc
00C9DF  1  60              rts
00C9E0  1               
00C9E0  1               badBlockNum:
00C9E0  1  A9 2D           lda #PRODOS_BADBLOCK         ;Bad block number
00C9E2  1  38              sec
00C9E3  1               srwOut:
00C9E3  1  60              rts
00C9E4  1               ;
00C9E4  1               ; For the "magic raw blocks" unit, allow a full 3-byte block number.
00C9E4  1               ;
00C9E4  1               magicUnit:
00C9E4  1  A9 80           lda #$80
00C9E6  1  19 78 07        ora DrvMiscFlags,y
00C9E9  1  99 78 07        sta DrvMiscFlags,y           ;Raw block access
00C9EC  1               
00C9EC  1  A0 06           ldy #6
00C9EE  1  B1 48           lda (spParamList),y          ;Bits 16..23 of block number
00C9F0  1  A4 4D           ldy spSlot
00C9F2  1  99 F8 04        sta DriveNumber,y
00C9F5  1  18              clc
00C9F6  1  60              rts
00C9F7  1               
00C9F7  1               ;------------------------------------------------------------------------------
00C9F7  1               ; SPValidateUnitNumber
00C9F7  1               ;
00C9F7  1               ; Validate that DriveNumber is from 1 to N.
00C9F7  1               ;
00C9F7  1               ; Input: DriveNumber
00C9F7  1               ;
00C9F7  1               ; Output: DriveNumber in range 0..N-1
00C9F7  1               ;
00C9F7  1               SPValidateUnitNumber:
00C9F7  1  A4 4D           ldy spSlot
00C9F9  1  B9 F8 04        lda DriveNumber,y
00C9FC  1  F0 0D           beq badUnit
00C9FE  1  3A              dec a
00C9FF  1  99 F8 04        sta DriveNumber,y
00CA02  1  D9 F8 06        cmp DrvBlkCount2,y
00CA05  1  F0 02           beq unitOK
00CA07  1  B0 02           bcs badUnit
00CA09  1               unitOK:
00CA09  1  18              clc
00CA0A  1  60              rts
00CA0B  1               
00CA0B  1               badUnit:
00CA0B  1  A9 11           lda #BAD_UNIT_NUMBER
00CA0D  1  38              sec
00CA0E  1  60              rts
00CA0F  1               
00CA0F  1               ;------------------------------------------------------------------------------
00CA0F  1               ; P8AuxROM - Handle a ProDOS call
00CA0F  1               ;
00CA0F  1               P8AuxROM:
00CA0F  1               
00CA0F  1               ; If the ProDOS unit number doesn't match our slot number, add 2 to
00CA0F  1               ; the drive number.
00CA0F  1               ;
00CA0F  1               ; This actually happens: If we're in slot 5, we get calls for slot 2
00CA0F  1               ; that want to access our 3rd and 4th partitions.
00CA0F  1  8A              txa                          ; A = $n0
00CA10  1  45 43           eor  pdUnitNumber
00CA12  1  29 70           and  #$70                    ;EOR the slot number
00CA14  1  F0 02           beq  OurSlot
00CA16  1  A9 02           lda  #2                      ;Point to drive 3 or 4
00CA18  1               
00CA18  1               OurSlot:
00CA18  1  24 43           bit  pdUnitNumber
00CA1A  1  10 01           bpl  DriveOne
00CA1C  1  1A              inc  a
00CA1D  1               
00CA1D  1               DriveOne:
00CA1D  1  99 F8 04        sta  DriveNumber,y
00CA20  1  A9 00           lda  #0
00CA22  1  99 78 07        sta  DrvMiscFlags,y          ;no special flags (such as raw block access)
00CA25  1               
00CA25  1  20 43 CA        jsr  ResetDriveIfFirstTime
00CA28  1               
00CA28  1               ; process the command code and jump to appropriate routine.
00CA28  1               
00CA28  1               .IF DEBUG
00CA28  1               ;warning this debug code trashes the Acc register
00CA28  1                  jsr  DSString
00CA28  1                  .byte "P8:",0
00CA28  1               .ENDIF
00CA28  1               
00CA28  1  A5 42           lda  pdCommandCode
00CA2A  1  C9 01           cmp  #PRODOS_READ
00CA2C  1  D0 03           bne  chk1
00CA2E  1  4C 4E CB        jmp  ReadBlock
00CA31  1               
00CA31  1               chk1:
00CA31  1  C9 02           cmp  #PRODOS_WRITE
00CA33  1  D0 03           bne  chk2
00CA35  1  4C A9 CB        jmp  WriteBlock
00CA38  1               
00CA38  1               chk2:
00CA38  1  C9 00           cmp  #PRODOS_STATUS
00CA3A  1  D0 03           bne  chk3
00CA3C  1  4C 79 CA        jmp  GetStatus
00CA3F  1               
00CA3F  1               chk3:
00CA3F  1               ; An invalid request # has been sent to this driver.
00CA3F  1               ;
00CA3F  1               .IF DEBUG
00CA3F  1                  pha
00CA3F  1                  jsr DSString
00CA3F  1                  .byte "CE",0
00CA3F  1                  pla
00CA3F  1                  jsr  DSByteCRLF
00CA3F  1               .ENDIF
00CA3F  1               
00CA3F  1  A9 27           lda  #PRODOS_IO_ERROR
00CA41  1  38              sec
00CA42  1  60              rts                             ;return to caller. Should always be ProDOS
00CA43  1               
00CA43  1               ;------------------------------------------------------------------------------
00CA43  1               ; ResetDriveIfFirstTime - Reset the drive once, the first time the driver
00CA43  1               ; is called ide_devctrl Bit 2 = Software Reset, Bit 1 = nIEN (enable
00CA43  1               ; assertion of INTRQ)
00CA43  1               ;
00CA43  1               ; Input:
00CA43  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CA43  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CA43  1               ;
00CA43  1               ; ZeroPage Usage:
00CA43  1               ;       None
00CA43  1               ;
00CA43  1               ; CPU Registers changed:  A, P
00CA43  1               ;
00CA43  1               ResetDriveIfFirstTime:
00CA43  1  B9 78 04        lda  DriveResetDone,Y
00CA46  1  C9 A4           cmp  #INITDONESIG
00CA48  1  D0 0A           bne  rdDo
00CA4A  1  B9 78 05        lda  FatFlags,y              ;v1.4: FatFlags so vale se a conferencia bater
00CA4D  1  49 5A           eor  #$5A
00CA4F  1  D9 F8 07        cmp  FatChk,y
00CA52  1  F0 24           beq  resetOK
00CA54  1               rdDo:
00CA54  1               ;
00CA54  1               ; Reset the ATA device
00CA54  1               ;
00CA54  1  A9 00           lda  #0
00CA56  1  9D 80 C0        sta  ATADataHigh,x           ;Clear high byte data latch
00CA59  1               
00CA59  1  A9 06           lda  #$06                    ;Reset bit=1, Disable INTRQ=1
00CA5B  1  9D 86 C0        sta  ATADevCtrl,x
00CA5E  1               ;
00CA5E  1               ; Per ATA-6 spec, need to wait 5us minimum. Use a delay of 100us.
00CA5E  1               ; Should cover accelerated Apples up to 20Mhz.
00CA5E  1               ;
00CA5E  1  A9 04           lda  #WAIT_100us
00CA60  1  20 6F CE        jsr  Wait
00CA63  1               
00CA63  1  A9 02           lda  #$02                    ;Reset bit=0, Disable INTRQ=1
00CA65  1  9D 86 C0        sta  ATADevCtrl,x
00CA68  1               ;
00CA68  1               ; Per ATA-6 spec, need to wait 2ms minimum. Use a delay of 40ms.
00CA68  1               ; Should cover accelerated Apples up to 20Mhz.
00CA68  1               ;
00CA68  1  A9 7C           lda  #WAIT_40ms
00CA6A  1  20 6F CE        jsr  Wait
00CA6D  1               ;
00CA6D  1               ; Per ATA-6 spec, wait for busy to clear, by calling IDEWaitReady
00CA6D  1               ;
00CA6D  1  20 41 CE        jsr  IDEWaitReady
00CA70  1               
00CA70  1  A9 A4           lda  #INITDONESIG
00CA72  1  99 78 04        sta  DriveResetDone,Y        ;Set the init done flag so init only happens
00CA75  1                                               ; once.
00CA75  1  4C BB CC        jmp  FatInit                 ;v1.4: detecta cartao FAT e confere as montagens
00CA78  1               resetOK:
00CA78  1  60              rts
00CA79  1               
00CA79  1               ;------------------------------------------------------------------------------
00CA79  1               ; GetStatus - Called by ProDOS and SmartPort to get device status and size
00CA79  1               ;
00CA79  1               ; Input:
00CA79  1               ;       DriveNumber,y (0 to 3)
00CA79  1               ;       X = slot number in form $n0 where n = slot 1 to 7
00CA79  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CA79  1               ;
00CA79  1               ; Output:
00CA79  1               ;       A = ProDOS status return code
00CA79  1               ;       X = drive size LSB
00CA79  1               ;       Y = drive size MSB
00CA79  1               ;       Carry flag: 0 = Okay, 1 = Error
00CA79  1               ;       DrvBlkCount0..DrvBlkCount2 = usable blocks on device
00CA79  1               ;
00CA79  1               GetStatus:
00CA79  1               
00CA79  1               .IF DEBUG
00CA79  1               ;warning this debug code trashes the Acc register
00CA79  1                  jsr  DSString
00CA79  1                  .byte " St",0
00CA79  1                  jsr  DisplayParms
00CA79  1               .ENDIF
00CA79  1  20 43 CA        jsr  ResetDriveIfFirstTime   ;v1.4
00CA7C  1  B9 78 05        lda  FatFlags,y
00CA7F  1  10 18           bpl  gsClassic
00CA81  1  20 90 CC        jsr  FatDriveOK              ;v1.4: Y <- deslocamento na tabela (d*24), C=1 se nao montado
00CA84  1  B0 0B           bcs  gsOff
00CA86  1  BE 85 CE        ldx  CfgHdr+5,y              ;tamanho da imagem em blocos
00CA89  1  B9 86 CE        lda  CfgHdr+6,y
00CA8C  1  A8              tay
00CA8D  1  A9 00           lda  #0
00CA8F  1  18              clc
00CA90  1  60              rts
00CA91  1               gsOff:
00CA91  1  A2 00           ldx  #0
00CA93  1  A0 00           ldy  #0
00CA95  1  A9 2F           lda  #PRODOS_OFFLINE
00CA97  1  38              sec
00CA98  1  60              rts
00CA99  1               gsClassic:
00CA99  1               
00CA99  1               ;
00CA99  1               ; Determine if a drive/device is present.
00CA99  1               ;
00CA99  1  20 4B CE        jsr  CheckDevice
00CA9C  1  90 0A           bcc  sDriveOK
00CA9E  1               
00CA9E  1  A2 00           ldx  #$00
00CAA0  1  A0 00           ldy  #$00
00CAA2  1  A9 2F           lda  #PRODOS_OFFLINE
00CAA4  1  38              sec
00CAA5  1  4C 4D CB        jmp  sExit
00CAA8  1               
00CAA8  1               ; Device is present
00CAA8  1               sDriveOK:
00CAA8  1  A9 00           lda  #0
00CAAA  1  9D 80 C0        sta  ATADataHigh,x           ;clear high byte transfer latch
00CAAD  1               
00CAAD  1  20 41 CE        jsr  IDEWaitReady
00CAB0  1  A9 EC           lda  #ATAIdentify
00CAB2  1  9D 8F C0        sta  ATACommand,x            ;Issue the read command to the drive
00CAB5  1  20 41 CE        jsr  IDEWaitReady            ;Wait for BUSY flag to go away
00CAB8  1               
00CAB8  1  BD 8F C0        lda  ATAStatus,x             ;Check for error response
00CABB  1  29 09           and  #$09
00CABD  1  C9 01           cmp  #$01                     ;if DRQ=0 and ERR=1 an error occured
00CABF  1  D0 0A           bne  sValidATACommand
00CAC1  1               
00CAC1  1               .IF DEBUG
00CAC1  1               ;warning this debug code trashes the Acc register
00CAC1  1                  jsr DSString
00CAC1  1                  .byte " Idfy Err:",0
00CAC1  1                  lda  ATAError,x
00CAC1  1                  jsr  DSByteCRLF
00CAC1  1               .ENDIF
00CAC1  1               
00CAC1  1  A2 00           ldx  #0
00CAC3  1  A0 00           ldy  #0
00CAC5  1  A9 27           lda  #PRODOS_IO_ERROR
00CAC7  1  38              sec
00CAC8  1  4C 4D CB        jmp  sExit                   ; Command Error occured, return error
00CACB  1               
00CACB  1               sValidATACommand:
00CACB  1  5A              phy                          ;save Y, it holds the $0n sratchpad RAM offset
00CACC  1  A0 00           ldy  #$00                    ;zero loop counter
00CACE  1               
00CACE  1               sPrefetchloop:
00CACE  1  20 41 CE        jsr  IDEWaitReady            ;See if a word is ready
00CAD1  1  B0 06           bcs  sWordRdy
00CAD3  1  7A              ply
00CAD4  1  A9 27           lda  #PRODOS_IO_ERROR
00CAD6  1  4C 4D CB        jmp  sExit
00CAD9  1               
00CAD9  1               sWordRdy:
00CAD9  1  BD 88 C0        lda  ATADataLow,x            ;Read words 0 thru 56 but throw them away
00CADC  1  C8              iny
00CADD  1  C0 39           cpy  #57                     ;Number of the last word you want to throw away
00CADF  1  D0 ED           bne  sPrefetchloop
00CAE1  1  7A              ply
00CAE2  1               
00CAE2  1               sPrefetchDone:
00CAE2  1  BD 88 C0        lda  ATADataLow,x            ;Read the current capacity in sectors (LBA)
00CAE5  1  38              sec
00CAE6  1  E9 00           sbc  #BLOCKOFFSET
00CAE8  1  99 F8 05        sta  DrvBlkCount0,y
00CAEB  1  BD 80 C0        lda  ATADataHigh,x
00CAEE  1  E9 00           sbc  #0
00CAF0  1  99 78 06        sta  DrvBlkCount1,y
00CAF3  1  BD 88 C0        lda  ATADataLow,x
00CAF6  1  E9 00           sbc  #0
00CAF8  1  99 F8 06        sta  DrvBlkCount2,y
00CAFB  1               
00CAFB  1               
00CAFB  1               .IF DEBUG
00CAFB  1                  jsr  DSString
00CAFB  1                  .byte "Size:",0
00CAFB  1               
00CAFB  1                  lda  ATADataHigh,x           ;get the high byte of high word just for display
00CAFB  1                  jsr  DSByte
00CAFB  1                  lda  DrvBlkCount2,y
00CAFB  1                  jsr  DSByte
00CAFB  1                  lda  DrvBlkCount1,y
00CAFB  1                  jsr  DSByte
00CAFB  1                  lda  DrvBlkCount0,y
00CAFB  1                  jsr  DSByte
00CAFB  1                  jsr  DSBlank
00CAFB  1               .ENDIF
00CAFB  1               
00CAFB  1  B9 F8 06        lda  DrvBlkCount2,y
00CAFE  1  C9 04           cmp  #PARTITIONS32MB         ;max out at (#PARTITIONS32MB * $10000 + 00FFFF)
00CB00  1                                               ; blocks
00CB00  1  B0 05           bcs  maxOutAtN
00CB02  1               
00CB02  1  BD 80 C0        lda  ATADataHigh,x
00CB05  1  F0 0D           beq  lessThan8GB
00CB07  1               maxOutAtN:
00CB07  1  A9 FF           lda  #$FF                    ;The device is truly huge! Just set our 3-byte
00CB09  1                                               ; block count to $03FFFF
00CB09  1  99 F8 05        sta  DrvBlkCount0,y
00CB0C  1  99 78 06        sta  DrvBlkCount1,y
00CB0F  1  A9 03           lda  #PARTITIONS32MB-1       ;Number of 32MB devices, set by the equate:
00CB11  1                                               ; #PARTITIONS32MB
00CB11  1  99 F8 06        sta  DrvBlkCount2,y
00CB14  1               lessThan8GB:
00CB14  1               
00CB14  1               
00CB14  1               PostFetch:
00CB14  1  20 41 CE        jsr IDEWaitReady             ;read the rest of the words, until command ends
00CB17  1  90 05           bcc sReadComplete
00CB19  1  BD 88 C0        lda ATADataLow,x
00CB1C  1  80 F6           bra PostFetch
00CB1E  1               sReadComplete:
00CB1E  1               
00CB1E  1               ; DrvBlkCount2 is the number of 32 MB partitions availiable - 1,
00CB1E  1               ; or the highest drive # supported (zero based).
00CB1E  1               ;
00CB1E  1               ; If DrvBlkCount2 > drive # then StatusSize = $FFFF
00CB1E  1               ; If DrvBlkCount2 = drive # then StatusSize = DrvBlkCount1,DrvBlkCount0
00CB1E  1               ; If DrvBlkCount2 < drive # then StatusSize = 0
00CB1E  1               ;
00CB1E  1               ; This scheme has a special case which must be handled because ProDOS
00CB1E  1               ;   partitions are not quite 32 meg in size but are only FFFF blocks in size.
00CB1E  1               ;   If a device is exactly: 32meg or 10000h blocks in size, it would appear
00CB1E  1               ;   as one drive of size FFFF and another drive of size 0000. To handle this
00CB1E  1               ;   case, we check for an exact size of 0000 and fall into the NoDrive code.
00CB1E  1               ;
00CB1E  1  B9 F8 04        lda DriveNumber,y
00CB21  1  D9 F8 06        cmp DrvBlkCount2,y
00CB24  1  F0 0B           beq ExactSize
00CB26  1  90 1E           bcc FullSize
00CB28  1               
00CB28  1               NoDrive:
00CB28  1  A2 00           ldx  #0
00CB2A  1  A0 00           ldy  #0
00CB2C  1  A9 2F           lda  #PRODOS_OFFLINE
00CB2E  1  38              sec
00CB2F  1  80 1C           bra  sExit
00CB31  1               
00CB31  1               ExactSize:                    ;If equal, the DrvBlkCount1,DrvBlkCount0 is the
00CB31  1                                             ; drive's exact size
00CB31  1  B9 F8 05        lda  DrvBlkCount0,y
00CB34  1  19 78 06        ora  DrvBlkCount1,y
00CB37  1  F0 EF           beq  NoDrive               ;can't have a 0-block device
00CB39  1               
00CB39  1  B9 F8 05        lda  DrvBlkCount0,y
00CB3C  1  AA              tax
00CB3D  1  B9 78 06        lda  DrvBlkCount1,y
00CB40  1  A8              tay
00CB41  1  A9 00           lda  #0
00CB43  1  18              clc                          ;no errors
