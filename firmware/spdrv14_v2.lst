00CE7B  1               ;------------------------------------------------------------------------------
00CE7B  1               ; DisplayParms - Display the parameters of the ProDOS request
00CE7B  1               ; Input:
00CE7B  1               ;       None
00CE7B  1               ; Ouput:
00CE7B  1               ;       None
00CE7B  1               ;
00CE7B  1               ; ZeroPage Usage:
00CE7B  1               ;       None
00CE7B  1               ;
00CE7B  1               ; CPU Registers changed:  A, P
00CE7B  1               ;
00CE7B  1               DisplayParms:
00CE7B  1                  jsr  DSString
00CE7B  1                  .byte " B:",0
00CE7B  1               
00CE7B  1                  lda  pdBlockNumberH
00CE7B  1                  jsr  DSByte
00CE7B  1                  lda  pdBlockNumber
00CE7B  1                  jsr  DSByte
00CE7B  1               
00CE7B  1                  jsr  DSString
00CE7B  1                  .byte " U:",0
00CE7B  1                  lda  pdUnitNumber
00CE7B  1                  jsr  DSByte
00CE7B  1               
00CE7B  1                  jsr  DSString
00CE7B  1                  .byte " A$",0
00CE7B  1               
00CE7B  1                  lda  pdIOBufferH
00CE7B  1                  jsr  DSByte
00CE7B  1               
00CE7B  1                  lda  pdIOBuffer
00CE7B  1                  bra  DSByte
00CE7B  1               
00CE7B  1               
00CE7B  1               ;------------------------------------------------------------------------------
00CE7B  1               ; DSString - Sends a String to the Super Serial Card in Slot 2
00CE7B  1               ; Input:
00CE7B  1               ;       string must immediately follow the JSR to this function
00CE7B  1               ;       and be terminated with zero byte.
00CE7B  1               ; Ouput:
00CE7B  1               ;       None
00CE7B  1               ;
00CE7B  1               ; ZeroPage Usage:
00CE7B  1               ;       MsgPointerLow, MsgPointerHi
00CE7B  1               ;
00CE7B  1               ; CPU Registers changed:  A, P
00CE7B  1               ;
00CE7B  1               DSString:
00CE7B  1                  phx                          ;save the X reg
00CE7B  1                  tsx                          ;put the stack pointer in X
00CE7B  1                  lda  MsgPointerLow
00CE7B  1                  pha                          ;push zero page location on stack
00CE7B  1                  lda  MsgPointerHi
00CE7B  1                  pha                          ;push zero page location on stack
00CE7B  1               
00CE7B  1                  lda  StackBase+2,x           ;determine the location of message to display
00CE7B  1                  clc
00CE7B  1                  adc  #$01                    ;add 1 because JSR pushes the last byte of its
00CE7B  1                  sta  MsgPointerLow           ; destination address on the stack
00CE7B  1               
00CE7B  1                  lda  StackBase+3,x
00CE7B  1                  adc  #0
00CE7B  1                  sta  MsgPointerHi
00CE7B  1               
00CE7B  1               dss1:
00CE7B  1                  lda  (MsgPointerLow)
00CE7B  1                  beq  dssend
00CE7B  1                  jsr  DSChar                  ;display message
00CE7B  1                  inc  MsgPointerLow
00CE7B  1                  bne  dss1
00CE7B  1                  inc  MsgPointerHi
00CE7B  1                  bra  dss1
00CE7B  1               
00CE7B  1               dssend:
00CE7B  1               
00CE7B  1                  lda  MsgPointerHi
00CE7B  1                  sta  StackBase+3,x
00CE7B  1                  lda  MsgPointerLow
00CE7B  1                  sta  StackBase+2,x           ;fix up the return address on the stack.
00CE7B  1               
00CE7B  1                  pla
00CE7B  1                  sta  MsgPointerHi            ;restore zero page location
00CE7B  1                  pla
00CE7B  1                  sta  MsgPointerLow           ;restore zero page location
00CE7B  1                  plx
00CE7B  1                  rts                          ;return to location after string's null.
00CE7B  1               
00CE7B  1               ;------------------------------------------------------------------------------
00CE7B  1               ; DSByteCRLF - Sends a Hex byte followed by a CR LF to the Super Serial
00CE7B  1               ; Card in Slot 2
00CE7B  1               ;
00CE7B  1               ; Input:
00CE7B  1               ;       A = Hex number to display
00CE7B  1               ; Ouput:
00CE7B  1               ;       None
00CE7B  1               ;
00CE7B  1               ; CPU Registers changed:  A, P
00CE7B  1               ;
00CE7B  1               DSByteCRLF:
00CE7B  1                  jsr DSByte
00CE7B  1               DSCRLF:
00CE7B  1                  lda  #$0D
00CE7B  1                  jsr  DSChar
00CE7B  1                  lda  #$0A
00CE7B  1                  bra  DSChar
00CE7B  1               
00CE7B  1               ;------------------------------------------------------------------------------
00CE7B  1               ; DSByte - Sends a Hex byte to the Super Serial Card in Slot 2
00CE7B  1               ; Input:
00CE7B  1               ;       A = Hex number to display
00CE7B  1               ; Ouput:
00CE7B  1               ;       None
00CE7B  1               ;
00CE7B  1               ; CPU Registers changed:  A, P
00CE7B  1               ;
00CE7B  1               DSByte:
00CE7B  1                  pha
00CE7B  1                  lsr a
00CE7B  1                  lsr a
00CE7B  1                  lsr a
00CE7B  1                  lsr a
00CE7B  1                  jsr DSNibble
00CE7B  1                  pla
00CE7B  1               DSNibble:
00CE7B  1                  and #$0F
00CE7B  1                  ora #$30
00CE7B  1                  cmp #$30+10
00CE7B  1                  bcc digit
00CE7B  1                  adc #6
00CE7B  1               digit:
00CE7B  1                  bra DSChar
00CE7B  1               
00CE7B  1               ;------------------------------------------------------------------------------
00CE7B  1               ; DSChar - Sends a char to the Super Serial Card in Slot 2
00CE7B  1               ; Input:
00CE7B  1               ;       A = Character to Send
00CE7B  1               ; Ouput:
00CE7B  1               ;       (data out serial port)
00CE7B  1               ;
00CE7B  1               ; ZeroPage Usage:
00CE7B  1               ;       None
00CE7B  1               ;
00CE7B  1               ; CPU Registers changed:  P
00CE7B  1               ;
00CE7B  1               DSBlank:
00CE7B  1                  lda #$20
00CE7B  1               DSChar:
00CE7B  1                  pha
00CE7B  1                  phy
00CE7B  1                  lda  mslot
00CE7B  1                  and  #$0f
00CE7B  1                  tay                          ;Y reg now has $0n for accessing scratchpad RAM
00CE7B  1                  lda  SerialInitDone,y
00CE7B  1                  cmp  #$A5
00CE7B  1                  beq  dsc0
00CE7B  1               
00CE7B  1               ; Init the serial port if sig byte is not $A5.
00CE7B  1               ; Set up serial port on the Apple Super Serial card. Always assume slot 2.
00CE7B  1                  lda  #$1f
00CE7B  1                  sta  $c0ab                   ;control register
00CE7B  1                  lda  #$0b
00CE7B  1                  sta  $c0aa                   ;format
00CE7B  1                  lda  $c0a9                   ;clear status
00CE7B  1                  lda  #$A5
00CE7B  1                  sta  SerialInitDone,y
00CE7B  1               
00CE7B  1               dsc0:
00CE7B  1                  lda  $c0a9
00CE7B  1                  and  #%00010000              ;Transmit register empty?
00CE7B  1                  beq  dsc0                    ;If not, wait
00CE7B  1               
00CE7B  1                  ply
00CE7B  1                  pla                          ;get byte back
00CE7B  1                  sta  $c0a8                   ;send it
00CE7B  1                  rts
00CE7B  1               
00CE7B  1               .ENDIF
00CE7B  1               
