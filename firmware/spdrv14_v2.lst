00CE41  1               ;------------------------------------------------------------------------------
00CE41  1               ; IDEWaitReady - Waits for BUSY flag to clear, and returns DRQ bit status
00CE41  1               ;
00CE41  1               ; Input:
00CE41  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CE41  1               ; Ouput:
00CE41  1               ;       Carry flag = DRQ status bit
00CE41  1               ;
00CE41  1               ; ZeroPage Usage:
00CE41  1               ;       None
00CE41  1               ;
00CE41  1               ; CPU Registers changed:  A, P
00CE41  1               ;
00CE41  1               IDEWaitReady:
00CE41  1  BD 8F C0        lda  ATAStatus,x
00CE44  1  30 FB           bmi  IDEWaitReady            ;Wait for BUSY (bit 7) to be zero
00CE46  1  6A              ror                          ;shift DRQ status bit into the Carry bit
00CE47  1  6A              ror
00CE48  1  6A              ror
00CE49  1  6A              ror
00CE4A  1  60              rts
00CE4B  1               
00CE4B  1               ;------------------------------------------------------------------------------
00CE4B  1               ; CheckDevice - Check to see if a device is attached to the interface.
00CE4B  1               ; Input:
00CE4B  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CE4B  1               ; Output:
00CE4B  1               ;       Carry flag: 0 = Device Present, 1 = Device Missing
00CE4B  1               ;
00CE4B  1               ; CPU Registers changed:  A, P
00CE4B  1               ;
00CE4B  1               ;  Checks to see if the drive status register is readable and equal to $50
00CE4B  1               ;  If so, return with the Carry clear, otherwise return with the carry set.
00CE4B  1               ;  Waits up to 10sec on a standard 1Mhz Apple II for drive to become ready
00CE4B  1               ;
00CE4B  1               CheckDevice:
00CE4B  1  5A              phy
00CE4C  1  3C 82 C0        bit  ClearCSMask,x           ;reset MASK bit in PLD for normal CS0 signaling
00CE4F  1  A9 E0           lda  #$E0                    ;$E0 = [1, LBA, 1, Drive, LBA 27-24]  where
00CE51  1                                               ; LBA=1, Drive=0
00CE51  1  9D 8E C0        sta  ATAHead,x               ;Make sure ATA master drive is accessed
00CE54  1               
00CE54  1  A0 00           ldy  #0
00CE56  1               chkLoop:
00CE56  1  BD 8F C0        lda  ATAStatus,x
00CE59  1  29 D0           and  #%11010000
00CE5B  1  C9 50           cmp  #$50                    ;if BUSY= 0 and RDY=1 and DSC=1
00CE5D  1  F0 0D           beq  DeviceFound
00CE5F  1  A9 C5           lda  #WAIT_100ms
00CE61  1  20 6F CE        jsr  Wait                    ;Wait 100ms for device to be ready
00CE64  1  C8              iny
00CE65  1  C0 64           cpy  #100                    ;Wait up to 10 seconds for drive to be ready
00CE67  1                                               ; This time may turn out to be much shorter on
00CE67  1                                               ; accelerated Apple IIs
00CE67  1  D0 ED           bne chkLoop
00CE69  1               
00CE69  1  38              sec                          ;set c = 1 if drive is not attached
00CE6A  1  7A              ply
00CE6B  1  60              rts
00CE6C  1               
00CE6C  1               DeviceFound:
00CE6C  1  18              clc                          ;set c = 0 if drive is attached
00CE6D  1  7A              ply
00CE6E  1  60              rts
00CE6F  1               
00CE6F  1               ;------------------------------------------------------------------------------
00CE6F  1               ;  Wait - Copy of Apple's wait routine. Can't use ROM based routine in case
00CE6F  1               ;         ROM is not active when we need it.
00CE6F  1               ;
00CE6F  1               ; Input:
00CE6F  1               ;       A = desired delay time, where Delay(us) = .5(5A^2 + 27A + 26)
00CE6F  1               ;       or more usefully: A = (Delay[in uS]/2.5 + 2.09)^.5 - 2.7
00CE6F  1               ;
00CE6F  1               ; CPU Registers changed:  A, P
00CE6F  1               ;
00CE6F  1               Wait:
00CE6F  1  38              sec
00CE70  1               
00CE70  1               Wait2:
00CE70  1  48              pha
00CE71  1               
00CE71  1               Wait3:
00CE71  1  E9 01           sbc  #1
00CE73  1  D0 FC           bne  Wait3
00CE75  1  68              pla
00CE76  1  E9 01           sbc  #1
00CE78  1  D0 F6           bne  Wait2
00CE7A  1  60              rts
