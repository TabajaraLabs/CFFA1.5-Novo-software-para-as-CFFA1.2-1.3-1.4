00CC90  1               ; v1.4 (Tabajara Labs) - modo FAT
00CC90  1               ;
00CC90  1               ; FatDriveOK: confere se o drive DriveNumber,y esta montado e conferido.
00CC90  1               ;   Entrada: Y = $0n. Saida: C=0 e Y = DriveNumber*24 (indice na CfgHdr); C=1 se nao.
00CC90  1               ;   Altera A, Y.
00CC90  1               FatDriveOK:
00CC90  1  B9 F8 04        lda  DriveNumber,y
00CC93  1  C9 04           cmp  #4
00CC95  1  B0 17           bcs  fdNo
00CC97  1  DA              phx
00CC98  1  AA              tax
00CC99  1  B9 78 05        lda  FatFlags,y
00CC9C  1  3D B0 CC        and  BitTab,x
00CC9F  1  FA              plx
00CCA0  1  C9 01           cmp  #1                      ;C=1 se A<>0 (montado)
00CCA2  1  90 0A           bcc  fdNo1
00CCA4  1  B9 F8 04        lda  DriveNumber,y
00CCA7  1  A8              tay
00CCA8  1  B9 B4 CC        lda  OfsTab,y
00CCAB  1  A8              tay
00CCAC  1  18              clc
00CCAD  1  60              rts
00CCAE  1               fdNo1:
00CCAE  1               fdNo:
00CCAE  1  38              sec
00CCAF  1  60              rts
00CCB0  1               BitTab:
00CCB0  1  01 02 04 08     .byte $01,$02,$04,$08
00CCB4  1               OfsTab:
00CCB4  1  00 18 30 48     .byte 0,24,48,72
00CCB8  1               fiOutJ:
00CCB8  1  4C 6C CD        jmp  fiOut
00CCBB  1               
00CCBB  1               ; FatInit: detecta o tipo de cartao e confere as montagens. Chamado uma vez depois do reset.
00CCBB  1               ;   Cartao FAT = setor 0 termina em $55,$AA e nao comeca com $01 (bloco de boot ProDOS).
00CCBB  1               ;   Para cada drive montado na tabela, le o setor de diretorio gravado e compara o cluster
00CCBB  1               ;   inicial e o tamanho da entrada do arquivo; so entao liga o bit do drive em FatFlags.
00CCBB  1               ;   Entrada: X = $n0, Y = $0n. Preserva X e Y. Usa $ED (salvo e restaurado).
00CCBB  1               FatInit:
00CCBB  1  A5 ED           lda  zptf
00CCBD  1  48              pha
