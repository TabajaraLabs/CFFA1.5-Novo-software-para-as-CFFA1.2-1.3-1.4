00CDE0  1               ; FatBoot: chamado pelo boot. Se o cartao for FAT e o banco 0 tiver o utilitario ("CFU" em $C800),
00CDE0  1               ;   copia o banco 0 ($C800-$CEFF) para $2000-$26FF e chama $2003 (X = $n0). O utilitario
00CDE0  1               ;   monta as imagens (grava a tabela no banco 4) e volta. Entrada: X = $n0, Y = $0n. Preserva X, Y.
00CDE0  1               FatBoot:
00CDE0  1  A9 00           lda  #0
00CDE2  1  99 78 04        sta  DriveResetDone,y        ;forca reset + FatInit (o cartao pode ter mudado)
00CDE5  1  20 43 CA        jsr  ResetDriveIfFirstTime
00CDE8  1  B9 78 05        lda  FatFlags,y
00CDEB  1  10 16           bpl  fbtOut                  ;cartao cru: boot normal
00CDED  1  5A              phy
00CDEE  1  A0 3C           ldy  #TrampEnd-TrampSrc-1
00CDF0  1               fbtCopy:
00CDF0  1  B9 04 CE        lda  TrampSrc,y
00CDF3  1  99 00 03        sta  $0300,y
00CDF6  1  88              dey
00CDF7  1  10 F7           bpl  fbtCopy
00CDF9  1  7A              ply
00CDFA  1  AD F8 07        lda  mslot                   ;$Cn: religar a nossa ROM de $C800 na volta
00CDFD  1  8D 38 03        sta  TrampSlot-TrampSrc+$0300
00CE00  1  20 00 03        jsr  $0300                   ;(o utilitario zera DriveResetDone se mudar a tabela)
00CE03  1               fbtOut:
00CE03  1  60              rts
00CE04  1               
00CE04  1               ; Trampolim (roda em $0300; a pagina $C7 e igual nos dois bancos, mas $C800 nao)
00CE04  1               TrampSrc:
00CE04  1                  .org $0300                   ;montado para rodar em $0300
000300  1               tStart:
000300  1  DA              phx
000301  1  5A              phy
000302  1  BD 84 C0        lda  BankLow,x               ;banco 0
000305  1  AD 01 C8        lda  $C801
000308  1  C9 46           cmp  #'F'
00030A  1  D0 25           bne  tBack
00030C  1  AD 02 C8        lda  $C802
00030F  1  C9 55           cmp  #'U'
000311  1  D0 1E           bne  tBack
000313  1  A0 00           ldy  #0
000315  1               tCopy:
000315  1  B9 00 C8        lda  $C800,y
000318  1               tDst:
000318  1  99 00 20        sta  $2000,y
00031B  1  C8              iny
00031C  1  D0 F7           bne  tCopy
00031E  1  EE 17 03        inc  tCopy+2
000321  1  EE 1A 03        inc  tDst+2
000324  1  AD 17 03        lda  tCopy+2
000327  1  C9 CF           cmp  #$CF
000329  1  D0 EA           bne  tCopy
00032B  1  BD 85 C0        lda  BankHigh,x              ;banco 4
00032E  1  20 03 20        jsr  $2003                   ;utilitario (X = $n0)
000331  1               tBack:
000331  1  7A              ply
000332  1  FA              plx
000333  1  2C FF CF        bit  $CFFF
000336  1  AD 00           .byte $AD,$00                ;lda $Cn00 (religa a ROM de $C800 da nossa placa)
000338  1               TrampSlotO:
000338  1  C7              .byte $C7
000339  1  BD 85 C0        lda  BankHigh,x              ;banco 4
00033C  1  60              rts
00033D  1               tEnd:
00033D  1                  .org TrampSrc + (tEnd - tStart) ;volta ao endereco da ROM
00CE41  1               TrampEnd:
00CE41  1               TrampSlot = TrampSrc + (TrampSlotO - tStart)
