CHIP "appleideinterface"
BEGIN

    DEVICE = "EPM7064SLC44-10";

    "A0"                           : INPUT_PIN  = 21     ; -- LC17
    "A1"                           : INPUT_PIN  = 20     ; -- LC19
    "A2"                           : INPUT_PIN  = 19     ; -- LC20
    "A3"                           : INPUT_PIN  = 18     ; -- LC21
    "A8"                           : INPUT_PIN  = 17     ; -- LC24
    "A9"                           : INPUT_PIN  = 16     ; -- LC25
    "A10"                          : INPUT_PIN  = 14     ; -- LC30
    "-DevSelect"                   : INPUT_PIN  = 6      ; -- LC11
    "-I/OSelect"                   : INPUT_PIN  = 4      ; -- LC16
    "-I/OStrobe"                   : INPUT_PIN  = 5      ; -- LC14
    "R/W"                          : INPUT_PIN  = 12     ; -- LC1
    "7Mclk"                        : INPUT_PIN  = 43     ;
    "CS_MASK"                      : OUTPUT_PIN = 24     ; -- LC33
    "-CS0"                         : OUTPUT_PIN = 40     ; -- LC62
    "-CS1"                         : OUTPUT_PIN = 41     ; -- LC64
    "DBUS245"                      : OUTPUT_PIN = 25     ; -- LC35
    "-EPROM_EN"                    : OUTPUT_PIN = 29     ; -- LC41
    "-IORD"                        : OUTPUT_PIN = 39     ; -- LC57
    "-IOWR"                        : OUTPUT_PIN = 37     ; -- LC53
    "LA0"                          : OUTPUT_PIN = 9      ; -- LC4
    "LA1"                          : OUTPUT_PIN = 11     ; -- LC3
    "LA2"                          : OUTPUT_PIN = 28     ; -- LC40
    "NOT_R/W"                      : OUTPUT_PIN = 26     ; -- LC36
    "R_ATA"                        : OUTPUT_PIN = 33     ; -- LC49
    "-R_HOST"                      : OUTPUT_PIN = 31     ; -- LC46
    "-W_ATA"                       : OUTPUT_PIN = 36     ; -- LC52
    "W_HOST"                       : OUTPUT_PIN = 34     ; -- LC51
    "|appleidelogic:147|/C800_FF"  : LOCATION   = LC48   ; -- PIN 32
    "|appleidelogic:147|DelayDSEL1" : LOCATION   = IOC_6    ; -- LC11  -- -DevSelect
    "|appleidelogic:147|DelayDSEL2" : LOCATION   = LC58   ;
    "|appleidelogic:147|LA3"       : LOCATION   = IOC_18   ; -- LC21  -- A3

END;

