-- Node name is '|appleidelogic:147|LA3' from file "appleidelogic.tdf" line 67, column 9
-- Equation name is '_IOC_18', type is buried 
A3       : INPUT;
_IOC_18  = DFFE(A3, GLOBAL( 7Mclk),  VCC,  VCC,  -DevSelect);

-- Node name is 'CS_MASK' = '|appleidelogic:147|:67' from file "appleidelogic.tdf" line 86, column 14
-- Equation name is 'CS_MASK', type is output 
 CS_MASK = TFFE( _EQ001, GLOBAL( 7Mclk),  VCC,  VCC,  VCC);
  _EQ001 =  CS_MASK & !-DevSelect & !_IOC_18 & !LA0 &  LA1 & !LA2
         # !CS_MASK & !-DevSelect & !_IOC_18 &  LA0 & !LA1 & !LA2;

-- Node name is 'DBUS245' 
-- Equation name is 'DBUS245', location is LC035, type is output.
 DBUS245 = LCELL( _EQ002 $  GND);
  _EQ002 =  -DevSelect &  -I/OSelect &  _LC048
         #  -DevSelect &  -I/OSelect &  -I/OStrobe;

-- Node name is 'LA0' = '|appleidelogic:147|:62' from file "appleidelogic.tdf" line 64, column 9
-- Equation name is 'LA0', type is output 
 LA0     = DFFE( A0 $  GND, GLOBAL( 7Mclk),  VCC,  VCC,  -DevSelect);

-- Node name is 'LA1' = '|appleidelogic:147|:63' from file "appleidelogic.tdf" line 65, column 9
-- Equation name is 'LA1', type is output 
 LA1     = DFFE( A1 $  GND, GLOBAL( 7Mclk),  VCC,  VCC,  -DevSelect);

-- Node name is 'LA2' = '|appleidelogic:147|:64' from file "appleidelogic.tdf" line 66, column 9
-- Equation name is 'LA2', type is output 
 LA2     = DFFE( A2 $  GND, GLOBAL( 7Mclk),  VCC,  VCC,  -DevSelect);

-- Node name is 'NOT_R/W' 
-- Equation name is 'NOT_R/W', location is LC036, type is output.
 NOT_R/W = LCELL(!R/W $  GND);

-- Node name is 'R_ATA' 
-- Equation name is 'R_ATA', location is LC049, type is output.
 R_ATA   = LCELL( _EQ003 $  GND);
  _EQ003 = !-DevSelect & !_IOC_6 &  _IOC_18 & !LA0 & !LA1 & !LA2 &  R/W;

-- Node name is 'W_HOST' 
-- Equation name is 'W_HOST', location is LC051, type is output.
 W_HOST  = LCELL( _EQ004 $  GND);
  _EQ004 = !-DevSelect & !_IOC_6 & !_IOC_18 & !LA0 & !LA1 & !LA2 & !R/W;

-- Node name is '|appleidelogic:147|/C800_FF' from file "appleidelogic.tdf" line 70, column 13
-- Equation name is '_LC048', type is buried 
