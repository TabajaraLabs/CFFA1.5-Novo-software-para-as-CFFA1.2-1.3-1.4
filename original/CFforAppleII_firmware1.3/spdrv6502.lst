00CC6A  1               ;------------------------------------------------------------------------------
00CC6A  1               ; Block2LBA - Translates ProDOS block# into LBA and programs devices' task file
00CC6A  1               ;             registers.
00CC6A  1               ;
00CC6A  1               ; Input:
00CC6A  1               ;       pd Command Block Data $42 - $47
00CC6A  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CC6A  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CC6A  1               ;
00CC6A  1               ; Ouput:
00CC6A  1               ;       None
00CC6A  1               ;
00CC6A  1               ; ZeroPage Usage:
00CC6A  1               ;       None
00CC6A  1               ;
00CC6A  1               ; CPU Registers changed:  A, P
00CC6A  1               ;
00CC6A  1               ; This function translates the block number sent in the PRODOS request
00CC6A  1               ; packet, into an ATA Logical Block Address (LBA).
00CC6A  1               ; The least significant 16 bits becomes the ProDOS block#.
00CC6A  1               ; The most significant 16 becomes the ProDOS Drive #
00CC6A  1               ;
00CC6A  1               ; A ProDOS block and a ATA sector are both 512 bytes.
00CC6A  1               ;
00CC6A  1               ; Logical Block Mode, the Logical Block Address is interpreted as follows:
00CC6A  1               ; LBA07-LBA00: Sector Number Register D7-D0.
00CC6A  1               ; LBA15-LBA08: Cylinder Low Register D7-D0.
00CC6A  1               ; LBA23-LBA16: Cylinder High Register D7-D0.
00CC6A  1               ; LBA27-LBA24: Drive/Head Register bits HS3-HS0.
00CC6A  1               
00CC6A  1               
00CC6A  1               Block2LBA:
00CC6A  1               
00CC6A  1  A9 E0           lda  #$E0                    ;1, (LBA), 1, (Drive), LBA 27-24, where LBA=1,
00CC6C  1                                               ; Drive=0
00CC6C  1  9D 8E C0        sta  ATAHead,x               ;Talk to the Master device and use LBA mode.
00CC6F  1                                               ; Remember that this write will seen by both
00CC6F  1                                               ; the master and slave devices.
00CC6F  1               ;
00CC6F  1               ; Add BLOCKOFFSET to the ProDOS block number to offset the first drive block we
00CC6F  1               ; use. This keeps the device's first BLOCKOFFSET blocks free, which usually
00CC6F  1               ; includes a MBR at block 0.
00CC6F  1               ;
00CC6F  1  B9 78 07        lda  DrvMiscFlags,y           ; bit 7 = raw block access
00CC72  1  29 80           and  #$80
00CC74  1  49 80           eor  #$80
00CC76  1  F0 02           beq  rawBlocks
00CC78  1  A9 00           lda  #BLOCKOFFSET
00CC7A  1               rawBlocks:                      ; A = $00 or BLOCKOFFSET
00CC7A  1  18              clc
00CC7B  1  65 46           adc  pdBlockNumber
00CC7D  1  9D 8B C0        sta  ATASector,x             ;store ProDOS Low block # into LBA 0-7
00CC80  1               
00CC80  1  A5 47           lda  pdBlockNumberH
00CC82  1  69 00           adc  #0                      ;account for any overflow in LBA 0-7
00CC84  1  9D 8C C0        sta  ATACylinder,x           ;store ProDOS High block # into LBA 15-8
00CC87  1               
00CC87  1  B9 F8 04        lda DriveNumber,y
00CC8A  1  69 00           adc #0                        ;account for overflow from LBA 8-15
00CC8C  1  9D 8D C0        sta ATACylinderH,x            ;store LBA bits 23-16
00CC8F  1               
00CC8F  1  A9 01           lda #1
00CC91  1  9D 8A C0        sta ATASectorCnt,x
00CC94  1  60              rts
00CC95  1               
00CC95  1               ;------------------------------------------------------------------------------
00CC95  1               ; IDEWaitReady - Waits for BUSY flag to clear, and returns DRQ bit status
00CC95  1               ;
00CC95  1               ; Input:
00CC95  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CC95  1               ; Ouput:
00CC95  1               ;       Carry flag = DRQ status bit
00CC95  1               ;
00CC95  1               ; ZeroPage Usage:
00CC95  1               ;       None
00CC95  1               ;
00CC95  1               ; CPU Registers changed:  A, P
00CC95  1               ;
00CC95  1               IDEWaitReady:
00CC95  1  BD 8F C0        lda  ATAStatus,x
00CC98  1  30 FB           bmi  IDEWaitReady            ;Wait for BUSY (bit 7) to be zero
00CC9A  1  6A              ror                          ;shift DRQ status bit into the Carry bit
00CC9B  1  6A              ror
00CC9C  1  6A              ror
00CC9D  1  6A              ror
00CC9E  1  60              rts
00CC9F  1               
00CC9F  1               ;------------------------------------------------------------------------------
00CC9F  1               ; CheckDevice - Check to see if a device is attached to the interface.
00CC9F  1               ; Input:
00CC9F  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CC9F  1               ; Output:
00CC9F  1               ;       Carry flag: 0 = Device Present, 1 = Device Missing
00CC9F  1               ;
00CC9F  1               ; CPU Registers changed:  A, P
00CC9F  1               ;
00CC9F  1               ;  Checks to see if the drive status register is readable and equal to $50
00CC9F  1               ;  If so, return with the Carry clear, otherwise return with the carry set.
00CC9F  1               ;  Waits up to 10sec on a standard 1Mhz Apple II for drive to become ready
00CC9F  1               ;
00CC9F  1               CheckDevice:
00CC9F  1  98              tya
00CCA0  1  48              pha
00CCA1  1  BD 82 C0        lda  ClearCSMask,x           ;reset MASK bit in PLD for normal CS0 signaling
00CCA4  1  A9 E0           lda  #$E0                    ;$E0 = [1, LBA, 1, Drive, LBA 27-24]  where
00CCA6  1                                               ; LBA=1, Drive=0
00CCA6  1  9D 8E C0        sta  ATAHead,x               ;Make sure ATA master drive is accessed
00CCA9  1               
00CCA9  1  A0 00           ldy  #0
00CCAB  1               chkLoop:
00CCAB  1  BD 8F C0        lda  ATAStatus,x
00CCAE  1  29 D0           and  #%11010000
00CCB0  1  C9 50           cmp  #$50                    ;if BUSY= 0 and RDY=1 and DSC=1
00CCB2  1  F0 0D           beq  DeviceFound
00CCB4  1  A9 C5           lda  #WAIT_100ms
00CCB6  1  20 C5 CC        jsr  Wait                    ;Wait 100ms for device to be ready
00CCB9  1  C8              iny
00CCBA  1  C0 64           cpy  #100                    ;Wait up to 10 seconds for drive to be ready
00CCBC  1                                               ; This time may turn out to be much shorter on
00CCBC  1                                               ; accelerated Apple IIs
00CCBC  1  D0 ED           bne chkLoop
00CCBE  1               
00CCBE  1  38              sec                          ;set c = 1 if drive is not attached
00CCBF  1  B0 01           bcs  DeviceExit
00CCC1  1               
00CCC1  1               DeviceFound:
00CCC1  1  18              clc                          ;set c = 0 if drive is attached
00CCC2  1               
00CCC2  1               DeviceExit:
00CCC2  1  68              pla
00CCC3  1  A8              tay
00CCC4  1  60              rts
00CCC5  1               
00CCC5  1               ;------------------------------------------------------------------------------
00CCC5  1               ;  Wait - Copy of Apple's wait routine. Can't use ROM based routine in case
00CCC5  1               ;         ROM is not active when we need it.
00CCC5  1               ;
00CCC5  1               ; Input:
00CCC5  1               ;       A = desired delay time, where Delay(us) = .5(5A^2 + 27A + 26)
00CCC5  1               ;       or more usefully: A = (Delay[in uS]/2.5 + 2.09)^.5 - 2.7
00CCC5  1               ;
00CCC5  1               ; CPU Registers changed:  A, P
00CCC5  1               ;
00CCC5  1               Wait:
00CCC5  1  38              sec
00CCC6  1               
00CCC6  1               Wait2:
00CCC6  1  48              pha
00CCC7  1               
00CCC7  1               Wait3:
00CCC7  1  E9 01           sbc  #1
00CCC9  1  D0 FC           bne  Wait3
00CCCB  1  68              pla
00CCCC  1  E9 01           sbc  #1
00CCCE  1  D0 F6           bne  Wait2
00CCD0  1  60              rts
00CCD1  1               
00CCD1  1               
00CCD1  1               
00CCD1  1               
00CCD1  1               .IF DEBUG
00CCD1  1               
00CCD1  1               ;------------------------------------------------------------------------------
00CCD1  1               ; DisplayParms - Display the parameters of the ProDOS request
00CCD1  1               ; Input:
00CCD1  1               ;       None
00CCD1  1               ; Ouput:
00CCD1  1               ;       None
00CCD1  1               ;
00CCD1  1               ; ZeroPage Usage:
00CCD1  1               ;       None
00CCD1  1               ;
00CCD1  1               ; CPU Registers changed:  A, P
00CCD1  1               ;
00CCD1  1               DisplayParms:
00CCD1  1                  jsr  DSString
00CCD1  1                  .byte " B:",0
00CCD1  1               
00CCD1  1                  lda  pdBlockNumberH
00CCD1  1                  jsr  DSByte
00CCD1  1                  lda  pdBlockNumber
00CCD1  1                  jsr  DSByte
00CCD1  1               
00CCD1  1                  jsr  DSString
00CCD1  1                  .byte " U:",0
00CCD1  1                  lda  pdUnitNumber
00CCD1  1                  jsr  DSByte
00CCD1  1               
00CCD1  1                  jsr  DSString
00CCD1  1                  .byte " A$",0
00CCD1  1               
00CCD1  1                  lda  pdIOBufferH
00CCD1  1                  jsr  DSByte
00CCD1  1               
00CCD1  1                  lda  pdIOBuffer
00CCD1  1                  jmp  DSByte
00CCD1  1               
00CCD1  1               
00CCD1  1               ;------------------------------------------------------------------------------
00CCD1  1               ; DSString - Sends a String to the Super Serial Card in Slot 2
00CCD1  1               ; Input:
00CCD1  1               ;       string must immediately follow the JSR to this function
00CCD1  1               ;       and be terminated with zero byte.
00CCD1  1               ; Ouput:
00CCD1  1               ;       None
00CCD1  1               ;
00CCD1  1               ; ZeroPage Usage:
00CCD1  1               ;       MsgPointerLow, MsgPointerHi
00CCD1  1               ;
00CCD1  1               ; CPU Registers changed:  A, P
00CCD1  1               ;
00CCD1  1               DSString:
00CCD1  1                  pha                          ;save the Acc reg
00CCD1  1                  txa
00CCD1  1                  pha                          ;save the X reg
00CCD1  1                  tya
00CCD1  1                  pha                          ;save the Y reg
00CCD1  1                  tsx                          ;put the stack pointer in X
00CCD1  1                  lda  MsgPointerLow
00CCD1  1                  pha                          ;push zero page location on stack
00CCD1  1                  lda  MsgPointerHi
00CCD1  1                  pha                          ;push zero page location on stack
00CCD1  1               
00CCD1  1                  lda  StackBase+4,x           ;determine the location of message to display
00CCD1  1                  clc
00CCD1  1                  adc  #$01                    ;add 1 because JSR pushes the last byte of its
00CCD1  1                  sta  MsgPointerLow           ; destination address on the stack
00CCD1  1               
00CCD1  1                  lda  StackBase+5,x
00CCD1  1                  adc  #0
00CCD1  1                  sta  MsgPointerHi
00CCD1  1               
00CCD1  1               dss1:
00CCD1  1                  ldy  #0
00CCD1  1                  lda  (MsgPointerLow),y
00CCD1  1                  beq  dssend
00CCD1  1                  jsr  DSChar                  ;display message
00CCD1  1                  inc  MsgPointerLow
00CCD1  1                  bne  dss1
00CCD1  1                  inc  MsgPointerHi
00CCD1  1                  jmp  dss1
00CCD1  1               
00CCD1  1               dssend:
00CCD1  1               
00CCD1  1                  lda  MsgPointerHi
00CCD1  1                  sta  StackBase+5,x
00CCD1  1                  lda  MsgPointerLow
00CCD1  1                  sta  StackBase+4,x           ;fix up the return address on the stack.
00CCD1  1               
00CCD1  1                  pla
00CCD1  1                  sta  MsgPointerHi            ;restore zero page location
00CCD1  1                  pla
00CCD1  1                  sta  MsgPointerLow           ;restore zero page location
00CCD1  1                  pla
00CCD1  1                  tay
00CCD1  1                  pla
00CCD1  1                  tax
00CCD1  1                  pla
00CCD1  1                  rts                          ;return to location after string's null.
00CCD1  1               
00CCD1  1               ;------------------------------------------------------------------------------
00CCD1  1               ; DSByteCRLF - Sends a Hex byte followed by a CR LF to the Super Serial
00CCD1  1               ; Card in Slot 2
00CCD1  1               ;
00CCD1  1               ; Input:
00CCD1  1               ;       A = Hex number to display
00CCD1  1               ; Ouput:
00CCD1  1               ;       None
00CCD1  1               ;
00CCD1  1               ; CPU Registers changed:  A, P
00CCD1  1               ;
00CCD1  1               DSByteCRLF:
00CCD1  1                  jsr DSByte
00CCD1  1               DSCRLF:
00CCD1  1                  lda  #$0D
00CCD1  1                  jsr  DSChar
00CCD1  1                  lda  #$0A
00CCD1  1                  jmp  DSChar
00CCD1  1               
00CCD1  1               ;------------------------------------------------------------------------------
00CCD1  1               ; DSByte - Sends a Hex byte to the Super Serial Card in Slot 2
00CCD1  1               ; Input:
00CCD1  1               ;       A = Hex number to display
00CCD1  1               ; Ouput:
00CCD1  1               ;       None
00CCD1  1               ;
00CCD1  1               ; CPU Registers changed:  A, P
00CCD1  1               ;
00CCD1  1               DSByte:
00CCD1  1                  pha
00CCD1  1                  lsr a
00CCD1  1                  lsr a
00CCD1  1                  lsr a
00CCD1  1                  lsr a
00CCD1  1                  jsr DSNibble
00CCD1  1                  pla
00CCD1  1               DSNibble:
00CCD1  1                  and #$0F
00CCD1  1                  ora #$30
00CCD1  1                  cmp #$30+10
00CCD1  1                  bcc digit
00CCD1  1                  adc #6
00CCD1  1               digit:
00CCD1  1                  jmp DSChar
00CCD1  1               
00CCD1  1               ;------------------------------------------------------------------------------
00CCD1  1               ; DSChar - Sends a char to the Super Serial Card in Slot 2
00CCD1  1               ; Input:
00CCD1  1               ;       A = Character to Send
00CCD1  1               ;       mslot = should contain current slot number of CFFA
00CCD1  1               ; Ouput:
00CCD1  1               ;       (data out serial port)
00CCD1  1               ;
00CCD1  1               ; ZeroPage Usage:
00CCD1  1               ;       None
00CCD1  1               ;
00CCD1  1               ; CPU Registers changed:  P
00CCD1  1               ;
00CCD1  1               DSBlank:
00CCD1  1                  lda #$20
00CCD1  1               DSChar:
00CCD1  1                  pha
00CCD1  1                  tya
00CCD1  1                  pha
00CCD1  1                  lda  mslot
00CCD1  1                  and  #$0f
00CCD1  1                  tay                          ;Y reg now has $0n for accessing scratchpad RAM
00CCD1  1                  lda  SerialInitDone,y
00CCD1  1                  cmp  #$A5
00CCD1  1                  beq  dsc0
00CCD1  1               
00CCD1  1               ; Init the serial port if sig byte is not $A5.
00CCD1  1               ; Set up serial port on the Apple Super Serial card. Always assume slot 2.
00CCD1  1                  lda  #$1f
00CCD1  1                  sta  $c0ab                   ;control register
00CCD1  1                  lda  #$0b
00CCD1  1                  sta  $c0aa                   ;format
00CCD1  1                  lda  $c0a9                   ;clear status
00CCD1  1                  lda  #$A5
00CCD1  1                  sta  SerialInitDone,y
00CCD1  1               
00CCD1  1               dsc0:
00CCD1  1                  lda  $c0a9
00CCD1  1                  and  #%00010000              ;Transmit register empty?
00CCD1  1                  beq  dsc0                    ;If not, wait
00CCD1  1               
00CCD1  1                  pla
00CCD1  1                  tay
00CCD1  1                  pla                          ;get byte back
00CCD1  1                  sta  $c0a8                   ;send it
00CCD1  1                  rts
00CCD1  1               
00CCD1  1               .ENDIF
00CCD1  1               
