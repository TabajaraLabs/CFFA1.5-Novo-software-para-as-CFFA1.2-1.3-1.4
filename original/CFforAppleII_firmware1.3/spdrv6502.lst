00CBE0  1               
00CBE0  1               rLoop:
00CBE0  1  BD 8F C0        lda  ATAStatus,x             ;Note: not using IDEWaitReady, using inline code
00CBE3  1  30 FB           bmi  rLoop                   ;Wait for BUSY (bit 7) to be zero
00CBE5  1  29 08           and  #$08                    ;get DRQ status bit
00CBE7  1  F0 18           beq  rShort                  ;if off, didn't get enough data
00CBE9  1               
