Main file   : spdrv6502.s
Current file: spdrv6502.s

000000r 1               ;------------------------------------------------------------------------------
000000r 1               ; ProDOS/SmartPort driver for CompactFlash/IDE Interface for Apple II computers
000000r 1               ; spdrv6502.s  Version 1.0 - 04/18/2004
000000r 1               ;
000000r 1               ; Firmware Contributors:        Email:
000000r 1               ;  Chris Schumann                cschumann@twp-llc.com
000000r 1               ;  Rich Dreher                   rich@dreher.net
000000r 1               ;  Dave Lyons                    dlyons@lyons42.com
000000r 1               ;
000000r 1               ;
000000r 1               ; This version only requires a 6502 or later equipped machine.
000000r 1               ;
000000r 1               ; Tools used to build this driver: CA65: 6502 Cross Assembler
000000r 1               ; http://www.cc65.org/
000000r 1               ;
000000r 1               ; Here is the copyright from that tool using --version option
000000r 1               ; ca65 V2.6.9 - (C) Copyright 1998-2000 Ullrich von Bassewitz
000000r 1               ;
000000r 1               ; Example build instructions on an MSDOS based machine:
000000r 1               ;------------------------------------------------------
000000r 1               ; Assumes you have installed the CC65 package and set your path, etc.
000000r 1               ;
000000r 1               ; 1) c:\firmware> ca65 -t apple2 --cpu 6502 -l spdrv6502.s
000000r 1               ; 2) c:\firmware> ld65 -t apple2 spdrv6502.o -o spdrv6502.bin
000000r 1               ; 3) Because the EPROM can hold up to 8 user selectable version of firmware
000000r 1               ;    you must load spdrv6502.bin into your EPROM programmer with one of the
000000r 1               ;    following offsets:
000000r 1               ;    (Note: this offset has nothing to do with the card slot offsets)
000000r 1               ;
000000r 1               ;  for driver #0: use offset $0000.  Selected with: A14= IN, A13= IN, A12= IN
000000r 1               ;  for driver #1: use offset $1000.  Selected with: A14= IN, A13= IN, A12=OUT
000000r 1               ;  for driver #2: use offset $2000.  Selected with: A14= IN, A13=OUT, A12= IN
000000r 1               ;  for driver #3: use offset $3000.  Selected with: A14= IN, A13=OUT, A12=OUT
000000r 1               ;  for driver #4: use offset $4000.  Selected with: A14=OUT, A13= IN, A12= IN
000000r 1               ;  for driver #5: use offset $5000.  Selected with: A14=OUT, A13= IN, A12=OUT
000000r 1               ;  for driver #6: use offset $6000.  Selected with: A14=OUT, A13=OUT, A12= IN
000000r 1               ;  for driver #7: use offset $7000.  Selected with: A14=OUT, A13=OUT, A12=OUT
000000r 1               ;
000000r 1               ;  where IN = jumper shorted, and OUT = jumper open
000000r 1               ;  Driver #0 through #7 correspond to the user selectable
000000r 1               ;  jumpers: J6 (A14,A13,A12) on the interface card.
000000r 1               ;
000000r 1               ; 4) Load as many firmware versions, up to 8, into the EPROM programmer as you
000000r 1               ;    want. Remember that most programmers will, by default, clear all unused
000000r 1               ;    memory to $FF when you load a binary file. You will need to disable that
000000r 1               ;    feature after loading the first file.
000000r 1               ;
000000r 1               ; 5) Now you have an EPROM ready image to be programmed.
000000r 1               ;    Using a standard 27C256 EPROM or similar, program your EPROM.
000000r 1               ;
000000r 1               ; Firmware Version History
000000r 1               ;-------------------------
000000r 1               ;
000000r 1               ; Version 1.0:  (6502 version located at EPROM offset $4000, selection #4)
000000r 1               ;   - Start of 6502 specific driver. Based on Version 1.2 spdrv.s driver
000000r 1               ;   - Now works with 6502 CPU. Removed all 65C02 specific instruction from the ver 1.2 firmware
000000r 1               ;   - NOTE: To work in 6502 based machine, logic CPLD version 1.3 or later is required.
000000r 1               ;   - Changed error messages to upper case for Apple ]['s that don't support lower case.
000000r 1               ;   - Setup slot specific behavior: Slot 5 has smartport enabled but will not autoboot.
000000r 1               ;       All other slots have smartport disabled, but will autoboot in an Apple ][+ or ][e.
000000r 1               ;   - Made 4th boot signature byte a parameter to boot code macro to ease slot specific setup.
000000r 1               ;   - Changed GSOS_DRIVER signature to $10. This will prevent Dave Lyons' GS/OS driver from
000000r 1               ;       loading should someone inadvertently using this firmware in a ][GS.
000000r 1               ;   - Change offsets for code loading with addition of .RES command
000000r 1               ;       bin files can now be loaded in EPROM at normal 4K offsets:$0, $1000, $2000, etc,
000000r 1               ;       instead of offsets $100, $1100, $2100, etc.
000000r 1               ;
000000r 1               ; PLD Logic Firmware Information
000000r 1               ;-------------------------------
000000r 1               ; This version of firmware assumes you are using PLD logic of at
000000r 1               ; least CPLD logic version 1.3.  The source files for U6, the Altera PLD are:
000000r 1               ;       Appleideinterface.gdf
000000r 1               ;       Appleidelogic.tdf
000000r 1               ;
000000r 1               ; The programmer ready output file for the PLD logic is:
000000r 1               ;       Appleideinterface.pof
000000r 1               ;
000000r 1               ; These files are not included with this code.
000000r 1               ;
000000r 1               ; Acknowledgements
000000r 1               ;-----------------
000000r 1               ;Thanks to:
000000r 1               ; Chris Schuman - for his extensive initial development work
000000r 1               ; David Lyons   - for technical information, many improvement ideas and
000000r 1               ;                 SmartPort code development
000000r 1               ;
000000r 1               
000000r 1               .define         EQU             =
000000r 1               .define         TRUE            1
000000r 1               .define         FALSE           0
000000r 1               
000000r 1               
000000r 1               ;
000000r 1               ; Firmware Version Information
000000r 1               ;
000000r 1               FIRMWARE_VER    EQU $10        ;Version 1.0 (Version of this code)
000000r 1               SPDRIVERVERSION EQU $1200      ;SmartPort version 1.2
000000r 1               GSOS_DRIVER     EQU $10        ;GS/OS driver will check this byte to see if it
000000r 1                                               ;is still compatible with this firmware.
000000r 1                                               ;Increment by one, when something changes that
000000r 1                                               ;would require a change in the GS/OS driver.
000000r 1                                               ;Otherwise only change the FIRMWARE_VER for all
000000r 1                                               ;other changes.
000000r 1                                               ;01 = ProDOS Driver supporting 2 drives.
000000r 1                                               ;02 = SmartPort Driver supporting 4 drives
000000r 1                                               ;03 = SmartPort Driver supporting 8 drives.NOTE: GS/OS driver won't load
000000r 1                                               ;10 - 6502 version: ProDOS Driver supporting 2 drives. NOTE: GS/OS driver won't load
000000r 1               ;
000000r 1               ; Firmware Configuration Settings:
000000r 1               ;
000000r 1               SMARTPORT_SIG   EQU FALSE      ;Set to FALSE for booting on ][, ][+ machines who's ROM checks 4 bytes of boot sig.
000000r 1                                              ;    to TRUE for booting on IIe and later machines, that only check 3 bytes of boot sig.
000000r 1               
000000r 1               BLOCKOFFSET     EQU 0          ;0..255: LBA of first block of first partition
000000r 1               PARTITIONS32MB  EQU 4          ;Number of 32MB Partitions supported
000000r 1                                              ;Remember, ProDOS only supports 13 total
000000r 1                                              ;volumes for all devices, floppies, SCSI drives,
000000r 1                                              ;RAM drives, etc.
000000r 1               DEBUG  = FALSE
000000r 1               ;DEBUG  = TRUE
000000r 1               ;------------------------------------------------------------------------------
000000r 1               ; To enable debug output, set DEBUG = TRUE, only if you have a Apple Super
000000r 1               ; Serial card in slot 2. This will output one line of text for each request
000000r 1               ; made to the firmware, which can be seen on a computer or terminal attached to
000000r 1               ; the SSC.
000000r 1               ;
000000r 1               ; NOTE: If you use DEBUG=TRUE and you don't have an Apple Super Serial card in
000000r 1               ; slot 2, your computer might hang in the routine DSChar, waiting for
000000r 1               ; the SSC status bit to say it is okay to write to the 6551 UART.
000000r 1               ;
000000r 1               ; Set your terminal (software) at the remote end as follows:
000000r 1               ; BaudRate:      19200
000000r 1               ; Data Bits:     8
000000r 1               ; Parity:        None
000000r 1               ; Stop Bits:     1
000000r 1               ;
000000r 1               ; Example debug output at terminal from CAT command in ProDOS 8. Card is in
000000r 1               ; slot 6. ProDOS makes a ProDOS 8 call to the firmware to read block 2 from
000000r 1               ; unit: 60 into buffer memory at $DC00.
000000r 1               ;
000000r 1               ; P8: Rd B:0002 U:60 A$DC00 Chk$6711
000000r 1               ;
000000r 1               ; Rd = ProDOS Read ($01). Also could be Wr = write ($02), St = Status ($00)
000000r 1               ; U:60 = ProDOS 8 unit number $60  Slot 6, drive 1
000000r 1               ; A$DC00 = ProDOS buffer address
000000r 1               ; Chk$6711 = Simple block checksum used to visually check data integrity
000000r 1               ;
000000r 1               ; NOTE: When DEBUG is true, some zero-page locations are used. The data at
000000r 1               ; these locations are saved and restored and should not impact other programs.
000000r 1               
000000r 1               
000000r 1               ;------------------------------------------------------------------------------
000000r 1               ; Driver constant definitions
000000r 1               ;
000000r 1               INITDONESIG     EQU $A5           ;Device init is done signature value
000000r 1               CR              EQU $0D
000000r 1               BELL            EQU $07
000000r 1               
000000r 1               ; ProDOS request Constants
000000r 1               PRODOS_STATUS   EQU $00
000000r 1               PRODOS_READ     EQU $01
000000r 1               PRODOS_WRITE    EQU $02
000000r 1               PRODOS_FORMAT   EQU $03
000000r 1               
000000r 1               ;ProDOS Return Codes
000000r 1               PRODOS_NO_ERROR      EQU $00    ;No error
000000r 1               PRODOS_BADCMD        EQU $01    ;Bad Command (not implemented)
000000r 1               PRODOS_IO_ERROR      EQU $27    ;I/O error
000000r 1               PRODOS_NO_DEVICE     EQU $28    ;No Device Connected
000000r 1               PRODOS_WRITE_PROTECT EQU $2B    ;Write Protected
000000r 1               PRODOS_BADBLOCK      EQU $2D    ;Invalid block number requested
000000r 1               PRODOS_OFFLINE       EQU $2F    ;Device off-line
000000r 1               
000000r 1               ;SmartPort return codes
000000r 1               BAD_UNIT_NUMBER EQU $11
000000r 1               
000000r 1               ; ATA Commands Codes
000000r 1               ATACRead        EQU $20
000000r 1               ATACWrite       EQU $30
000000r 1               ATAIdentify     EQU $EC
000000r 1               
000000r 1               ;Constants for Wait
000000r 1               ; Constant = (Delay[in uS]/2.5 + 2.09)^.5 - 2.7
000000r 1               
000000r 1               WAIT_100ms      EQU 197
000000r 1               WAIT_40ms       EQU 124
000000r 1               WAIT_100us      EQU 4
000000r 1               ;------------------------------------------------------------------------------
000000r 1               ; Slot I/O definitions
000000r 1               ;
000000r 1               mslot           = $7F8          ;Apple defined location for the last active slot
000000r 1               
000000r 1               IOBase          = $C080
000000r 1               ATADataHigh     = IOBase+0
000000r 1               SetCSMask       = IOBase+1      ;Two special strobe locations to set and clear
000000r 1                                               ; MASK bit that is used to disable CS0 line to
000000r 1                                               ; the CompactFlash during the CPU read cycles
000000r 1               ClearCSMask     = IOBase+2      ; that occur before every CPU write cycle.
000000r 1                                               ; The normally innocuous read cycles were
000000r 1                                               ; causing the SanDisk CF to double increment
000000r 1                                               ; during sector writes commands.
000000r 1               
000000r 1               ATADevCtrl      = IOBase+6      ;when writing
000000r 1               ATAAltStatus    = IOBase+6      ;when reading
000000r 1               ATADataLow      = IOBase+8
000000r 1               ATAError        = IOBase+9
000000r 1               ATASectorCnt    = IOBase+10
000000r 1               ATASector       = IOBase+11
000000r 1               ATACylinder     = IOBase+12
000000r 1               ATACylinderH    = IOBase+13
000000r 1               ATAHead         = IOBase+14
000000r 1               ATACommand      = IOBase+15     ; when writing
000000r 1               ATAStatus       = IOBase+15     ; when reading
000000r 1               
000000r 1               ; Scratchpad RAM base addresses. Access using the Y register containg the slot #
000000r 1               ;
000000r 1               DriveResetDone  = $478          ;remember the device has been software reset
000000r 1               DriveNumber     = $4f8          ;normally 0 to 3 for four 32MB partitions
000000r 1               SerialInitDone  = $578          ;For debug: if $A5 then serial init is complete
000000r 1               DrvBlkCount0    = $5f8          ;low byte of usable block count
000000r 1                                               ; (excluding first BLOCKOFFSET blocks)
000000r 1               DrvBlkCount1    = $678          ;bits 8..15 of usable block count
000000r 1               DrvBlkCount2    = $6f8          ;bits 16..23 of usable block count
000000r 1               DrvMiscFlags    = $778          ;bit 7 = raw LBA block access
000000r 1               Available2      = $7f8          ;not currently used
000000r 1               
000000r 1               ;------------------------------------------------------------------------------
000000r 1               ; Zero-page RAM memory usage
000000r 1               
000000r 1               .IF DEBUG                       ;data at these locations saved and restored
000000r 1               MsgPointerLow   = $EB
000000r 1               MsgPointerHi    = $EC
000000r 1               CheckSumLow     = $ED
000000r 1               CheckSumHigh    = $EE
000000r 1               .ENDIF
000000r 1               
000000r 1               zpt1            = $EF           ;data at this location is saved/restored
000000r 1               
000000r 1               StackBase       = $100
000000r 1               
000000r 1               ; ProDOS block interface locations
000000r 1               pdCommandCode   = $42
000000r 1               pdUnitNumber    = $43
000000r 1               pdIOBuffer      = $44
000000r 1               pdIOBufferH     = $45
000000r 1               pdBlockNumber   = $46
000000r 1               pdBlockNumberH  = $47
000000r 1               
000000r 1               ; Arbitrary locations for Smartport data,
000000r 1               ;  these locations are saved/restored before exit.
000000r 1               spCommandCode   = pdCommandCode
000000r 1               
000000r 1               spParamList     = $48           ;2 bytes
000000r 1               spCmdList       = $4A           ;2 bytes
000000r 1               spCSCode        = $4C
000000r 1               spSlot          = $4D
000000r 1               spSlotX16       = $4E
000000r 1               spLastZP        = spSlotX16
000000r 1               
000000r 1               spZeroPgArea    = pdCommandCode ; $42
000000r 1               spZeroPgSize    = spLastZP-spZeroPgArea+1
000000r 1               
000000r 1               
000000r 1               ;------------------------------------------------------------------------------
000000r 1               ; Apple II ROM entry points
000000r 1               ;
000000r 1               ; We can use these at boot time, but not while handling a call through
000000r 1               ; our ProDOS or SmartPort entry points, as the ROM may not be available.
000000r 1               ;
000000r 1               SetVID          = $FE89
000000r 1               SetKBD          = $FE93
000000r 1               COUT            = $FDED
000000r 1               INIT            = $FB2F
000000r 1               HOME            = $FC58
000000r 1               ROMWAIT         = $FCA8
000000r 1               AppleSoft       = $E000
000000r 1               
000000r 1               ;------------------------------------------------------------------------------
000000r 1               ; Start of Peripheral Card ROM Space $Cn00 to $CnFF
000000r 1               ; A macro is used here so that this code can be easily duplicated for each slot
000000r 1               ; instead of by hand using the EPROM programmer. This is done because
000000r 1               ; the hardware does not overlay the C1xx address space at C2xx, C3xx, etc.
000000r 1               ; automatically. Instead the base address for the EPROM is $C000 but is enabled
000000r 1               ; only when a valid address in the range of $C100 to $CEFF is on the bus. This
000000r 1               ; allows for the development of slot specific behaviors in firmware, if desired.
000000r 1               ; Currently that is not being done, instead the same slot code is repeated for
000000r 1               ; every slot ROM space. Addresses $C000 to $C0FF are not decoded by the
000000r 1               ; hardware as it is Apple's internal I/O. Any access of $CF00 to $CFFF is
000000r 1               ; decoded by the card to reset the Expansion ROM flip-flop, but remember to
000000r 1               ; use always address $CFFF for that task.
000000r 1               
000000r 1               .macro  CnXX    SLOTADDR, SLOTx16, SLOT, SIGNATURE_BYTE_4
000000r 1                  .local P8DriverEntry
000000r 1                  .local P8Driver
000000r 1                  .local SmartPortEntry
000000r 1                  .local SPDriver
000000r 1                  .local Boot
000000r 1                  .local Error
000000r 1                  .local NotScanning
000000r 1                  .local wasteTime
000000r 1                  .local ErrorMsgDisplay
000000r 1                  .local msgLoop
000000r 1                  .local msgDone
000000r 1                  .local ErrorMessage
000000r 1               
000000r 1                  lda  #$20                    ;$20 is a signature for a drive to ProDOS
000000r 1                  ldx  #$00                    ;$00 "
000000r 1                  lda  #$03                    ;$03 "
000000r 1               
000000r 1               
000000r 1               
000000r 1                  .byte $A9
000000r 1                  .byte SIGNATURE_BYTE_4       ;If this byte has b7 set, the next instruction should be a bmi
000000r 1                  bpl  Boot                    ;NOTE: this must be a 2 byte instuction to keep the entry point offset correct
000000r 1               
000000r 1               ;------------------- Non-boot P8 driver entry point ---------------------
000000r 1               ;  The EPROM holding this code is decoded and mapped into $C100 to $CEFF,
000000r 1               ;  it is not nessecary to dynamically determine which slot we are in, as is
000000r 1               ;  common in card firmware. This code is in a MACRO and is located absolutely
000000r 1               ;  per slot. Any code in this MACRO that is not relocatable will have to be
000000r 1               ;  based on the MACROs parameters SLOTADDR, SLOTx16, SLOT.
000000r 1               
000000r 1               P8DriverEntry:
000000r 1                  jmp  P8Driver                ;located at $Cn0A for best compatibility
000000r 1               SmartPortEntry:                 ;By definition, SmartPort entry is 3 bytes
000000r 1                                               ; after ProDOS entry
000000r 1                  jmp  SPDriver
000000r 1               
000000r 1               Boot:
000000r 1                  ldy  #SLOT                   ;Y reg now has $0n for accessing scratchpad RAM
000000r 1                  ldx  #SLOTx16                ;X reg now has $n0 for indexing I/O
000000r 1                  lda  #>SLOTADDR              ;loads A with slot# we are in:$Cn
000000r 1                  sta  mslot                   ;Apple defined location reserved for last slot
000000r 1                                               ; active. MSLOT needs the form of $Cn
000000r 1                  bit  $cfff                   ;turn off expansion ROMs
000000r 1               
000000r 1               ;
000000r 1               ; Need to wait here (before CheckDevice) in case the CFFA RESET jumper
000000r 1               ; is enabled, or a Delkin Devices CF card never becomes ready.
000000r 1               ;
000000r 1                  ldy  #5
000000r 1               wasteTime:
000000r 1                  lda  #WAIT_100ms
000000r 1                  jsr  ROMWAIT
000000r 1                  dey
000000r 1                  bne  wasteTime
000000r 1                  ldy  #SLOT
000000r 1               
000000r 1                  jsr  CheckDevice
000000r 1                  bcs  Error
000000r 1               
000000r 1                  lda  #PRODOS_READ            ;Request: READ block
000000r 1                  sta  pdCommandCode
000000r 1                  lda  #0
000000r 1                  sta  pdIOBuffer              ;Into Location $800
000000r 1                  sta  pdBlockNumber           ;ProDOS block $0000 (the bootloader block)
000000r 1                  sta  pdBlockNumberH
000000r 1                  lda  #$08
000000r 1                  sta  pdIOBufferH
000000r 1                  stx  pdUnitNumber            ;From unit number: $n0 (where n=slot#),
000000r 1                                               ; so drive bit is always 0
000000r 1               
000000r 1                  jsr  P8Driver                ;Read bootloader from device's block 0 into
000000r 1                                               ; location $800
000000r 1                  bcs  Error                   ;Check for error during bootblock read
000000r 1               
000000r 1                  lda  $800                    ;Check the first byte of boot loader code.
000000r 1                  cmp  #$01                    ;If bootload code is there, this byte = $01
000000r 1                  bne  Error
000000r 1                  lda  $801                    ;If second byte is a 0, it's invalid
000000r 1                                               ; (we'd JMP to a BRK)
000000r 1                  beq  Error
000000r 1               
000000r 1                  ldx  pdUnitNumber            ;X should contain the unit number when jumping
000000r 1                                               ; to the bootloader
000000r 1                  jmp  $801                    ;No errors, jump to bootloader just read.
000000r 1               
000000r 1               
000000r 1               ; If any error occured, like drive not present, check to see if we are in a
000000r 1               ; boot scan, if so re-enter scan routine, else drop to Applesoft, aborting boot.
000000r 1               Error:
000000r 1                  lda  $00
000000r 1                  bne  NotScanning
000000r 1                  lda  $01
000000r 1                  cmp  mslot
000000r 1                  bne  NotScanning
000000r 1                  jmp  $FABA                   ;Re-enter Monitor's Autoscan Routine
000000r 1               
000000r 1               ;The boot code must have been called manually because we are not in a slot scan.
000000r 1               NotScanning:
000000r 1                  jsr  SetVID
000000r 1                  jsr  SetKBD
000000r 1               ;
000000r 1               ;Display error message
000000r 1               ;
000000r 1                  jsr  INIT             ;text mode, full screen, page 1
000000r 1                  jsr  HOME
000000r 1                  ldy  #0
000000r 1               msgLoop:
000000r 1                  lda  ErrorMessage,y
000000r 1                  beq  msgDone
000000r 1                  ora  #$80
000000r 1                  jsr  COUT
000000r 1                  iny
000000r 1                  jmp  msgLoop
000000r 1               msgDone:
000000r 1                  jmp  AppleSoft
000000r 1               
000000r 1               ErrorMessage:
000000r 1                  .byte CR,CR,CR,CR,CR
000000r 1                  .byte "CFFA: DEVICE MISSING, NOT FORMATTED,",CR
000000r 1                  .byte "OR INCOMPATIBLE.",CR
000000r 1               ; "vX.Y" built automatically:
000000r 1                  .byte "VER:",$30+(FIRMWARE_VER/16),".",$30+(FIRMWARE_VER & $F), " FOR 6502."
000000r 1               ; Beep, then end-of-message:
000000r 1                  .byte BELL,$00
000000r 1               
000000r 1               
000000r 1               ;------------------- Non-boot entry point for driver code -----------------
000000r 1               ;
000000r 1               ; Handle a ProDOS call
000000r 1               ;
000000r 1               ; Setup MSLOT, X and Y registers.
000000r 1               ; This must be done every time we enter this driver.
000000r 1               ;
000000r 1               P8Driver:
000000r 1                  ldy  #SLOT                   ;Y reg now has $0n for accessing scratchpad RAM
000000r 1                  ldx  #SLOTx16                ;X reg now has $n0 for indexing I/O
000000r 1                  lda  #>SLOTADDR              ;loads A with slot# we are in:$Cn(where n=slot#)
000000r 1                  sta  mslot                   ;Apple defined location reserved for last slot
000000r 1                                               ; active. MSLOT needs the form of $Cn
000000r 1                  bit  $cfff                   ;turn off other ROM that might be on
000000r 1                  sta  ClearCSMask,x           ;reset MASK bit in PLD for normal CS0 signaling
000000r 1                  jmp  P8AuxROM
000000r 1               
000000r 1               ;--------------------- SmartPort call handler code -----------------------
000000r 1               ;
000000r 1               ; Called from jmp at $Cn0D.
000000r 1               ; 1) Push a block of zero-page locations onto the stack, creating a work space.
000000r 1               ; 2) Get the request parameters that follow the call to this driver
000000r 1               ; 3) Using request parameters as pointers get request specific information
000000r 1               ;    and set up the P8 driver request registers $42-$47.
000000r 1               ; 4) Call P8Driver code
000000r 1               ; 5) On return from P8Driver code, restore zero page work space, and return to
000000r 1               ;    caller.
000000r 1               ;
000000r 1               SPDriver:
000000r 1                  lda  #>SLOTADDR
000000r 1                  sta  mslot
000000r 1                  bit  $cfff
000000r 1               
000000r 1                  ldx  #SLOTx16                ;X reg now has $n0 for indexing I/O
000000r 1                  sta  ClearCSMask,x           ;reset MASK bit in PLD for normal CS0 signaling
000000r 1                  jmp  SPAuxROM
000000r 1               
000000r 1               
000000r 1                  .RES   SLOTADDR+$F5-*        ;skip to $CnF5, where n is the slot#
000000r 1               
000000r 1                  .byte  GSOS_DRIVER           ;GS/OS driver compatibility byte. GS/OS driver
000000r 1                                               ; checks this byte to see if it is compatible
000000r 1                                               ; with this version of firmware. This way,
000000r 1                                               ; changes to firware versions, that do not
000000r 1                                               ; affect the GS/OS driver will not prevent the
000000r 1                                               ; GS/OS driver from loading and running. This
000000r 1                                               ; byte should be incremented each time a change
000000r 1                                               ; is made that would prevent the GS/OS driver
000000r 1                                               ; from working correctly. I.e. Partition layout
000000r 1                                               ; or something similar.
000000r 1               
000000r 1                  .byte "CFFA", FIRMWARE_VER   ;$CnF6..CnFA: Card Hardware ID,
000000r 1                                               ; non-standard scheme
000000r 1               
000000r 1               ;$CnFB: SmartPort status byte
000000r 1                  .byte $0                     ; Not Extended; not SCSI; not RAM card
000000r 1                                               ; Even if not supporting SmartPort, we need a
000000r 1                                               ; zero at $CnFB so Apple's RAMCard driver
000000r 1                                               ; doesn't mistake us for a "Slinky" memory
000000r 1                                               ; card.
000000r 1               
000000r 1               ; Data table for ProDOS drive scan
000000r 1               ; $CnFC/FD = disk capacity, if zero use status command to determine
000000r 1                  .word $0000                  ;$CnFC-D: A zero here will cause prodos to
000000r 1                                               ; rely on the status command to determine volume size
000000r 1               
000000r 1               ; $CnFE = status bits (BAP p7-14)
000000r 1               ;  7 = medium is removable
000000r 1               ;  6 = device is interruptable
000000r 1               ;  5-4 = number of volumes (0..3 means 1..4)
000000r 1               ;  3 = device supports Format call
000000r 1               ;  2 = device can be written to
000000r 1               ;  1 = device can be read from (must be 1)
000000r 1               ;  0 = device status can be read (must be 1)
000000r 1                  .byte %00010111              ; $CnFE: support 2 ProDOS drives
000000r 1               
000000r 1               ; $CnFF = LSB of block driver
000000r 1                  .byte <P8DriverEntry         ; $CnFF: low-order offset to ProDOS entry point
000000r 1               
000000r 1               .endmacro
000000r 1               ;
000000r 1               ; Because the base address for this eprom is $C000. NOTE: Although it does NOT
000000r 1               ; get enable for addresses in the $C000 to C0FF range, we still need a 1 page
000000r 1               ; offset to get the code at the correct location.
000000r 1               ;
000000r 1  FF FF FF FF  .RES $100, $FF
000004r 1  FF FF FF FF  
000008r 1  FF FF FF FF  
000100r 1               
000100r 1               ;
000100r 1               ; Parameters for following macros:
000100r 1               ; CnXX SLOTADDR, SLOTx16, SLOT, SIGNATURE_BYTE_4
000100r 1               ; A signature byte of $3C is same as Disk ][, and turns smartport support off, and allows autoboot on ][+, ][e.
000100r 1               ; A signature byte of $00 signals smartport support, allow 4 drives in slot 5, but disable autoboot on ][+, ][e.
000100r 1               
000100r 1               .ORG $C100
00C100  1  A9 20 A2 00     CnXX $C100, $10, $01, $3C         ;Slot PROM code for slot 1. SmartPort disabled. Autoboot.
00C104  1  A9 03 A9 3C  
00C108  1  10 06 4C D0  
00C200  1               
00C200  1               .ORG $C200
00C200  1  A9 20 A2 00     CnXX $C200, $20, $02, $3C         ;Slot PROM code for slot 2. SmartPort disabled. Autoboot.
00C204  1  A9 03 A9 3C  
00C208  1  10 06 4C D0  
00C300  1               
00C300  1               .ORG $C300
00C300  1  A9 20 A2 00     CnXX $C300, $30, $03, $3C         ;Slot PROM code for slot 3. SmartPort disabled. Autoboot.
00C304  1  A9 03 A9 3C  
00C308  1  10 06 4C D0  
00C400  1               
00C400  1               .ORG $C400
00C400  1  A9 20 A2 00     CnXX $C400, $40, $04, $3C         ;Slot PROM code for slot 4. SmartPort disabled. Autoboot.
00C404  1  A9 03 A9 3C  
00C408  1  10 06 4C D0  
00C500  1               
00C500  1               .ORG $C500
00C500  1  A9 20 A2 00     CnXX $C500, $50, $05, $00         ;Slot PROM code for slot 5. SmartPort enabled. No Autoboot.
00C504  1  A9 03 A9 00  
00C508  1  10 06 4C D0  
00C600  1               
00C600  1               .ORG $C600
00C600  1  A9 20 A2 00     CnXX $C600, $60, $06, $3C         ;Slot PROM code for slot 6. SmartPort disabled. Autoboot.
00C604  1  A9 03 A9 3C  
00C608  1  10 06 4C D0  
00C700  1               
00C700  1               .listbytes      unlimited            ;Show all of the code bytes for the 7th slot
00C700  1               .ORG $C700
00C700  1  A9 20 A2 00     CnXX $C700, $70, $07, $3C         ;Slot PROM code for slot 7. SmartPort disabled. Autoboot.
00C704  1  A9 03 A9 3C  
00C708  1  10 06 4C D0  
00C70C  1  C7 4C E2 C7  
00C710  1  A0 07 A2 70  
00C714  1  A9 C7 8D F8  
00C718  1  07 2C FF CF  
