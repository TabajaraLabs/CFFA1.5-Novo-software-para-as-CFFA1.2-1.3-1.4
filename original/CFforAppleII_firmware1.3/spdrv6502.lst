00CBEC  1  91 44           sta  (pdIOBuffer),y
00CBEE  1  C8              iny
00CBEF  1               
00CBEF  1               .IF DEBUG
00CBEF  1                  clc
00CBEF  1                  adc  CheckSumLow
00CBEF  1                  sta  CheckSumLow
00CBEF  1               .ENDIF
00CBEF  1               
