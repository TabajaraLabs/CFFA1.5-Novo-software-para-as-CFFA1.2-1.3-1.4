00C800  1               
00C800  1               .listbytes      12              ;revert back to normal listing mode for the rest
00C800  1               
00C800  1               ;-------------------- End of Peripheral Card ROM Space ----------------------
00C800  1               
00C800  1               
00C800  1               ;--------------------- Start of I/O expansion ROM Space --------------------
00C800  1               ; Code here starts at $c800
00C800  1               ; This code area is absolute and can use absolute addressing
00C800  1               .ORG   $C800                    ;note: .ORG does not cause this code to be
00C800  1                                               ; placed at C800. The ".RES" statement above
00C800  1                                               ; offsets this code
00C800  1               
00C800  1               
00C800  1               ;------------------------------------------------------------------------------
00C800  1               ; SmartPort
00C800  1               ;
00C800  1               ;------------------------------------------------------------------------------
00C800  1               MagicRawBlocksUnit EQU 127      ;use unit 127 in ReadBlock/WriteBlock calls for
00C800  1                                               ; raw LBA blocks.
00C800  1               
00C800  1               SPAuxROM:
00C800  1               ; save  ZP, fetch cmd + pointer from (PC)
00C800  1  A0 0C           ldy  #spZeroPgSize-1
00C802  1               save:
00C802  1  B9 42 00        lda  spZeroPgArea,y
00C805  1  48              pha
00C806  1  88              dey
00C807  1  10 F9           bpl  save
00C809  1  BA              tsx
00C80A  1  BD 0E 01        lda  $101+spZeroPgSize,x
00C80D  1  85 48           sta  spParamList
00C80F  1  18              clc
00C810  1  69 03           adc  #3
00C812  1  9D 0E 01        sta  $101+spZeroPgSize,x
00C815  1  BD 0F 01        lda  $102+spZeroPgSize,x
00C818  1  85 49           sta  spParamList+1
00C81A  1  69 00           adc  #0
00C81C  1  9D 0F 01        sta  $102+spZeroPgSize,x
00C81F  1               
00C81F  1               ; set up spSlot and spSlotX16
00C81F  1  AD F8 07        lda  mslot
00C822  1  29 0F           and  #$0f
00C824  1  A8              tay
00C825  1  0A              asl  a
00C826  1  0A              asl  a
00C827  1  0A              asl  a
00C828  1  0A              asl  a
00C829  1  AA              tax
00C82A  1  84 4D           sty  spSlot
00C82C  1  86 4E           stx  spSlotX16
00C82E  1               
00C82E  1               ; clear DrvMiscFlags
00C82E  1  A9 00           lda  #0
00C830  1  99 78 07        sta  DrvMiscFlags,y          ;no special flags (such as raw block access)
00C833  1               
00C833  1               ; reset the device if this is our first call
00C833  1  20 C4 CA        jsr  ResetDriveIfFirstTime   ;needs Y
00C836  1               
00C836  1               .IF DEBUG
00C836  1               ;warning this debug code trashes the Acc register
00C836  1                  jsr  DSString
00C836  1                  .byte "SP:",0
00C836  1               .ENDIF
00C836  1               
00C836  1               ; get command code from parameter list
00C836  1  A0 01           ldy  #1
00C838  1  B1 48           lda  (spParamList),y
00C83A  1  85 42           sta  spCommandCode
00C83C  1  C8              iny
00C83D  1  B1 48           lda  (spParamList),y
00C83F  1  AA              tax
00C840  1  C8              iny
00C841  1  B1 48           lda  (spParamList),y
00C843  1  85 49           sta  spParamList+1
00C845  1  86 48           stx  spParamList
00C847  1               
00C847  1  A9 01           lda  #PRODOS_BADCMD          ;anticipate bad command error
00C849  1  A6 42           ldx  spCommandCode
00C84B  1  E0 0A           cpx  #$09+1                  ;command too large
00C84D  1  B0 21           bcs  out
00C84F  1               
00C84F  1  A0 00           ldy  #0
00C851  1  B1 48           lda  (spParamList),y         ;parameter count
00C853  1  DD 8D C8        cmp  RequiredParamCounts,x   ;command number still in X
00C856  1  F0 05           beq  pCountOK
00C858  1               
00C858  1  A9 04           lda  #$04                    ;bad parameter count error
00C85A  1  4C 70 C8        jmp  out
00C85D  1               
00C85D  1               pCountOK:
00C85D  1  A0 01           ldy  #1
00C85F  1  B1 48           lda  (spParamList),y
00C861  1  A4 4D           ldy  spSlot
00C863  1  99 F8 04        sta  DriveNumber,y
00C866  1               
00C866  1  8A              txa                            ;X is still the command code
00C867  1  0A              asl  a
00C868  1  AA              tax
00C869  1  20 84 C8        jsr  JumpToSPCommand           ;Y is still spSlot
00C86C  1               
00C86C  1  B0 02           bcs  out
00C86E  1  A9 00           lda  #0
00C870  1               
00C870  1               out:
00C870  1  AA              tax                           ;error code in X
00C871  1               
00C871  1               ; Restore zero page
00C871  1  A0 00           ldy  #0
00C873  1               restore:
00C873  1  68              pla
00C874  1  99 42 00        sta  spZeroPgArea,y
00C877  1  C8              iny
00C878  1  C0 0D           cpy  #spZeroPgSize
00C87A  1  90 F7           bcc  restore
00C87C  1               
00C87C  1  8A              txa
00C87D  1  A0 02           ldy  #2                      ;high byte of # bytes transferred
00C87F  1                                               ; (always (1) undefined, or
00C87F  1                                               ; (2) #bytes transferred to host)
00C87F  1  A2 00           ldx  #0                      ;low byte of # bytes transferred
00C881  1  C9 01           cmp  #1                      ;C=1 if error code nonzero
00C883  1  60              rts
00C884  1               
00C884  1               JumpToSPCommand:
00C884  1  BD 98 C8        lda  spDispatch+1,x
00C887  1  48              pha
00C888  1  BD 97 C8        lda  spDispatch,x
00C88B  1  48              pha
00C88C  1  60              rts
00C88D  1               
00C88D  1               RequiredParamCounts:
00C88D  1  03              .byte 3   ;0 = status
00C88E  1  03              .byte 3   ;1 = read
00C88F  1  03              .byte 3   ;2 = write
00C890  1  01              .byte 1   ;3 = format
00C891  1  03              .byte 3   ;4 = control
00C892  1  01              .byte 1   ;5 = init
00C893  1  01              .byte 1   ;6 = open
00C894  1  01              .byte 1   ;7 = close
00C895  1  04              .byte 4   ;8 = read
00C896  1  04              .byte 4   ;9 = write
00C897  1               
00C897  1               spDispatch:
00C897  1  AA C8           .word spStatus-1
00C899  1  C3 C9           .word spReadBlock-1
00C89B  1  D0 C9           .word spWriteBlock-1
00C89D  1  DC C9           .word spFormat-1
00C89F  1  DF C9           .word spControl-1
00C8A1  1  03 CA           .word spInit-1
00C8A3  1  0E CA           .word spOpen-1
00C8A5  1  0E CA           .word spClose-1
00C8A7  1  12 CA           .word spReadChars-1
00C8A9  1  12 CA           .word spWriteChars-1
00C8AB  1               
00C8AB  1               ;------------------------------------------------------------------------------
00C8AB  1               ; SmartPort STATUS call
00C8AB  1               ;
00C8AB  1               ; We support the standard calls, plus an "Identify" command
00C8AB  1               ; for unit 0, which fills a buffer with the card's Identify
00C8AB  1               ; data.
00C8AB  1               ;
00C8AB  1               spStatus:
00C8AB  1  20 17 CA        jsr  SPSetupControlOrStatus
00C8AE  1  B0 36           bcs  statOut
00C8B0  1               
00C8B0  1  A4 4D           ldy  spSlot
00C8B2  1  B9 F8 04        lda  DriveNumber,y
00C8B5  1  D0 37           bne  StatusForOneUnit
00C8B7  1               
00C8B7  1               ; StatusCode = 0 && unit == 0: status for this entire SmartPort interface
00C8B7  1  A5 4C           lda  spCSCode
00C8B9  1  F0 0B           beq  Status00
00C8BB  1               
00C8BB  1               ; Status for unit 0, subcode $49 = Identify (device-specific subcode)
00C8BB  1  C9 49           cmp  #$49
00C8BD  1  D0 03           bne  BadStatusCode
00C8BF  1  4C 55 C9        jmp  spStatusIdentify
00C8C2  1               
00C8C2  1               ; Any other status code for unit 0 is an error.
00C8C2  1               BadStatusCode:
00C8C2  1  A9 21           lda  #$21
00C8C4  1  38              sec
00C8C5  1  60              rts
00C8C6  1               
00C8C6  1               Status00:
00C8C6  1  A6 4E           ldx  spSlotX16
00C8C8  1  A4 4D           ldy  spSlot
00C8CA  1  20 ED CA        jsr  GetStatus
00C8CD  1  B0 17           bcs  statOut
00C8CF  1               
00C8CF  1  A4 4D           ldy  spSlot
00C8D1  1  B9 F8 06        lda  DrvBlkCount2,y
00C8D4  1  18              clc
00C8D5  1  69 01           adc  #1
00C8D7  1  A0 00           ldy  #0
00C8D9  1  91 4A           sta  (spCmdList),y           ;byte +0 = number of drives
00C8DB  1               
00C8DB  1  A0 07           ldy  #7
00C8DD  1               Stat00Loop:
00C8DD  1  B9 E6 C8        lda  Stat00Data-1,y
00C8E0  1  91 4A           sta  (spCmdList),y
00C8E2  1  88              dey
00C8E3  1  D0 F8           bne  Stat00Loop
00C8E5  1  18              clc
00C8E6  1               statOut:
00C8E6  1  60              rts
00C8E7  1               
00C8E7  1               Stat00Data:
00C8E7  1  40              .byte $40                    ;Interrupt flag = no interrupts caused by this
00C8E8  1                                               ; interface
00C8E8  1               
00C8E8  1  00 CC           .word $CC00                  ;Vendor ID assigned to Rich Dreher by
00C8EA  1                                               ; www.syndicomm.com 3/16/2002
00C8EA  1               
00C8EA  1  00 12           .word SPDRIVERVERSION        ;Our version number
00C8EC  1  00              .byte $00                    ;Reserved byte
00C8ED  1  00              .byte $00                    ;Reserved byte
00C8EE  1               
00C8EE  1               StatusForOneUnit:
00C8EE  1  18              clc
00C8EF  1  E9 01           sbc  #1
00C8F1  1  99 F8 04        sta  DriveNumber,y
00C8F4  1               
00C8F4  1  A6 4C           ldx  spCSCode
00C8F6  1  F0 18           beq  Status0or3
00C8F8  1  CA              dex
00C8F9  1  F0 08           beq  StatusGetDCB
00C8FB  1  CA              dex
00C8FC  1  CA              dex
00C8FD  1  F0 11           beq  Status0or3
00C8FF  1  A9 21           lda  #$21                    ;Bad status code
00C901  1  38              sec
00C902  1  60              rts
00C903  1               ;
00C903  1               ; We have no interesting data to return for the device control
00C903  1               ; block, so return the shortest one allowed: a length byte of
00C903  1               ; 1 followed by a data byte of 0.
00C903  1               ;
00C903  1               StatusGetDCB:
00C903  1  A9 01           lda  #1
00C905  1  A0 00           ldy  #0
00C907  1  91 4A           sta  (spCmdList),y           ;Returned length = 1
00C909  1  A8              tay
00C90A  1  A9 00           lda  #0
00C90C  1  91 4A           sta  (spCmdList),y           ;Returned data = $00
00C90E  1  18              clc
00C90F  1  60              rts
00C910  1               
00C910  1               ;
00C910  1               ; Status code 0 and 3 start off the same; 3 returns extra data.
00C910  1               ;
00C910  1               ; 0: return device status (1 byte device status + 3-byte block count)
00C910  1               ; 3: return Device Information Block
00C910  1               ;
00C910  1               Status0or3:
00C910  1  A9 F8           lda  #$F8                    ;Block device, write, read, format, online,
00C912  1                                               ; not write-prot
00C912  1  A0 00           ldy  #0
00C914  1  91 4A           sta  (spCmdList),y
00C916  1  A6 4E           ldx  spSlotX16
00C918  1  A4 4D           ldy  spSlot
00C91A  1  20 ED CA        jsr  GetStatus               ;Returns block count in YX
00C91D  1  B0 C7           bcs  statOut
00C91F  1               
00C91F  1  98              tya
00C920  1  A0 02           ldy  #2
00C922  1  91 4A           sta  (spCmdList),y           ;CmdList +2 = bits 8..15 of block count
00C924  1  88              dey
00C925  1  8A              txa                          ;CmdList +1 = bits 0..7 of block count
00C926  1  91 4A           sta  (spCmdList),y
00C928  1  A0 03           ldy  #3
00C92A  1  A9 00           lda  #0
00C92C  1  91 4A           sta  (spCmdList),y           ;CmdList +3 = bits 16..23 of block count
00C92E  1               
00C92E  1  A5 4C           lda  spCSCode
00C930  1  F0 0C           beq  statDone
00C932  1               
00C932  1               ; status code 3: return 21 more bytes of data
00C932  1  A0 04           ldy #4
00C934  1               stat3Loop:
00C934  1  B9 3C C9        lda  stat3Data-4,y
00C937  1  91 4A           sta  (spCmdList),y
00C939  1  C8              iny
00C93A  1  C0 19           cpy  #21+4
00C93C  1  90 F6           bcc  stat3Loop
00C93E  1               
00C93E  1               statDone:
00C93E  1  18              clc
00C93F  1  60              rts
00C940  1               
00C940  1               stat3Data:
00C940  1  0D 43 4F 4D     .byte 13,"COMPACT FLASH   "  ;length byte + 16-byte ASCII, padded
00C944  1  50 41 43 54  
00C948  1  20 46 4C 41  
00C951  1  02              .byte $02                    ;device type = hard disk
00C952  1  20              .byte $20                    ;subtype (no removable media, no extended,
00C953  1                                               ; no disk switched)
00C953  1  00 12           .word SPDRIVERVERSION
00C955  1               
00C955  1               ;------------------------------------------------------------------------------
00C955  1               ; Identify (Status subcode)
00C955  1               ;
00C955  1               ; The status list is a 512-byte buffer that we will fill with
00C955  1               ; the drive's IDE "Identify" data.  We post-process the data
00C955  1               ; by byte-swapping the model name and serial number strings
00C955  1               ; so they make sense.
00C955  1               ;
00C955  1               spStatusIdentify:
00C955  1  A4 4D           ldy  spSlot
00C957  1  A6 4E           ldx  spSlotX16
00C959  1  20 9F CC        jsr  CheckDevice
00C95C  1  90 03           bcc  ident1
00C95E  1  A9 28           lda  #PRODOS_NO_DEVICE
00C960  1  60              rts                          ;return error code in Acc with Carry set
00C961  1               
00C961  1               ident1:
00C961  1  A9 00           lda  #0
00C963  1  9D 80 C0        sta  ATADataHigh,x
00C966  1               
00C966  1  A9 EC           lda  #ATAIdentify
00C968  1  9D 8F C0        sta  ATACommand,x            ;Issue the read command to the drive
00C96B  1  20 95 CC        jsr  IDEWaitReady            ;Wait for BUSY flag to go away
00C96E  1               
00C96E  1  BD 8F C0        lda  ATAStatus,x             ;Check for error response
00C971  1  29 09           and  #$09
00C973  1  C9 01           cmp  #$01                    ;if DRQ=0 and ERR=1 an error occured
00C975  1  D0 04           bne  iCommandOK
00C977  1               
00C977  1               iError:
00C977  1               .IF DEBUG
00C977  1               ;warning this debug code trashes the Acc register
00C977  1                  jsr DSString
00C977  1                  .byte "spIdfy Err:",0
00C977  1                  lda  ATAError,x
00C977  1                  jsr  DSByteCRLF
00C977  1               .ENDIF
00C977  1               
00C977  1  A9 27           lda  #PRODOS_IO_ERROR
00C979  1  38              sec
00C97A  1  60              rts                          ;return error code in Acc with Carry set
00C97B  1               ;
00C97B  1               ; The "Identify" data is ready to read
00C97B  1               ;
00C97B  1               pageCount = spCommandCode       ;re-use a zero-page location
00C97B  1               
00C97B  1               iCommandOK:
00C97B  1  A0 02           ldy  #2
00C97D  1  84 42           sty  pageCount
00C97F  1  A0 00           ldy  #0
00C981  1               iLoop:
00C981  1  BD 8F C0        lda  ATAStatus,x             ;Note: not using IDEWaitReady, inline code
00C984  1                                               ; instead
00C984  1  30 FB           bmi  iLoop                   ;Wait for BUSY (bit 7) to be zero
00C986  1  29 08           and  #$08                    ;get DRQ status bit
00C988  1  F0 ED           beq  iError                  ;if off, didn't get enough data
00C98A  1               
00C98A  1  BD 88 C0        lda  ATADataLow,x
00C98D  1  91 4A           sta  (spCmdList),y
00C98F  1  C8              iny
00C990  1  BD 80 C0        lda  ATADataHigh,x
00C993  1  91 4A           sta  (spCmdList),y
00C995  1  C8              iny
00C996  1  D0 E9           bne  iLoop
00C998  1  E6 4B           inc  spCmdList+1
00C99A  1  C6 42           dec  pageCount
00C99C  1  D0 E3           bne  iLoop
00C99E  1               
00C99E  1               ; Swap ASCII text data of the Identify data to be more readable.
00C99E  1               ; These are both on the first page of the data.
00C99E  1               
00C99E  1  C6 4B           dec  spCmdList+1
00C9A0  1  C6 4B           dec  spCmdList+1             ;Point to beginning of buffer
00C9A2  1               
00C9A2  1  A0 2E           ldy  #23*2                   ;Start at word 23 (firmware rev, model number)
00C9A4  1  A2 18           ldx  #24                     ;24 words
00C9A6  1  20 B2 C9        jsr  SwapBytes
00C9A9  1               
00C9A9  1  A0 14           ldy  #10*2                   ;Start at word 10 (serial number)
00C9AB  1  A2 0A           ldx  #10                     ;10 words
00C9AD  1  20 B2 C9        jsr  SwapBytes
00C9B0  1               
00C9B0  1  18              clc
00C9B1  1  60              rts
00C9B2  1               
00C9B2  1               ;------------------------------------------------------------------------------
00C9B2  1               SwapBytes:
00C9B2  1  B1 4A           lda  (spCmdList),y
00C9B4  1  48              pha                          ;Save the 1st byte
00C9B5  1  C8              iny
00C9B6  1  B1 4A           lda  (spCmdList),y           ;Get the 2nd byte
00C9B8  1  88              dey
00C9B9  1  91 4A           sta  (spCmdList),y           ;Store it in position 1
00C9BB  1  C8              iny
00C9BC  1  68              pla                          ;Finally, retrieve the 1st byte
00C9BD  1  91 4A           sta  (spCmdList),y           ;Put it in position 2
00C9BF  1  C8              iny
00C9C0  1  CA              dex
00C9C1  1  D0 EF           bne  SwapBytes
00C9C3  1  60              rts
00C9C4  1               
00C9C4  1               ;------------------------------------------------------------------------------
00C9C4  1               ; SmartPort READ BLOCK command
00C9C4  1               ;
00C9C4  1               spReadBlock:
00C9C4  1  20 29 CA        jsr  SPSetupReadWrite
00C9C7  1  B0 07           bcs  readDone
00C9C9  1               
00C9C9  1  A4 4D           ldy  spSlot
00C9CB  1  A6 4E           ldx  spSlotX16
00C9CD  1  4C A8 CB        jmp  ReadBlock
00C9D0  1               
00C9D0  1               readDone:
00C9D0  1               writeDone:
00C9D0  1  60              rts
00C9D1  1               
00C9D1  1               ;------------------------------------------------------------------------------
00C9D1  1               ; SmartPort WRITE BLOCK command
00C9D1  1               ;
00C9D1  1               spWriteBlock:
00C9D1  1  20 29 CA        jsr SPSetupReadWrite
00C9D4  1  B0 FA           bcs writeDone
00C9D6  1               
00C9D6  1  A4 4D           ldy spSlot
00C9D8  1  A6 4E           ldx spSlotX16
00C9DA  1  4C 05 CC        jmp WriteBlock
00C9DD  1               
00C9DD  1               ;------------------------------------------------------------------------------
00C9DD  1               ; SmartPort FORMAT command
00C9DD  1               ;
00C9DD  1               ; We don't actually do anything beyond validating the unit number.
00C9DD  1               ;
00C9DD  1               spFormat:
00C9DD  1  4C 74 CA        jmp SPValidateUnitNumber
00C9E0  1               
00C9E0  1               ;------------------------------------------------------------------------------
00C9E0  1               ; SmartPort CONTROL command
00C9E0  1               ;
00C9E0  1               spControl:
00C9E0  1  20 17 CA        jsr SPSetupControlOrStatus
00C9E3  1  B0 18           bcs ctrlDone
00C9E5  1               
00C9E5  1  20 74 CA        jsr SPValidateUnitNumber
00C9E8  1  B0 13           bcs ctrlDone
00C9EA  1               
00C9EA  1  A6 4C           ldx spCSCode
00C9EC  1  F0 14           beq ctlReset                 ;Control code 0 = Reset
00C9EE  1  CA              dex
00C9EF  1  F0 11           beq ctlSetDCB                ;Control code 1 = SetDCB
00C9F1  1  CA              dex
00C9F2  1  F0 06           beq ctlSetNewline            ;Control code 2 = SetNewline
00C9F4  1  CA              dex
00C9F5  1  F0 07           beq ctlServiceInterrupt      ;Control code 3 = ServiceInterrupt
00C9F7  1  CA              dex
00C9F8  1  F0 08           beq ctlEject                 ;Control code 4 = Eject
00C9FA  1               
00C9FA  1               ctlSetNewline:
00C9FA  1  A9 21           lda #$21                     ;Bad control code
00C9FC  1  38              sec
00C9FD  1               ctrlDone:
00C9FD  1  60              rts
00C9FE  1               
00C9FE  1               ctlServiceInterrupt:
00C9FE  1  A9 1F           lda #$1f                     ;Interrupt devices not supported
00CA00  1  38              sec
00CA01  1  60              rts
00CA02  1               
00CA02  1               ctlReset:
00CA02  1               ctlSetDCB:
00CA02  1               ctlEject:
00CA02  1  18              clc
00CA03  1  60              rts
00CA04  1               
00CA04  1               ;------------------------------------------------------------------------------
00CA04  1               ; SmartPort INIT command
00CA04  1               ;
00CA04  1               ; unit 0 = entire chain
00CA04  1               ;
00CA04  1               ;  SmartPort Technote #2 says you can't init an individual unit;
00CA04  1               ;  so return error if DriveNumber is nonzero.
00CA04  1               ;
00CA04  1               spInit:
00CA04  1  B9 F8 04        lda DriveNumber,y
00CA07  1  F0 04           beq initChain
00CA09  1  A9 11           lda #BAD_UNIT_NUMBER
00CA0B  1  38              sec
00CA0C  1  60              rts
00CA0D  1               
00CA0D  1               initChain:
00CA0D  1  18              clc
00CA0E  1  60              rts
00CA0F  1               
00CA0F  1               
00CA0F  1               ;------------------------------------------------------------------------------
00CA0F  1               ; SmartPort: Open and Close are for character devices only
00CA0F  1               ;
00CA0F  1               spOpen:
00CA0F  1               spClose:
00CA0F  1  A9 01           lda #PRODOS_BADCMD
00CA11  1  38              sec
00CA12  1  60              rts
00CA13  1               
00CA13  1               ;------------------------------------------------------------------------------
00CA13  1               ; SmartPort: Read, Write
00CA13  1               ;
00CA13  1               ; We don't bother implementing Read and Write, although they are allowed
00CA13  1               ; for block devices.  We would only support 512-byte transfers anyway.
00CA13  1               ;
00CA13  1               spReadChars:
00CA13  1               spWriteChars:
00CA13  1  A9 27           lda #PRODOS_IO_ERROR
00CA15  1  38              sec
00CA16  1  60              rts
00CA17  1               
00CA17  1               
00CA17  1               ;------------------------------------------------------------------------------
00CA17  1               ; SPSetupControlOrStatus
00CA17  1               ;
00CA17  1               ; fetch from parameter block:
00CA17  1               ;    status/control list pointer (word)
00CA17  1               ;    status/control code (byte)
00CA17  1               ;
00CA17  1               SPSetupControlOrStatus:
00CA17  1  A0 02           ldy #2
00CA19  1  B1 48           lda (spParamList),y
00CA1B  1  85 4A           sta spCmdList
00CA1D  1  C8              iny
00CA1E  1  B1 48           lda (spParamList),y
00CA20  1  85 4B           sta spCmdList+1
00CA22  1  C8              iny
00CA23  1  B1 48           lda (spParamList),y
00CA25  1  85 4C           sta spCSCode
00CA27  1  18              clc
00CA28  1  60              rts
00CA29  1               
00CA29  1               ;------------------------------------------------------------------------------
00CA29  1               ; SPSetupReadWrite
00CA29  1               ;
00CA29  1               ; Input:
00CA29  1               ;    DriveNumber,y is already a copy of SmartPort unit number
00CA29  1               ;
00CA29  1               ; fetch from SP parameter list:
00CA29  1               ;   buffer pointer
00CA29  1               ;   block number
00CA29  1               ;
00CA29  1               ; Validate unit number:
00CA29  1               ;   127 = magic, allow any block number
00CA29  1               ;   1..N:  Validate block number: $0..FFFE
00CA29  1               ;
00CA29  1               ; DriveNumber,y: translated unit number in case unit was magic
00CA29  1               ; DrvMiscFlags: bit 7 set if we should not use BLOCKOFFSET
00CA29  1               ;
00CA29  1               SPSetupReadWrite:
00CA29  1               ; copy pdIOBuffer from parameter list
00CA29  1  A0 02           ldy #2
00CA2B  1  B1 48           lda (spParamList),y
00CA2D  1  85 44           sta pdIOBuffer
00CA2F  1  C8              iny
00CA30  1  B1 48           lda (spParamList),y
00CA32  1  85 45           sta pdIOBuffer+1
00CA34  1               
00CA34  1               ; copy pdBlockNumber from parameter list
00CA34  1  C8              iny
00CA35  1  B1 48           lda (spParamList),y
00CA37  1  85 46           sta pdBlockNumber
00CA39  1  C8              iny
00CA3A  1  B1 48           lda (spParamList),y
00CA3C  1  85 47           sta pdBlockNumber+1
00CA3E  1               
00CA3E  1               ; Validate the unit number and block number.
00CA3E  1  A4 4D           ldy spSlot
00CA40  1  B9 F8 04        lda DriveNumber,y
00CA43  1  C9 7F           cmp #MagicRawBlocksUnit
00CA45  1  F0 1A           beq magicUnit
00CA47  1               
00CA47  1  20 74 CA        jsr SPValidateUnitNumber
00CA4A  1  B0 14           bcs srwOut
00CA4C  1               
00CA4C  1  A0 06           ldy #6
00CA4E  1  B1 48           lda (spParamList),y          ;Bits 16..23 of block number must be $00
00CA50  1  D0 0B           bne badBlockNum
00CA52  1               
00CA52  1  A5 47           lda pdBlockNumber+1          ;Block $FFFF is invalid
00CA54  1  25 46           and pdBlockNumber
00CA56  1  18              clc
00CA57  1  69 01           adc #1
00CA59  1  F0 02           beq badBlockNum
00CA5B  1  18              clc
00CA5C  1  60              rts
00CA5D  1               
00CA5D  1               badBlockNum:
00CA5D  1  A9 2D           lda #PRODOS_BADBLOCK         ;Bad block number
00CA5F  1  38              sec
00CA60  1               srwOut:
00CA60  1  60              rts
00CA61  1               ;
00CA61  1               ; For the "magic raw blocks" unit, allow a full 3-byte block number.
00CA61  1               ;
00CA61  1               magicUnit:
00CA61  1  A9 80           lda #$80
00CA63  1  19 78 07        ora DrvMiscFlags,y
00CA66  1  99 78 07        sta DrvMiscFlags,y           ;Raw block access
00CA69  1               
00CA69  1  A0 06           ldy #6
00CA6B  1  B1 48           lda (spParamList),y          ;Bits 16..23 of block number
00CA6D  1  A4 4D           ldy spSlot
00CA6F  1  99 F8 04        sta DriveNumber,y
00CA72  1  18              clc
00CA73  1  60              rts
00CA74  1               
00CA74  1               ;------------------------------------------------------------------------------
00CA74  1               ; SPValidateUnitNumber
00CA74  1               ;
00CA74  1               ; Validate that DriveNumber is from 1 to N.
00CA74  1               ;
00CA74  1               ; Input: DriveNumber
00CA74  1               ;
00CA74  1               ; Output: DriveNumber in range 0..N-1
00CA74  1               ;
00CA74  1               SPValidateUnitNumber:
00CA74  1  A4 4D           ldy spSlot
00CA76  1  B9 F8 04        lda DriveNumber,y
00CA79  1  F0 0F           beq badUnit
00CA7B  1  18              clc
00CA7C  1  E9 01           sbc  #1
00CA7E  1  99 F8 04        sta DriveNumber,y
00CA81  1  D9 F8 06        cmp DrvBlkCount2,y
00CA84  1  F0 02           beq unitOK
00CA86  1  B0 02           bcs badUnit
00CA88  1               unitOK:
00CA88  1  18              clc
00CA89  1  60              rts
00CA8A  1               
00CA8A  1               badUnit:
00CA8A  1  A9 11           lda #BAD_UNIT_NUMBER
00CA8C  1  38              sec
00CA8D  1  60              rts
00CA8E  1               
00CA8E  1               ;------------------------------------------------------------------------------
00CA8E  1               ; P8AuxROM - Handle a ProDOS call
00CA8E  1               ;
00CA8E  1               P8AuxROM:
00CA8E  1               
00CA8E  1               ; If the ProDOS unit number doesn't match our slot number, add 2 to
00CA8E  1               ; the drive number.
00CA8E  1               ;
00CA8E  1               ; This actually happens: If we're in slot 5, we get calls for slot 2
00CA8E  1               ; that want to access our 3rd and 4th partitions.
00CA8E  1  8A              txa                          ; A = $n0
00CA8F  1  45 43           eor  pdUnitNumber
00CA91  1  29 70           and  #$70                    ;EOR the slot number
00CA93  1  F0 02           beq  OurSlot
00CA95  1  A9 02           lda  #2                      ;Point to drive 3 or 4
00CA97  1               
00CA97  1               OurSlot:
00CA97  1  24 43           bit  pdUnitNumber
00CA99  1  10 03           bpl  DriveOne
00CA9B  1  18              clc
00CA9C  1  69 01           adc  #1
00CA9E  1               
00CA9E  1               DriveOne:
00CA9E  1  99 F8 04        sta  DriveNumber,y
00CAA1  1  A9 00           lda  #0
00CAA3  1  99 78 07        sta  DrvMiscFlags,y          ;no special flags (such as raw block access)
00CAA6  1               
00CAA6  1  20 C4 CA        jsr  ResetDriveIfFirstTime
00CAA9  1               
00CAA9  1               ; process the command code and jump to appropriate routine.
00CAA9  1               
00CAA9  1               .IF DEBUG
00CAA9  1               ;warning this debug code trashes the Acc register
00CAA9  1                  jsr  DSString
00CAA9  1                  .byte "P8:",0
00CAA9  1               .ENDIF
00CAA9  1               
00CAA9  1  A5 42           lda  pdCommandCode
00CAAB  1  C9 01           cmp  #PRODOS_READ
00CAAD  1  D0 03           bne  chk1
00CAAF  1  4C A8 CB        jmp  ReadBlock
00CAB2  1               
00CAB2  1               chk1:
00CAB2  1  C9 02           cmp  #PRODOS_WRITE
00CAB4  1  D0 03           bne  chk2
00CAB6  1  4C 05 CC        jmp  WriteBlock
00CAB9  1               
00CAB9  1               chk2:
00CAB9  1  C9 00           cmp  #PRODOS_STATUS
00CABB  1  D0 03           bne  chk3
00CABD  1  4C ED CA        jmp  GetStatus
00CAC0  1               
00CAC0  1               chk3:
00CAC0  1               ; An invalid request # has been sent to this driver.
00CAC0  1               ;
00CAC0  1               .IF DEBUG
00CAC0  1                  pha
00CAC0  1                  jsr DSString
00CAC0  1                  .byte "CE",0
00CAC0  1                  pla
00CAC0  1                  jsr  DSByteCRLF
00CAC0  1               .ENDIF
00CAC0  1               
00CAC0  1  A9 27           lda  #PRODOS_IO_ERROR
00CAC2  1  38              sec
00CAC3  1  60              rts                             ;return to caller. Should always be ProDOS
00CAC4  1               
00CAC4  1               ;------------------------------------------------------------------------------
00CAC4  1               ; ResetDriveIfFirstTime - Reset the drive once, the first time the driver
00CAC4  1               ; is called ide_devctrl Bit 2 = Software Reset, Bit 1 = nIEN (enable
00CAC4  1               ; assertion of INTRQ)
00CAC4  1               ;
00CAC4  1               ; Input:
00CAC4  1               ;       X = requested slot number in form $n0 where n = slot 1 to 7
00CAC4  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CAC4  1               ;
00CAC4  1               ; ZeroPage Usage:
00CAC4  1               ;       None
00CAC4  1               ;
00CAC4  1               ; CPU Registers changed:  A, P
00CAC4  1               ;
00CAC4  1               ResetDriveIfFirstTime:
00CAC4  1  B9 78 04        lda  DriveResetDone,Y
00CAC7  1  C9 A5           cmp  #INITDONESIG
00CAC9  1  F0 21           beq  resetOK
00CACB  1               ;
00CACB  1               ; Reset the ATA device
00CACB  1               ;
00CACB  1  A9 00           lda  #0
00CACD  1  9D 80 C0        sta  ATADataHigh,x           ;Clear high byte data latch
00CAD0  1               
00CAD0  1  A9 06           lda  #$06                    ;Reset bit=1, Disable INTRQ=1
00CAD2  1  9D 86 C0        sta  ATADevCtrl,x
00CAD5  1               ;
00CAD5  1               ; Per ATA-6 spec, need to wait 5us minimum. Use a delay of 100us.
00CAD5  1               ; Should cover accelerated Apples up to 20Mhz.
00CAD5  1               ;
00CAD5  1  A9 04           lda  #WAIT_100us
00CAD7  1  20 C5 CC        jsr  Wait
00CADA  1               
00CADA  1  A9 02           lda  #$02                    ;Reset bit=0, Disable INTRQ=1
00CADC  1  9D 86 C0        sta  ATADevCtrl,x
00CADF  1               ;
00CADF  1               ; Per ATA-6 spec, need to wait 2ms minimum. Use a delay of 40ms.
00CADF  1               ; Should cover accelerated Apples up to 20Mhz.
00CADF  1               ;
00CADF  1  A9 7C           lda  #WAIT_40ms
00CAE1  1  20 C5 CC        jsr  Wait
00CAE4  1               ;
00CAE4  1               ; Per ATA-6 spec, wait for busy to clear, by calling IDEWaitReady
00CAE4  1               ;
00CAE4  1  20 95 CC        jsr  IDEWaitReady
00CAE7  1               
00CAE7  1  A9 A5           lda  #INITDONESIG
00CAE9  1  99 78 04        sta  DriveResetDone,Y        ;Set the init done flag so init only happens
00CAEC  1                                               ; once.
00CAEC  1               resetOK:
00CAEC  1  60              rts
00CAED  1               
00CAED  1               ;------------------------------------------------------------------------------
00CAED  1               ; GetStatus - Called by ProDOS and SmartPort to get device status and size
00CAED  1               ;
00CAED  1               ; Input:
00CAED  1               ;       DriveNumber,y (0 to 3)
00CAED  1               ;       X = slot number in form $n0 where n = slot 1 to 7
00CAED  1               ;       Y = $0n (n = slot#) for accessing scratchpad RAM;
00CAED  1               ;
00CAED  1               ; Output:
00CAED  1               ;       A = ProDOS status return code
00CAED  1               ;       X = drive size LSB
00CAED  1               ;       Y = drive size MSB
00CAED  1               ;       Carry flag: 0 = Okay, 1 = Error
00CAED  1               ;       DrvBlkCount0..DrvBlkCount2 = usable blocks on device
00CAED  1               ;
00CAED  1               GetStatus:
00CAED  1               
00CAED  1               .IF DEBUG
00CAED  1               ;warning this debug code trashes the Acc register
00CAED  1                  jsr  DSString
00CAED  1                  .byte " St",0
00CAED  1                  jsr  DisplayParms
00CAED  1               .ENDIF
00CAED  1               
00CAED  1               ;
00CAED  1               ; Determine if a drive/device is present.
00CAED  1               ;
00CAED  1  20 9F CC        jsr  CheckDevice
00CAF0  1  90 0A           bcc  sDriveOK
00CAF2  1               
00CAF2  1  A2 00           ldx  #$00
00CAF4  1  A0 00           ldy  #$00
00CAF6  1  A9 2F           lda  #PRODOS_OFFLINE
00CAF8  1  38              sec
00CAF9  1  4C A7 CB        jmp  sExit
00CAFC  1               
00CAFC  1               ; Device is present
00CAFC  1               sDriveOK:
00CAFC  1  A9 00           lda  #0
00CAFE  1  9D 80 C0        sta  ATADataHigh,x           ;clear high byte transfer latch
00CB01  1               
00CB01  1  20 95 CC        jsr  IDEWaitReady
00CB04  1  A9 EC           lda  #ATAIdentify
00CB06  1  9D 8F C0        sta  ATACommand,x            ;Issue the read command to the drive
00CB09  1  20 95 CC        jsr  IDEWaitReady            ;Wait for BUSY flag to go away
00CB0C  1               
00CB0C  1  BD 8F C0        lda  ATAStatus,x             ;Check for error response
00CB0F  1  29 09           and  #$09
00CB11  1  C9 01           cmp  #$01                     ;if DRQ=0 and ERR=1 an error occured
00CB13  1  D0 0A           bne  sValidATACommand
00CB15  1               
00CB15  1               .IF DEBUG
00CB15  1               ;warning this debug code trashes the Acc register
00CB15  1                  jsr DSString
00CB15  1                  .byte " Idfy Err:",0
00CB15  1                  lda  ATAError,x
00CB15  1                  jsr  DSByteCRLF
00CB15  1               .ENDIF
00CB15  1               
00CB15  1  A2 00           ldx  #0
00CB17  1  A0 00           ldy  #0
00CB19  1  A9 27           lda  #PRODOS_IO_ERROR
00CB1B  1  38              sec
00CB1C  1  4C A7 CB        jmp  sExit                   ; Command Error occured, return error
00CB1F  1               
00CB1F  1               sValidATACommand:
00CB1F  1  98              tya
00CB20  1  48              pha                          ;save Y, it holds the $0n sratchpad RAM offset
00CB21  1  A0 00           ldy  #$00                    ;zero loop counter
00CB23  1               
00CB23  1               sPrefetchloop:
00CB23  1  20 95 CC        jsr  IDEWaitReady            ;See if a word is ready
00CB26  1  B0 07           bcs  sWordRdy
00CB28  1  68              pla
00CB29  1  A8              tay
00CB2A  1  A9 27           lda  #PRODOS_IO_ERROR
00CB2C  1  4C A7 CB        jmp  sExit
00CB2F  1               
00CB2F  1               sWordRdy:
00CB2F  1  BD 88 C0        lda  ATADataLow,x            ;Read words 0 thru 56 but throw them away
00CB32  1  C8              iny
00CB33  1  C0 39           cpy  #57                     ;Number of the last word you want to throw away
00CB35  1  D0 EC           bne  sPrefetchloop
00CB37  1  68              pla
00CB38  1  A8              tay
00CB39  1               
00CB39  1               sPrefetchDone:
00CB39  1  BD 88 C0        lda  ATADataLow,x            ;Read the current capacity in sectors (LBA)
00CB3C  1  38              sec
00CB3D  1  E9 00           sbc  #BLOCKOFFSET
00CB3F  1  99 F8 05        sta  DrvBlkCount0,y
00CB42  1  BD 80 C0        lda  ATADataHigh,x
00CB45  1  E9 00           sbc  #0
00CB47  1  99 78 06        sta  DrvBlkCount1,y
00CB4A  1  BD 88 C0        lda  ATADataLow,x
00CB4D  1  E9 00           sbc  #0
00CB4F  1  99 F8 06        sta  DrvBlkCount2,y
00CB52  1               
00CB52  1               
00CB52  1               .IF DEBUG
00CB52  1                  jsr  DSString
00CB52  1                  .byte "Size:",0
00CB52  1               
00CB52  1                  lda  ATADataHigh,x           ;get the high byte of high word just for display
00CB52  1                  jsr  DSByte
00CB52  1                  lda  DrvBlkCount2,y
00CB52  1                  jsr  DSByte
00CB52  1                  lda  DrvBlkCount1,y
00CB52  1                  jsr  DSByte
00CB52  1                  lda  DrvBlkCount0,y
00CB52  1                  jsr  DSByte
00CB52  1                  jsr  DSBlank
00CB52  1               .ENDIF
00CB52  1               
00CB52  1  B9 F8 06        lda  DrvBlkCount2,y
00CB55  1  C9 04           cmp  #PARTITIONS32MB         ;max out at (#PARTITIONS32MB * $10000 + 00FFFF)
00CB57  1                                               ; blocks
00CB57  1  B0 05           bcs  maxOutAtN
00CB59  1               
00CB59  1  BD 80 C0        lda  ATADataHigh,x
00CB5C  1  F0 0D           beq  lessThan8GB
