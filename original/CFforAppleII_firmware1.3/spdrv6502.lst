00CB60  1                                               ; block count to $03FFFF
00CB60  1  99 F8 05        sta  DrvBlkCount0,y
00CB63  1  99 78 06        sta  DrvBlkCount1,y
00CB66  1  A9 03           lda  #PARTITIONS32MB-1       ;Number of 32MB devices, set by the equate:
00CB68  1                                               ; #PARTITIONS32MB
00CB68  1  99 F8 06        sta  DrvBlkCount2,y
00CB6B  1               lessThan8GB:
00CB6B  1               
00CB6B  1               
00CB6B  1               PostFetch:
00CB6B  1  20 95 CC        jsr IDEWaitReady             ;read the rest of the words, until command ends
00CB6E  1  90 06           bcc sReadComplete
00CB70  1  BD 88 C0        lda ATADataLow,x
00CB73  1  4C 6B CB        jmp PostFetch
00CB76  1               sReadComplete:
00CB76  1               
00CB76  1               ; DrvBlkCount2 is the number of 32 MB partitions availiable - 1,
00CB76  1               ; or the highest drive # supported (zero based).
00CB76  1               ;
00CB76  1               ; If DrvBlkCount2 > drive # then StatusSize = $FFFF
00CB76  1               ; If DrvBlkCount2 = drive # then StatusSize = DrvBlkCount1,DrvBlkCount0
00CB76  1               ; If DrvBlkCount2 < drive # then StatusSize = 0
00CB76  1               ;
00CB76  1               ; This scheme has a special case which must be handled because ProDOS
00CB76  1               ;   partitions are not quite 32 meg in size but are only FFFF blocks in size.
00CB76  1               ;   If a device is exactly: 32meg or 10000h blocks in size, it would appear
00CB76  1               ;   as one drive of size FFFF and another drive of size 0000. To handle this
00CB76  1               ;   case, we check for an exact size of 0000 and fall into the NoDrive code.
00CB76  1               ;
00CB76  1  B9 F8 04        lda DriveNumber,y
00CB79  1  D9 F8 06        cmp DrvBlkCount2,y
00CB7C  1  F0 0C           beq ExactSize
00CB7E  1  90 20           bcc FullSize
00CB80  1               
00CB80  1               NoDrive:
00CB80  1  A2 00           ldx  #0
00CB82  1  A0 00           ldy  #0
00CB84  1  A9 2F           lda  #PRODOS_OFFLINE
00CB86  1  38              sec
00CB87  1  4C A7 CB        jmp  sExit
00CB8A  1               
00CB8A  1               ExactSize:                    ;If equal, the DrvBlkCount1,DrvBlkCount0 is the
00CB8A  1                                             ; drive's exact size
00CB8A  1  B9 F8 05        lda  DrvBlkCount0,y
00CB8D  1  19 78 06        ora  DrvBlkCount1,y
00CB90  1  F0 EE           beq  NoDrive               ;can't have a 0-block device
00CB92  1               
00CB92  1  B9 F8 05        lda  DrvBlkCount0,y
00CB95  1  AA              tax
00CB96  1  B9 78 06        lda  DrvBlkCount1,y
00CB99  1  A8              tay
00CB9A  1  A9 00           lda  #0
00CB9C  1  18              clc                          ;no errors
00CB9D  1  4C A7 CB        jmp  sExit
00CBA0  1               
00CBA0  1               FullSize:
00CBA0  1  A2 FF           ldx  #$FF                    ;X gets low byte of size
00CBA2  1  A0 FF           ldy  #$FF                    ;Y gets high byte of size
00CBA4  1  A9 00           lda  #0
00CBA6  1  18              clc                          ;no errors
